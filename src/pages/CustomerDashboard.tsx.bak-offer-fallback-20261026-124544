function FileUploadBox({
  title,
  description,
  files,
  uploading,
  feedback,
  deletingFileId,
  canDelete = true,
  onFiles,
  onDelete,
  icon,
}: {
  title: string;
  description: string;
  category: string;
  files: PreinspectionFile[];
  uploading: boolean;
  feedback?: { type: "success" | "error"; message: string };
  deletingFileId?: number | null;
  canDelete?: boolean;
  onFiles: (files: FileList | File[] | null) => void;
  onDelete: (file: PreinspectionFile) => void;
  icon: React.ReactNode;
}) {
  const [dragActive, setDragActive] = useState(false);

  const handleDrop = (event: React.DragEvent<HTMLLabelElement>) => {
    event.preventDefault();
    event.stopPropagation();
    setDragActive(false);

    if (uploading) return;

    const droppedFiles = Array.from(event.dataTransfer.files || []);
    if (droppedFiles.length > 0) {
      onFiles(droppedFiles);
    }
  };

  const fileExtension = (file: PreinspectionFile) => {
    const source = String(file.original_name || file.file_url || "");
    const match = source.toLowerCase().match(/\.([a-z0-9]+)(?:$|\?)/);
    return match?.[1] || "";
  };

  const isPreviewableImage = (file: PreinspectionFile) =>
    ["jpg", "jpeg", "png", "webp"].includes(fileExtension(file));

  const formatFileSize = (bytes?: number | null) => {
    const value = Number(bytes || 0);
    if (!value) return "";

    if (value < 1024) return `${value} B`;
    if (value < 1024 * 1024) return `${Math.round(value / 1024)} KB`;

    return `${(value / 1024 / 1024).toFixed(value >= 10 * 1024 * 1024 ? 0 : 1)} MB`;
  };

  return (
    <div className="space-y-3">
      <label
        onDragEnter={(event) => {
          event.preventDefault();
          if (!uploading) setDragActive(true);
        }}
        onDragOver={(event) => {
          event.preventDefault();
          if (!uploading) setDragActive(true);
        }}
        onDragLeave={(event) => {
          event.preventDefault();
          if (
            event.currentTarget === event.target ||
            !event.currentTarget.contains(event.relatedTarget as Node | null)
          ) {
            setDragActive(false);
          }
        }}
        onDrop={handleDrop}
        className={`block cursor-pointer rounded-2xl border-2 border-dashed p-5 transition-all ${
          dragActive
            ? "border-amber-400 bg-amber-500/[0.08] shadow-[0_0_24px_rgba(245,184,0,0.12)]"
            : "border-slate-700 bg-slate-950/35 hover:border-slate-600 hover:bg-slate-950/55"
        } ${uploading ? "cursor-wait opacity-75" : ""}`}
      >
        <div className="flex flex-col items-center justify-center gap-3 text-center sm:flex-row sm:justify-between sm:text-left">
          <div className="flex items-start gap-3">
            <div
              className={`grid h-10 w-10 shrink-0 place-items-center rounded-xl border ${
                dragActive
                  ? "border-amber-400/40 bg-amber-500/10 text-amber-300"
                  : "border-slate-700 bg-slate-900 text-slate-300"
              }`}
            >
              {uploading ? (
                <Loader2 className="h-5 w-5 animate-spin" />
              ) : (
                icon
              )}
            </div>

            <div>
              <p className="text-xs font-extrabold text-slate-100">
                {title}
              </p>
              <p className="mt-1 text-[11px] leading-5 text-slate-500">
                {description}
              </p>
              <p className="mt-1 text-[10px] text-slate-600">
                Dra og slipp filer her, eller klikk for å velge. Maks 20 MB per fil.
              </p>
              <p className="mt-1 text-[10px] text-slate-600">
                PDF, Word, Excel, JPG, PNG, WEBP, HEIC/HEIF og TXT.
              </p>
            </div>
          </div>

          <span
            className={`inline-flex min-w-[118px] items-center justify-center gap-2 rounded-xl border px-4 py-2.5 text-xs font-extrabold ${
              dragActive
                ? "border-amber-400/50 bg-amber-500/10 text-amber-300"
                : "border-slate-700 bg-slate-900 text-slate-200"
            }`}
          >
            {uploading ? (
              <>
                <Loader2 className="h-4 w-4 animate-spin" />
                Laster opp...
              </>
            ) : (
              <>
                <Upload className="h-4 w-4" />
                Velg filer
              </>
            )}
          </span>
        </div>

        <input
          type="file"
          multiple
          accept=".pdf,.jpg,.jpeg,.png,.webp,.heic,.heif,.doc,.docx,.xls,.xlsx,.txt,image/*"
          className="hidden"
          disabled={uploading}
          onChange={(event) => {
            onFiles(event.target.files);
            event.currentTarget.value = "";
          }}
        />
      </label>

      {feedback && (
        <div
          className={`rounded-xl border px-3 py-2 text-[11px] ${
            feedback.type === "success"
              ? "border-emerald-500/25 bg-emerald-500/[0.06] text-emerald-300"
              : "border-red-500/25 bg-red-500/[0.06] text-red-300"
          }`}
        >
          {feedback.message}
        </div>
      )}

      {files.length > 0 && (
        <div className="rounded-2xl border border-slate-800 bg-slate-950/45 p-3.5">
          <div className="mb-3 flex items-center justify-between gap-3">
            <p className="text-[10px] font-black uppercase tracking-wider text-slate-500">
              Lastet opp ({files.length})
            </p>
            {!canDelete && (
              <span className="text-[9px] font-bold text-slate-600">
                Innsendte filer er låst
              </span>
            )}
          </div>

          <div className="grid grid-cols-2 gap-2.5 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
            {files.map((file) => {
              const previewable = isPreviewableImage(file);
              const extension = fileExtension(file).toUpperCase() || "FIL";
              const fileUrl = apiAssetUrl(file.file_url);
              const deleting = deletingFileId === file.id;

              return (
                <div
                  key={file.id}
                  className="group relative overflow-hidden rounded-xl border border-slate-800 bg-[#0b0f17] transition hover:border-slate-700"
                >
                  <a
                    href={fileUrl}
                    target="_blank"
                    rel="noreferrer"
                    className="block"
                    title={file.original_name || "Åpne fil"}
                  >
                    <div className="relative aspect-[4/3] overflow-hidden bg-slate-950">
                      {previewable ? (
                        <img
                          src={fileUrl}
                          alt={file.original_name || "Opplastet bilde"}
                          className="h-full w-full object-cover transition duration-200 group-hover:scale-[1.03]"
                          loading="lazy"
                        />
                      ) : (
                        <div className="flex h-full flex-col items-center justify-center gap-2 text-slate-500">
                          {extension === "PDF" ? (
                            <>
                              <div className="grid h-12 w-12 place-items-center rounded-xl border border-red-500/30 bg-red-500/10 text-red-300">
                                <FileText className="h-6 w-6" />
                              </div>
                              <span className="rounded-md border border-red-500/25 bg-red-500/[0.08] px-2 py-1 text-[9px] font-black text-red-300">
                                PDF
                              </span>
                            </>
                          ) : (
                            <>
                              <Paperclip className="h-6 w-6" />
                              <span className="rounded-md border border-slate-700 bg-slate-900 px-2 py-1 text-[9px] font-black text-slate-300">
                                {extension}
                              </span>
                            </>
                          )}
                        </div>
                      )}

                      <div className="pointer-events-none absolute inset-x-0 bottom-0 h-10 bg-gradient-to-t from-black/75 to-transparent" />
                    </div>

                    <div className="px-2.5 py-2">
                      <p className="truncate text-[10px] font-bold text-slate-300">
                        {file.original_name || file.file_url}
                      </p>
                      <div className="mt-1 flex items-center justify-between gap-2 text-[9px] text-slate-600">
                        <span>{extension || "FIL"}</span>
                        {formatFileSize(file.file_size_bytes) && (
                          <span>{formatFileSize(file.file_size_bytes)}</span>
                        )}
                      </div>
                    </div>
                  </a>

                  {canDelete && (
                    <button
                      type="button"
                      disabled={deleting}
                      onClick={(event) => {
                        event.preventDefault();
                        event.stopPropagation();
                        onDelete(file);
                      }}
                      className="absolute right-1.5 top-1.5 grid h-7 w-7 place-items-center rounded-lg border border-red-500/30 bg-slate-950/90 text-red-300 shadow-lg transition hover:border-red-400/60 hover:bg-red-500/15 disabled:cursor-wait disabled:opacity-60"
                      title="Slett fil"
                      aria-label={`Slett ${file.original_name || "fil"}`}
                    >
                      {deleting ? (
                        <Loader2 className="h-3.5 w-3.5 animate-spin" />
                      ) : (
                        <Trash2 className="h-3.5 w-3.5" />
                      )}
                    </button>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}


type DigitalReportSection = {
  number: string;
  title: string;
  body: string;
};

function parseDigitalReport(text?: string | null): DigitalReportSection[] {
  const source = String(text || "").replace(/\r\n/g, "\n").trim();
  if (!source) return [];

  const headingRegex = /(?:^|\n)\s*(\d+)\.\s+([^\n]+)\n?/g;
  const matches = [...source.matchAll(headingRegex)];

  if (matches.length === 0) {
    return [
      {
        number: "1",
        title: "Rapport",
        body: source,
      },
    ];
  }

  return matches.map((match, index) => {
    const start = (match.index || 0) + match[0].length;
    const end =
      index + 1 < matches.length
        ? matches[index + 1].index || source.length
        : source.length;

    return {
      number: match[1],
      title: match[2].trim(),
      body: source.slice(start, end).trim(),
    };
  });
}

function DigitalReportBody({ body }: { body: string }) {
  const lines = body.split("\n");

  return (
    <div className="space-y-2.5">
      {lines.map((line, index) => {
        const value = line.trim();

        if (!value) {
          return <div key={`space-${index}`} className="h-1" />;
        }

        if (value.startsWith("- ")) {
          return (
            <div
              key={`bullet-${index}`}
              className="flex items-start gap-2.5 text-xs md:text-[13px] leading-6 text-slate-300"
            >
              <span className="mt-[9px] h-1.5 w-1.5 rounded-full bg-amber-400 shrink-0" />
              <span>{value.slice(2)}</span>
            </div>
          );
        }

        return (
          <p
            key={`text-${index}`}
            className="text-xs md:text-[13px] leading-6 text-slate-300"
          >
            {value}
          </p>
        );
      })}
    </div>
  );
}

/** Read-only formatting of the exact stored offer text; no clauses are rewritten. */
function OfferDescriptionDocument({ value }: { value?: string | null }) {
  const raw = String(value || "").replace(/\r\n?/g, "\n").trim();
  if (!raw) return <p className="text-sm text-slate-400">Se tilbudsdokumentet for arbeidsomfang.</p>;
  const lines = raw.split("\n").map((line) => line.trim());
  const section = /^\d+[.)]\s+\S/;
  const subheadings = /^(?:Følgende arbeider inngår:?|Forberedelse og rengjøring|Reparasjon av murverk|Reparasjon av murpuss og overflatebehandling|Utbedring av rotbeslag og tetting mot taktekking|Montering av pipehetter|Kvalitet og gjennomføring|Forutsetninger og avgrensninger)$/i;
  return (
    <div className="space-y-0 text-[13px] leading-7 text-slate-200 md:text-sm">
      {lines.map((line, index) => {
        if (!line) return <div key={index} className="h-3" aria-hidden="true" />;
        if (section.test(line)) return (
          <h4 key={index} className="mb-3 mt-7 border-l-[3px] border-amber-400 bg-slate-800/45 px-4 py-3 text-base font-extrabold leading-snug text-white first:mt-1">
            {line}
          </h4>
        );
        if (subheadings.test(line)) return (
          <h5 key={index} className="mb-2 mt-5 text-sm font-bold text-amber-200">{line}</h5>
        );
        if (/^(?:TILBUD\s*[–-]|TILBYDER:|PROSJEKT:)/i.test(line)) return (
          <p key={index} className="mb-2 text-xs font-semibold tracking-wide text-slate-300">{line}</p>
        );
        if (/^[•▪‣*-]\s+/.test(line)) return (
          <div key={index} className="flex gap-3 pl-2"><span className="mt-3 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-400" /><p className="min-w-0 flex-1">{line.replace(/^[•▪‣*-]\s+/, "")}</p></div>
        );
        return <p key={index} className="break-words leading-7 text-slate-300">{line}</p>;
      })}
    </div>
  );
}

