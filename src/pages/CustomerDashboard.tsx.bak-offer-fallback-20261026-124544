  const fetchOffer = async (inquiryId: number) => {
    setLoadingOffer(true);
    setOfferError("");

    try {
      /*
       * customer_portal.php er hovedkilden for kundesynlige tilbud.
       * Den returnerer hele historikken for saken i offers[].
       * offers.php beholdes som fallback fordi eldre backend-versjoner
       * bare returnerer ett enkelt offer-objekt.
       */
      let rawOffers: CustomerOffer[] = [];

      try {
        const portalRes = await fetch(
          apiUrl(`/customer_portal.php?inquiry_id=${inquiryId}`)
        );
        const portalData = await portalRes.json();

        if (portalRes.ok && portalData.success) {
          rawOffers = Array.isArray(portalData.offers)
            ? portalData.offers
            : portalData.offer
            ? [portalData.offer]
            : [];
        }
      } catch {
        rawOffers = [];
      }

      if (rawOffers.length === 0) {
        const res = await fetch(apiUrl(`/offers.php?inquiry_id=${inquiryId}`));
        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(data.message || "Kunne ikke hente tilbud.");
        }

        rawOffers = Array.isArray(data.offers)
          ? data.offers
          : data.offer
          ? [data.offer]
          : [];
      }

      // Interne utkast skal aldri vises i kundeportalen.
      const customerOffers = rawOffers
        .filter((item) => item && item.status !== "utkast")
        .sort((a, b) => Number(b.id || 0) - Number(a.id || 0));

      setOffers(customerOffers);

      // Nyeste tilbud er gjeldende. Eldre publiserte tilbud må ikke
      // overstyre en nyere utløpt/akseptert versjon.
      const primaryOffer = customerOffers[0] || null;

      setOffer(primaryOffer);

      const openOffer = customerOffers.find(
        (item) => item.status === "publisert"
      );

      setExpandedOfferId((current) => {
        if (
          current &&
          customerOffers.some(
            (item) => item.id === current && item.status === "publisert"
          )
        ) {
          return current;
        }
        return openOffer?.id || null;
      });

      if (openOffer) {
        setOfferTermsConfirmed(false);
      }
    } catch (err) {
      setOffer(null);
      setOffers([]);
      setExpandedOfferId(null);
      setOfferError(
        err instanceof Error ? err.message : "Kunne ikke hente tilbud."
      );
    } finally {
      setLoadingOffer(false);
    }
  };

  const respondToOffer = async (
    offerId: number,
    action: "accept" | "reject"
  ) => {
    const targetOffer = offers.find((item) => item.id === offerId) || offer;

    if (!targetOffer?.id || !inquiryData?.inquiry?.id) return;
    if (offerExpired(targetOffer)) {
      setOfferError("Tilbudet er utløpt. Be om ny tid i kundeportalen.");
      return;
    }

    if (action === "accept" && offers.some((other) =>
      other.id !== targetOffer.id && other.status === "publisert" &&
      ((targetOffer.revision_parent_offer_id || targetOffer.id) ===
        (other.revision_parent_offer_id || other.id))
    ) && !window.confirm(`Akseptere ${targetOffer.offer_number || "det valgte tilbudet"}? Andre publiserte revisjoner av samme tilbud blir automatisk avvist.`)) return;

    if (action === "accept" && !offerTermsConfirmed) {
      setOfferError(
        "Bekreft oppgitte satser og betingelser før du aksepterer tilbudet."
      );
      return;
    }

    setUpdatingOffer(true);
    setOfferError("");
    setOfferMessage("");

    try {
