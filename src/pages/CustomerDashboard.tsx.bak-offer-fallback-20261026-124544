                                <span className="truncate text-sm text-slate-300">
                                  {item.title || getServiceLabel(item.service)}
                                </span>
                              </div>

                              <div className="text-left sm:text-right">
                                <p className="text-[9px] uppercase font-black text-slate-600">
                                  {isAccepted ? "Akseptert" : item.revision_resolution === "other_revision_accepted" ? "Annen revisjon akseptert" : "Avvist"}
                                </p>
                                <p className="text-[10px] font-bold text-slate-400">
                                  {(() => {
                                    const date =
                                      item.accepted_at ||
                                      item.rejected_at ||
                                      item.published_at;
                                    return date
                                      ? new Date(
                                          String(date).replace(" ", "T")
                                        ).toLocaleDateString("nb-NO")
                                      : "";
                                  })()}
                                </p>
                              </div>
                            </div>
                          </div>
                        );
                      })}

                    <div className="rounded-2xl border border-slate-800 bg-slate-950/55 p-4 md:p-5">
                      <div className="flex items-start gap-3">
                        <div className="w-9 h-9 rounded-xl border border-amber-500/20 bg-amber-500/[0.07] flex items-center justify-center shrink-0">
