        body: JSON.stringify({
          id: targetOffer.id,
          action,
          session_token: window.localStorage.getItem(CUSTOMER_PORTAL_SESSION_STORAGE_KEY),
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message ||
            (action === "accept"
              ? "Kunne ikke akseptere tilbudet."
              : "Kunne ikke avvise tilbudet.")
        );
      }

      const hasProposedTime =
        followupSchedule &&
        ["foreslatt", "foreslatt_av_prosjektleder"].includes(
          String(followupSchedule.status || "").toLowerCase()
        );

      setOfferMessage(
        action === "accept"
          ? hasProposedTime
