        setOfferMessage(
          "Tilbudet er publisert til kundeportalen, men én eller flere varslinger feilet. Kontroller kommunikasjonsloggen."
        );
      }
    } catch (err) {
      setOfferError(
        err instanceof Error ? err.message : "Kunne ikke publisere tilbudet."
      );
    } finally {
      setSavingOffer(false);
    }
  };

