function DetailBlock({
  title,
  icon,
  yesNo,
  details,
  extra = [],
  files = [],
}: {
  title: string;
  icon: React.ReactNode;
  yesNo?: string;
  details?: string | null;
  extra?: string[];
  files?: PreinspectionFile[];
}) {
  return (
    <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 space-y-3">
      <div className="flex items-center justify-between gap-3">
        <h4 className="text-xs font-extrabold text-white flex items-center gap-2">
          {icon}
          {title}
        </h4>
        {yesNo && (
          <span className="text-[10px] font-extrabold px-2 py-1 rounded-lg bg-slate-900 border border-slate-800 text-slate-300">
            {yesNo}
          </span>
        )}
      </div>

      {details && (
        <p className="text-[11px] text-slate-300 whitespace-pre-wrap leading-5">
          {details}
        </p>
      )}

      {extra.length > 0 && (
        <div className="space-y-1">
          {extra.map((item) => (
            <p key={item} className="text-[11px] text-slate-500">
              {item}
            </p>
          ))}
        </div>
      )}

      {files.length > 0 && (
        <div className="grid gap-3 border-t border-slate-800 pt-3 sm:grid-cols-2">
          {files.map((file) => <CustomerAttachment key={file.id} file={file} />)}
        </div>
      )}
    </div>
  );
}

