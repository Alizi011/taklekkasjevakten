import { useState } from "react";
import { CheckCircle2, FileText, PenLine, RotateCcw } from "lucide-react";

type Stage = "customer" | "marina" | "complete";

export default function AgreementSigningDemo() {
  const [stage, setStage] = useState<Stage>("customer");
  const [accepted, setAccepted] = useState(false);
  const [customerSignedAt, setCustomerSignedAt] = useState("");
  const [marinaSignedAt, setMarinaSignedAt] = useState("");

  function signCustomer() {
    if (!accepted) return;
    setCustomerSignedAt(new Date().toLocaleString("nb-NO"));
    setAccepted(false);
    setStage("marina");
  }

  function signMarina() {
    if (!accepted) return;
    setMarinaSignedAt(new Date().toLocaleString("nb-NO"));
    setAccepted(false);
    setStage("complete");
  }

  function reset() {
    setStage("customer");
    setAccepted(false);
    setCustomerSignedAt("");
    setMarinaSignedAt("");
  }

  const isCustomer = stage === "customer";

  return (
    <main className="min-h-screen bg-[#071321] px-4 py-8 text-white">
      <div className="mx-auto max-w-5xl space-y-6">
        <div className="rounded-2xl border border-amber-500/30 bg-amber-500/10 p-4">
          <p className="font-black text-amber-300">DEMO – KUN DEV</p>
          <p className="mt-1 text-xs text-slate-300">
            Eksempeldata. Ingen SMS, databaseendringer eller juridisk signering.
          </p>
        </div>

        <div className="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h1 className="text-2xl font-black">
              Elektronisk signering av arbeidsavtale
            </h1>
            <p className="mt-2 text-sm text-slate-400">
              Demonstrasjon av kundens og leverandørens signering.
            </p>
          </div>
          <button
            type="button"
            onClick={reset}
            className="flex items-center gap-2 rounded-xl border border-slate-700 px-4 py-2 text-sm"
          >
            <RotateCcw className="h-4 w-4" />
            Start demo på nytt
          </button>
        </div>

        <div className="grid grid-cols-1 gap-4 md:grid-cols-3">
          {[
            ["1", "Kunden signerer", !!customerSignedAt],
            ["2", "Marina signerer", !!marinaSignedAt],
            ["3", "Avtalen ferdig", stage === "complete"],
          ].map(([number, label, done]) => (
            <div
              key={String(number)}
              className="rounded-2xl border border-slate-800 bg-slate-950 p-4"
            >
              <div className="flex items-center justify-between">
                <span className="text-sm font-bold">{label}</span>
                {done ? (
                  <CheckCircle2 className="h-5 w-5 text-green-400" />
                ) : (
                  <span className="text-slate-500">{number}</span>
                )}
              </div>
            </div>
          ))}
        </div>

        <section className="overflow-hidden rounded-2xl border border-slate-800 bg-slate-950">
          <div className="flex items-center gap-2 border-b border-slate-800 p-5">
            <FileText className="h-5 w-5 text-amber-400" />
            <h2 className="font-bold">Arbeidsavtale – demonstrasjon</h2>
          </div>

          <div className="space-y-6 bg-white p-6 text-slate-900 md:p-10">
            <div className="border-b pb-5">
              <p className="text-xs font-bold uppercase tracking-widest text-slate-500">
                Taklekkasjevakten / Perun AS
              </p>
              <h2 className="mt-2 text-2xl font-black">Arbeidsavtale</h2>
              <p className="mt-1 text-sm text-slate-500">
                DEMO-2026-0001 – ikke et ekte avtalenummer
              </p>
            </div>

            <div className="grid gap-6 sm:grid-cols-2">
              <div>
                <h3 className="mb-2 font-bold">Oppdragsgiver</h3>
                <p>Eksempel Sameie</p>
                <p className="text-sm text-slate-500">Eksempelveien 1, Oslo</p>
              </div>
              <div>
                <h3 className="mb-2 font-bold">Leverandør</h3>
                <p>Perun AS / Taklekkasjevakten</p>
              </div>
            </div>

            <div>
              <h3 className="mb-2 font-bold">1. Arbeidets omfang</h3>
              <p className="text-sm leading-7">
                Eksempel på utbedring av lekkasje og tilhørende
                takarbeider. Den faktiske avtalen vil inneholde
                godkjent arbeidsbeskrivelse og originalt pristilbud.
              </p>
            </div>

            <div>
              <h3 className="mb-2 font-bold">2. Avtalt pris</h3>
              <p className="text-xl font-black">kr 50 000 inkl. mva.</p>
              <p className="mt-1 text-xs text-slate-500">
                Kun eksempelpris.
              </p>
            </div>

            <div>
              <h3 className="mb-2 font-bold">3. Betalingsplan</h3>
              <p className="text-sm leading-7">
                Betaling skjer etter avtalte milepæler og dokumentert
                fremdrift i arbeidet.
              </p>
              <div className="mt-3 overflow-hidden rounded-lg border text-sm">
                <div className="flex justify-between border-b p-3">
                  <span>Oppstart av arbeidet – 30 %</span>
                  <strong>kr 15 000</strong>
                </div>
                <div className="flex justify-between border-b p-3">
                  <span>Utført arbeid – 30 %</span>
                  <strong>kr 15 000</strong>
                </div>
                <div className="flex justify-between border-b p-3">
                  <span>Videre fremdrift – 30 %</span>
                  <strong>kr 15 000</strong>
                </div>
                <div className="flex justify-between p-3">
                  <span>Ferdigstillelse – 10 %</span>
                  <strong>kr 5 000</strong>
                </div>
              </div>
              <p className="mt-2 text-xs text-slate-500">
                Eksempel på betalingsfordeling. Faktiske milepæler hentes fra arbeidsavtalen.
              </p>
            </div>

            <div>
              <h3 className="mb-2 font-bold">4. Utførelse</h3>
              <p className="text-sm leading-7">
                Arbeidet utføres i henhold til avtalt arbeidsbeskrivelse
                og akseptert pristilbud. Eventuelle endringer i arbeidets
                omfang skal avklares mellom partene før utførelse.
                Arbeidet dokumenteres ved ferdigstillelse.
              </p>
            </div>

            <div>
              <h3 className="mb-2 font-bold">5. Tvister</h3>
              <p className="text-sm leading-7">
                Perun AS er opptatt av fornøyde kunder og av å ivareta
                og imøtekomme kundens ønsker. Tvister skal løses i
                minnelighet. Oppnås ikke enighet, bringes tvisten inn
                for ordinære domstoler.
              </p>
            </div>

            <div>
              <h3 className="mb-2 font-bold">6. Signering</h3>
              <p className="text-sm leading-7">
                Avtalen signeres elektronisk av begge parter.
                Etter signering mottar partene den elektronisk
                signerte avtalen.
              </p>
            </div>

            <div>
              <h3 className="mb-2 font-bold">7. Elektroniske signaturer</h3>
              <div className="grid gap-4 sm:grid-cols-2">
                <div className="rounded-xl border p-4">
                  <p className="text-sm font-bold">Kundens representant</p>
                  <p className="mt-2 text-sm">
                    {customerSignedAt
                      ? `Demonstrert signert ${customerSignedAt}`
                      : "Venter på signering"}
                  </p>
                </div>
                <div className="rounded-xl border p-4">
                  <p className="text-sm font-bold">Marina Alizi</p>
                  <p className="text-xs text-slate-500">
                    Leverandørens representant
                  </p>
                  <p className="mt-2 text-sm">
                    {marinaSignedAt
                      ? `Demonstrert signert ${marinaSignedAt}`
                      : "Venter på signering"}
                  </p>
                </div>
              </div>
            </div>
          </div>
        </section>

        {stage !== "complete" ? (
          <section className="rounded-2xl border border-slate-800 bg-slate-950 p-6">
            <h2 className="flex items-center gap-2 text-lg font-bold">
              <PenLine className="h-5 w-5 text-amber-400" />
              {isCustomer
                ? "Signering – kundens representant"
                : "Signering – Marina Alizi"}
            </h2>

            <p className="mt-3 text-sm text-slate-400">
              {isCustomer
                ? "Kunden gjennomgår og godkjenner arbeidsavtalen først."
                : "Kundens signatur er nå registrert i demoen. Leverandøren signerer som siste part."}
            </p>

            <label className="mt-5 flex items-start gap-3 text-sm">
              <input
                type="checkbox"
                checked={accepted}
                onChange={(e) => setAccepted(e.target.checked)}
                className="mt-1"
              />
              <span>
                Jeg har gjennomgått arbeidsavtalen og ønsker å
                demonstrere elektronisk signering.
              </span>
            </label>

            <button
              type="button"
              disabled={!accepted}
              onClick={isCustomer ? signCustomer : signMarina}
              className="mt-5 rounded-xl bg-amber-500 px-6 py-3 font-bold text-slate-950 disabled:opacity-40"
            >
              {isCustomer
                ? "Demonstrer kundens signatur"
                : "Demonstrer Marinas signatur"}
            </button>
          </section>
        ) : (
          <section className="rounded-2xl border border-green-800/40 bg-slate-950 p-6">
            <CheckCircle2 className="mb-3 h-8 w-8 text-green-400" />
            <h2 className="text-xl font-bold">
              Demoforløpet er fullført
            </h2>
            <p className="mt-2 text-sm text-slate-300">
              Begge signaturene er demonstrert. I den ekte løsningen
              arkiveres avtalen og signeringsbeviset på prosjektet.
            </p>
            <p className="mt-3 text-xs text-slate-500">
              Ingen virkelig signatur eller dokumentarkivering er utført.
            </p>
          </section>
        )}
      </div>
    </main>
  );
}

