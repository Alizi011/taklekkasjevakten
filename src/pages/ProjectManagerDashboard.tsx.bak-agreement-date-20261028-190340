      return [
        `#${inquiry.id}`,
        customerName(inquiry),
        fullAddress(inquiry),
        serviceLabel(inquiry.recommended_service),
        stageLabel(inquiry.stage),
      ]
        .join(" ")
        .toLowerCase()
        .includes(q);
    });
  }, [inquiries, searchQuery]);

  const fieldInquiries = useMemo(
    () =>
      filteredInquiries.filter((inquiry) => {
        const status = (inquiry.status || "").toLowerCase();
        const stage = inquiry.stage || "";

        if (status === "avsluttet") {
          return false;
        }

        return (
          FIELD_STAGES.has(stage) ||
          stage === "digital_befaring" ||
          status === "tildelt_prosjektansvarlig" ||
          [
            "kundeopplysninger_mottatt",
            "digital_befaring_tid_forslag",
            "digital_befaring_bekreftet",
            "pagaende",
            "planlagt",
            "venter_pa_tilbud",
            "tilbud_sendt",
            "tilbud_akseptert",
          ].includes(status)
        );
      }),
    [filteredInquiries]
  );


  const scheduledInquiries = useMemo(
    () =>
      inquiries
        .filter(
          (inquiry) =>
            String(inquiry.status || "").toLowerCase() !== "avsluttet"
        )
        .map((inquiry) => ({
          inquiry,
          booking: parseInquiryBooking(inquiry),
        }))
        .filter(
          (item): item is { inquiry: Inquiry; booking: Date } =>
            item.booking !== null
        )
        .sort((a, b) => a.booking.getTime() - b.booking.getTime()),
    [inquiries]
  );


  const formatFieldScheduleDateTime = (
    schedule?: FieldSchedule | null
  ): string => {
    if (!schedule?.schedule_date) return "Tidspunkt ikke satt";

    const date = new Date(`${schedule.schedule_date}T12:00:00`);
    const dateLabel = Number.isNaN(date.getTime())
      ? schedule.schedule_date
      : date.toLocaleDateString("nb-NO", {
          day: "2-digit",
          month: "2-digit",
          year: "numeric",
        });

    const time = schedule.start_time
      ? String(schedule.start_time).substring(0, 5)
      : "";

    return time ? `${dateLabel} kl. ${time}` : dateLabel;
  };

  const followupProgress = (inquiry: Inquiry) => {
    const inquiryId = normalizeInquiryId(inquiry.id);
    const schedule =
      fieldScheduleOverview[inquiryId.toString()] || null;

    if (!schedule) return null;

    const scheduleStatus = String(schedule.status || "").toLowerCase();
    const service =
      schedule.service === "takkontroll"
        ? "Vedlikehold"
        : serviceLabel(schedule.service);

    if (
      scheduleStatus === "foreslatt" ||
      scheduleStatus === "foreslatt_av_prosjektleder"
    ) {
      return {
        key: "followup_waiting",
        label: "Venter på kundesvar",
        subtitle: `${service} foreslått`,
        accent: "amber",
      };
    }

    if (scheduleStatus === "foreslatt_av_kunde") {
      return {
        key: "followup_customer",
        label: "Svar fra kunde",
        subtitle: "Nytt tidspunkt foreslått",
        accent: "purple",
      };
    }

    if (scheduleStatus === "bekreftet") {
      return {
        key: "followup_confirmed",
        label:
          schedule.service === "takkontroll"
            ? "Vedlikehold bekreftet"
            : "Tidspunkt bekreftet",
        subtitle: formatFieldScheduleDateTime(schedule),
        accent: "emerald",
      };
    }

    if (scheduleStatus === "avvist" || scheduleStatus === "avlyst") {
      return {
        key: "followup_declined",
        label: "Kunden har takket nei",
        subtitle: "Videre oppfølging må avklares",
        accent: "red",
      };
    }

    if (scheduleStatus === "utsatt") {
      return {
        key: "followup_waiting",
        label: "Avtales senere",
        subtitle: "Kunden ønsker oppfølging senere",
        accent: "amber",
      };
    }

    return null;
  };

  const effectiveWorkflowStatus = (inquiry: Inquiry): string => {
    const inquiryId = normalizeInquiryId(inquiry.id);
    const rawStatus = String(inquiry.status || "").toLowerCase();
    const latestOffer = offerOverview[inquiryId.toString()] || null;
    const offerStatus = String(latestOffer?.status || "").toLowerCase();

    // En avsluttet sak skal aldri åpnes igjen av en eldre tilbudsstatus.
    if (rawStatus === "avsluttet") return "avsluttet";

    // Tilbudsstatus er autoritativ når digital befaring er endret til
    // videre feltoppfølging. Dermed kan en gammel inquiry-status ikke
    // sende prosjektlederen tilbake til digital befaring.
    if (offerStatus === "akseptert") return "tilbud_akseptert";
    if (offerStatus === "publisert") return "tilbud_sendt";
    if (offerStatus === "avvist") return "tilbud_avvist";
    if (offerStatus === "utlopt" && !confirmedBooking(inquiry)) return "tilbud_utlopt";

    return rawStatus;
  };

  // Bruk faktisk registrert tidspunkt fra saken eller eksisterende feltavtale.
  // Et tidsforslag regnes ikke som bekreftet avtale.
  const confirmedBooking = (inquiry: Inquiry): Date | null => {
    const saved = parseInquiryBooking(inquiry);
    if (saved) return saved;
    const schedule = fieldScheduleOverview[normalizeInquiryId(inquiry.id).toString()];
    if (!schedule?.schedule_date || !schedule.start_time) return null;
    if (!["bekreftet", "planlagt", "låst", "locked", "akseptert"].includes(
      String(schedule.status || "").toLowerCase()
    )) return null;
    const date = new Date(`${schedule.schedule_date}T${String(schedule.start_time).slice(0, 5)}:00`);
    return Number.isNaN(date.getTime()) ? null : date;
  };

  const isPureDigitalWorkflow = (inquiry: Inquiry): boolean =>
    String(inquiry.stage || "").toLowerCase() === "digital_befaring" &&
    !inquiry.recommended_service &&
    !["tilbud_sendt", "tilbud_akseptert", "tilbud_avvist"].includes(
      effectiveWorkflowStatus(inquiry)
    );

  const inquiryProgress = (inquiry: Inquiry) => {
    const inquiryId = normalizeInquiryId(inquiry.id);
    const reportForInquiry = reportOverview[inquiryId.toString()] || null;
    const reportStatus = reportForInquiry?.status;
    if (approvalStates[String(inquiryId)] === "awaiting_pm") {
      return { key: "report_approval", label: "Krever godkjenning", subtitle: "Rapport 1 venter på faglig kontroll", accent: "amber" };
    }
    const status = effectiveWorkflowStatus(inquiry);
    const booking = parseInquiryBooking(inquiry);
    const now = new Date();
    const activeFollowup = followupProgress(inquiry);

    // Etter publisert rapport er videre oppfølging den operative statusen.
    if (reportStatus === "publisert" && activeFollowup) {
      return activeFollowup;
    }

    // Fullført sjekkliste er dokumentert feltkontroll, men ikke i seg selv
    // dokumentasjon på at hele oppdraget er formelt avsluttet.
    const completedChecklist = checklistOverview[inquiryId.toString()] || [];
    const checklistRegistered = completedChecklist.length > 0 &&
      completedChecklist.every((item) => Boolean(String(item.status || "").trim()));
    if (!reportStatus && checklistRegistered) {
      return {
        key: "field_documented",
        label: "Kontroll registrert",
        subtitle: "Kontrollpunkter utfylt – rapportstatus ikke bekreftet",
        accent: "cyan",
      };
    }

    // Rapportprogresjon har prioritet over gammel oppdragsstatus.
    // Et oppdrag skal derfor ikke bli stående som "Planlagt" når rapportarbeidet har startet.
    if (reportStatus === "publisert") {
      return {
        key: "report_done",
        label: "Rapport ferdig",
        subtitle: "Publisert til kunde",
        accent: "emerald",
      };
    }

    if (reportStatus === "godkjent") {
      return {
        key: "report_done",
        label: "Rapport ferdig",
        subtitle: "Godkjent av admin",
        accent: "emerald",
      };
    }

    if (
      reportStatus === "sendt_til_admin" ||
      reportStatus === "under_gjennomgang"
    ) {
      return {
        key: "report_review",
        label: "Til gjennomgang",
        subtitle:
          reportStatus === "under_gjennomgang"
            ? "Admin gjennomgår rapport"
            : "Sendt til admin",
        accent: "blue",
      };
    }

    if (
      reportStatus === "utkast" ||
      reportStatus === "returnert_til_prosjektansvarlig" ||
      inquiry.stage === "rapport_funn"
    ) {
      return {
        key: "report_progress",
        label: "Rapport pågår",
        subtitle:
          reportStatus === "returnert_til_prosjektansvarlig"
            ? "Returnert for korrigering"
            : "Rapport og funn",
        accent: "cyan",
      };
    }

    if (["utfort", "avsluttet"].includes(status)) {
      return {
        key: "completed",
        label: "Fullført",
        subtitle: "Ferdig sak",
        accent: "emerald",
      };
    }

    if (status === "venter_pa_tilbud") {
      return {
        key: "waiting",
        label: "Avventer admin",
        subtitle: "Tilbud skal utarbeides og sendes",
        accent: "purple",
      };
    }

    if (status === "tilbud_sendt") {
      return {
        key: "waiting",
        label: "Venter på kunde",
        subtitle: "Tilbud sendt",
        accent: "purple",
      };
    }

    if (status === "tilbud_utlopt") {
      return { key: "expired", label: "Tilbud utløpt", subtitle: "Avventer ny forespørsel fra kunden", accent: "slate" };
    }

    if (status === "tilbud_akseptert" && confirmedBooking(inquiry)) {
      return {
        key: "planned",
        label: "Planlagt",
        subtitle: formatBooking(confirmedBooking(inquiry)),
        accent: "emerald",
      };
    }

    if (status === "tilbud_akseptert") {
      return {
        key: "planning",
        label: "Planlegges",
        subtitle: "Tilbud akseptert",
        accent: "amber",
      };
    }

    if (
      booking &&
      sameDay(booking, now) &&
      ["planlagt", "pagaende"].includes(status)
    ) {
      return {
        key: "today",
        label: "Utføres i dag",
        subtitle: "Aktivt oppdrag",
        accent: "blue",
      };
    }

    if (status === "planlagt" && booking && booking.getTime() < now.getTime()) {
      return {
        key: "field_unverified",
        label: "Utførelse ikke bekreftet",
        subtitle: "Avtalt tidspunkt er passert; ingen gjennomføring dokumentert i tilgjengelige data",
        accent: "amber",
      };
    }

    if (status === "planlagt") {
      return {
        key: "planned",
        label: "Planlagt",
        subtitle: "Kommende oppdrag",
        accent: "emerald",
      };
    }

    return {
      key: "other",
      label: "Aktivt oppdrag",
      subtitle: stageLabel(inquiry.stage),
      accent: "slate",
    };
  };

  const progressNextAction = (inquiry: Inquiry, booking: Date | null): string => {
    const inquiryId = normalizeInquiryId(inquiry.id);
    const reportForInquiry = reportOverview[inquiryId.toString()] || null;
    if (approvalStates[String(inquiryId)] === "awaiting_pm") {
      return "Godkjenn eller returner Rapport 1";
    }
    const schedule =
      fieldScheduleOverview[inquiryId.toString()] || null;
    const scheduleStatus = String(schedule?.status || "").toLowerCase();
    const actualProgress = inquiryProgress(inquiry);
    if (actualProgress.key === "field_documented") {
      return "Kontrollpunkter er registrert – kontroller rapportstatus";
    }
    if (actualProgress.key === "field_unverified") {
      return "Avklar om lekkasjesøket ble gjennomført";
    }

    if (reportForInquiry?.status === "publisert" && schedule) {
      const when = formatFieldScheduleDateTime(schedule);

      if (
        scheduleStatus === "foreslatt" ||
        scheduleStatus === "foreslatt_av_prosjektleder"
      ) {
        return schedule.service === "takkontroll"
          ? `Vedlikehold foreslått · ${when}`
          : `${serviceLabel(schedule.service)} foreslått · ${when}`;
      }

      if (scheduleStatus === "foreslatt_av_kunde") {
        const proposedDate = schedule.customer_proposed_date
          ? new Date(`${schedule.customer_proposed_date}T12:00:00`)
          : null;
        const proposedDateLabel =
          proposedDate && !Number.isNaN(proposedDate.getTime())
            ? proposedDate.toLocaleDateString("nb-NO", {
                day: "2-digit",
                month: "2-digit",
                year: "numeric",
              })
            : schedule.customer_proposed_date || "ny dato";
        const proposedTime = schedule.customer_proposed_time
          ? String(schedule.customer_proposed_time).substring(0, 5)
          : "";

        return `Kunden foreslår ${proposedDateLabel}${
          proposedTime ? ` kl. ${proposedTime}` : ""
        } – krever svar`;
      }

      if (scheduleStatus === "bekreftet") {
        return schedule.service === "takkontroll"
          ? `Vedlikehold bekreftet · ${when}`
          : `${serviceLabel(schedule.service)} bekreftet · ${when}`;
      }

      if (scheduleStatus === "avvist" || scheduleStatus === "avlyst") {
        return "Kunden har takket nei – avklar eventuell videre oppfølging";
      }

      if (scheduleStatus === "utsatt") {
        return "Oppfølging er utsatt – avtal nytt tidspunkt senere";
      }
    }

    if (confirmedBooking(inquiry) &&
        ["tilbud_akseptert", "planlagt", "pagaende"].includes(effectiveWorkflowStatus(inquiry))) {
      return `${serviceLabel(fieldServiceForInquiry(inquiry)).toLowerCase()} er planlagt · ${formatBooking(confirmedBooking(inquiry))}`;
    }

    if (effectiveWorkflowStatus(inquiry) === "tilbud_utlopt") {
      return "Avventer forespørsel om nytt tidspunkt";
    }

    switch (reportForInquiry?.status) {
      case "utkast":
        return "Ferdigstill rapportutkastet";
      case "returnert_til_prosjektansvarlig":
        return "Korriger rapporten og send tilbake til admin";
      case "sendt_til_admin":
        return "Rapport sendt – venter på admin";
      case "under_gjennomgang":
        return "Rapporten er under admin-gjennomgang";
      case "godkjent":
        return "Rapport godkjent – klargjør publisering";
      case "publisert":
        return "Rapport publisert til kunde";
      default:
        return projectNextAction(
          { ...inquiry, status: effectiveWorkflowStatus(inquiry) },
          booking
        );
    }
  };

  const overviewGroups = useMemo(() => {
    const source = fieldInquiries.filter((inquiry) => {
      if (!overviewStatusFilter) return true;
      return inquiryProgress(inquiry).key === overviewStatusFilter;
    });

    const sortByBooking = (items: Inquiry[]) => [...items].sort((a, b) => {
      const aBooking = parseInquiryBooking(a);
      const bBooking = parseInquiryBooking(b);
      if (aBooking && bBooking) return aBooking.getTime() - bBooking.getTime();
      if (aBooking) return -1;
      if (bBooking) return 1;
      return normalizeInquiryId(a.id) - normalizeInquiryId(b.id);
    });

    const byKey = (key: string) =>
      sortByBooking(source.filter((inquiry) => inquiryProgress(inquiry).key === key));

    return [
      { key: "followup_customer", title: "Svar fra kunde", subtitle: "krever prosjektleders handling", accent: "purple", items: byKey("followup_customer") },
      { key: "followup_waiting", title: "Venter på kundesvar", subtitle: "videre oppfølging foreslått", accent: "amber", items: byKey("followup_waiting") },
      { key: "followup_confirmed", title: "Oppfølging bekreftet", subtitle: "avtalt med kunde", accent: "emerald", items: byKey("followup_confirmed") },
      { key: "followup_declined", title: "Kunde takket nei", subtitle: "må eventuelt avklares", accent: "red", items: byKey("followup_declined") },
      { key: "report_approval", title: "Rapporter til godkjenning", subtitle: "krever faglig beslutning", accent: "amber", items: byKey("report_approval") },
      { key: "report_progress", title: "Rapport pågår", subtitle: "rapport og funn", accent: "cyan", items: byKey("report_progress") },
      { key: "report_review", title: "Til gjennomgang", subtitle: "rapport sendt til admin", accent: "blue", items: byKey("report_review") },
      { key: "report_done", title: "Rapport ferdig", subtitle: "godkjent eller publisert", accent: "emerald", items: byKey("report_done") },
      { key: "today", title: "Utføres i dag", subtitle: "aktive oppdrag", accent: "blue", items: byKey("today") },
      { key: "planned", title: "Planlagt", subtitle: "kommende oppdrag", accent: "emerald", items: byKey("planned") },
      { key: "planning", title: "Planlegg oppdrag", subtitle: "tilbud akseptert", accent: "amber", items: byKey("planning") },
      { key: "waiting", title: "Venter på kunde", subtitle: "tilbud sendt", accent: "purple", items: byKey("waiting") },
      { key: "completed", title: "Fullført", subtitle: "ferdige saker", accent: "emerald", items: byKey("completed") },
      { key: "other", title: "Andre aktive oppdrag", subtitle: "digital befaring og oppfølging", accent: "slate", items: byKey("other") },
    ].filter((group) => group.items.length > 0);
  }, [
    fieldInquiries,
    overviewStatusFilter,
    reportOverview,
    approvalStates,
    offerOverview,
    fieldScheduleOverview,
  ]);

  const monthDays = useMemo(() => {
    const year = calendarCursor.getFullYear();
    const month = calendarCursor.getMonth();
    const first = new Date(year, month, 1);
    const mondayIndex = (first.getDay() + 6) % 7;
    const gridStart = new Date(year, month, 1 - mondayIndex);

    return Array.from({ length: 42 }, (_, index) => {
      const day = new Date(gridStart);
      day.setDate(gridStart.getDate() + index);
      return day;
    });
  }, [calendarCursor]);

  const weekDays = useMemo(() => {
    const start = startOfWeek(calendarCursor);
    return Array.from({ length: 7 }, (_, index) => {
      const day = new Date(start);
      day.setDate(start.getDate() + index);
      return day;
    });
  }, [calendarCursor]);

  const calendarTitle = useMemo(() => {
    if (calendarView === "dag") {
      return new Intl.DateTimeFormat("nb-NO", {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
      }).format(calendarCursor);
    }

    if (calendarView === "uke") {
      const start = startOfWeek(calendarCursor);
      const end = new Date(start);
      end.setDate(start.getDate() + 6);

      return `${new Intl.DateTimeFormat("nb-NO", {
        day: "2-digit",
        month: "short",
      }).format(start)} – ${new Intl.DateTimeFormat("nb-NO", {
        day: "2-digit",
        month: "short",
        year: "numeric",
      }).format(end)}`;
    }

    return new Intl.DateTimeFormat("nb-NO", {
      month: "long",
      year: "numeric",
    }).format(calendarCursor);
  }, [calendarCursor, calendarView]);

  const moveCalendar = (direction: number) => {
    const next = new Date(calendarCursor);

    if (calendarView === "maaned") {
      next.setMonth(next.getMonth() + direction);
    } else if (calendarView === "uke") {
      next.setDate(next.getDate() + 7 * direction);
    } else {
      next.setDate(next.getDate() + direction);
    }

    setCalendarCursor(next);
  };

  const fetchStaffEmployees = async () => {
    try {
      const res = await fetch(apiUrl("/employees.php"));
      const data = await res.json();

      if (res.ok && Array.isArray(data)) {
        setStaffEmployees(data);
      }
    } catch (err) {
      console.error("Kunne ikke hente ansatte til teamplanlegging:", err);
    }
  };

  const updateTeamScheduleDraft = (
    inquiryId: number,
    patch: Partial<{
      date: string;
      startTime: string;
      endTime: string;
      comment: string;
    }>
  ) => {
    const key = inquiryId.toString();

    setTeamScheduleDrafts((current) => ({
      ...current,
      [key]: {
        date:
          current[key]?.date ??
          fieldScheduleOverview[key]?.schedule_date ??
          "",
        startTime:
          current[key]?.startTime ??
          (fieldScheduleOverview[key]?.start_time
            ? String(fieldScheduleOverview[key]?.start_time).substring(0, 5)
            : "09:00"),
        endTime:
          current[key]?.endTime ??
          (fieldScheduleOverview[key]?.end_time
            ? String(fieldScheduleOverview[key]?.end_time).substring(0, 5)
            : ""),
        comment:
          current[key]?.comment ??
          fieldScheduleOverview[key]?.comment ??
          "",
        ...patch,
      },
    }));
  };

  const assignTechnicianToInquiry = async (
    inquiry: Inquiry,
    employeeId: number
  ) => {
    const inquiryId = normalizeInquiryId(inquiry.id);
    if (!inquiryId || !employeeId) return;

    setTeamSavingId(`technician-${inquiryId}`);
    setTeamMessage("");
    setTeamError("");

    try {
      const res = await fetch(apiUrl("/inquiry_team.php"), {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: inquiryId,
          employee_id: employeeId,
          role: "Tekniker",
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke tildele tekniker.");
      }

      const refreshed = await fetchTeamOverview([inquiry]);
      setTeamOverview((current) => ({
        ...current,
        ...refreshed,
      }));

      setTeamTechnicianDrafts((current) => ({
        ...current,
        [inquiryId.toString()]: employeeId.toString(),
      }));

      const selected = staffEmployees.find(
        (employee) => Number(employee.id) === employeeId
      );

      setTeamMessage(
        `${selected?.name || "Teknikeren"} er tildelt oppdrag #${inquiryId}.`
      );
    } catch (err) {
      setTeamError(
        err instanceof Error ? err.message : "Kunne ikke tildele tekniker."
      );
    } finally {
      setTeamSavingId(null);
    }
  };

  const saveTeamSchedule = async (inquiry: Inquiry) => {
    const inquiryId = normalizeInquiryId(inquiry.id);
    if (!inquiryId) return;

    const key = inquiryId.toString();
    const existingSchedule = fieldScheduleOverview[key] || null;
    const reportForInquiry = reportOverview[key] || null;
    const isFollowupPlanning =
      String(reportForInquiry?.status || "").toLowerCase() === "publisert";

    const draft = {
      date:
        teamScheduleDrafts[key]?.date ??
        existingSchedule?.schedule_date ??
        "",
      startTime:
        teamScheduleDrafts[key]?.startTime ??
        (existingSchedule?.start_time
          ? String(existingSchedule.start_time).substring(0, 5)
          : "09:00"),
      endTime:
        teamScheduleDrafts[key]?.endTime ??
        (existingSchedule?.end_time
          ? String(existingSchedule.end_time).substring(0, 5)
          : ""),
      comment:
        teamScheduleDrafts[key]?.comment ??
        existingSchedule?.comment ??
        "",
    };

    if (!draft.date) {
      setTeamError("Velg dato før du sender tidsforslaget.");
      return;
    }

    setTeamSavingId(`schedule-${inquiryId}`);
    setTeamMessage("");
    setTeamError("");

    try {
      const payload = {
        inquiry_id: inquiryId,
        service:
          existingSchedule?.service ||
          inquiry.recommended_service ||
          "service",
        schedule_date: draft.date,
        start_time: draft.startTime || "09:00",
        end_time: draft.endTime || null,
        comment: draft.comment,
        proposed_by_employee_id: previewEmployee?.id || null,
        proposed_by_name:
          previewEmployee?.name ||
          inquiry.assigned_to ||
          null,
      };

      const res = await fetch(apiUrl("/field_schedule.php"), {
        method: existingSchedule?.id ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(
          existingSchedule?.id
            ? {
                id: existingSchedule.id,
                ...payload,
                action: "project_manager_propose_time",
              }
            : {
                ...payload,
                mode: isFollowupPlanning
                  ? "followup_proposal"
