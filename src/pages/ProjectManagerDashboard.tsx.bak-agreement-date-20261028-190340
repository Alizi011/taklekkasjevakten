function extractFollowUpReasonFromReport(report?: ReportData | null): string {
  if (!report) return "";

  const source = String(report.admin_final || report.ai_draft || "").trim();
  if (!source) return "";

  const normalized = source.replace(/\r\n/g, "\n");

  const extractSection = (headings: string[]): string => {
    for (const heading of headings) {
      const pattern = new RegExp(
        String.raw`(?:^|\n)\s*(?:#+\s*)?(?:\d+[\.\)]?\s*)?${heading}\s*:?\s*\n([\s\S]*?)(?=\n\s*(?:#+\s*)?(?:\d+[\.\)]?\s*)?[A-ZÆØÅ][A-ZÆØÅ0-9 /&().,\-]{3,}\s*:?\s*\n|$)`,
        "i"
      );

      const match = normalized.match(pattern);
      if (match?.[1]?.trim()) {
        return match[1]
          .trim()
          .replace(/\n{3,}/g, "\n\n");
      }
    }

    return "";
  };

  const deviations = extractSection([
    "AVVIK OG FAGLIG VURDERING",
    "AVVIK",
    "FAGLIG VURDERING",
    "REGISTRERTE AVVIK",
  ]);

  const recommendations = extractSection([
    "ANBEFALTE TILTAK",
    "ANBEFALINGER",
    "ANBEFALT VIDERE OPPFØLGING",
    "VIDERE OPPFØLGING",
  ]);

  const parts: string[] = [];

  if (deviations) {
    parts.push(`Registrerte avvik / faglig vurdering:\n${deviations}`);
  }

  if (recommendations) {
    parts.push(`Anbefalt videre oppfølging:\n${recommendations}`);
  }

  if (parts.length > 0) {
    return parts.join("\n\n");
  }

  // Fallback: bruk rapportens konklusjon dersom de strukturerte seksjonene
  // ikke finnes i en eldre rapport.
  const conclusion = extractSection([
    "SAMMENDRAG OG HOVEDKONKLUSJON",
    "HOVEDKONKLUSJON",
    "KONKLUSJON",
  ]);

  return conclusion
    ? `Rapportens konklusjon:\n${conclusion}`
    : "";
}

