function projectProgressStep(inquiry: Inquiry): number {
  const stage = String(inquiry.stage || "").toLowerCase();
  const status = String(inquiry.status || "").toLowerCase();

  if (
    stage === "rapport_funn" ||
    ["utfort", "avsluttet"].includes(status)
  ) {
    return 5;
  }

  if (
    stage === "utfonring_felt" &&
    ["tilbud_akseptert", "planlagt", "pagaende"].includes(status)
  ) {
    return 4;
  }

  if (
    stage === "utfonring_felt" ||
    ["venter_pa_tilbud", "tilbud_sendt"].includes(status)
  ) {
    return 3;
  }

  if (
    stage === "digital_befaring" ||
    [
      "tildelt_prosjektansvarlig",
      "digital_befaring_tid_forslag",
      "digital_befaring_bekreftet",
    ].includes(status)
  ) {
    return 2;
  }

  return 1;
}



function projectNextAction(inquiry: Inquiry, booking: Date | null): string {
  const step = projectProgressStep(inquiry);
  const time = booking
    ? booking.toLocaleTimeString("nb-NO", {
        hour: "2-digit",
        minute: "2-digit",
      })
    : null;

  if (step === 2) {
    if ((inquiry.status || "").toLowerCase() === "digital_befaring_tid_forslag") {
      return "Venter på at kunden velger tidspunkt";
    }

    if (booking && time) {
      return `Gjennomfør digital befaring kl. ${time}`;
    }

    return "Foreslå tidspunkt for digital befaring";
  }

  if (step === 3) {
    const status = String(inquiry.status || "").toLowerCase();

    if (status === "tilbud_sendt") {
      return "Venter på at kunden aksepterer eller avslår tilbudet";
    }

    if (status === "venter_pa_tilbud") {
      return "Pristilbud må ferdigstilles og sendes";
    }

    return "Følg opp tilbud";
  }

  if (step === 4) {
    if (booking && time) {
      return `Gjennomfør ${serviceLabel(inquiry.recommended_service).toLowerCase()} kl. ${time}`;
    }

    return `Planlegg tidspunkt for ${serviceLabel(inquiry.recommended_service).toLowerCase()}`;
  }

  if (step === 5) {
    return "Ferdigstill og send rapport til admin";
  }

  return "Kontroller kundeopplysningene";
}


function InquiryPhotosManager({ inquiryId }: { inquiryId: number }) {
  const [photos, setPhotos] = useState<PhotoData[]>([]);
  const [loading, setLoading] = useState(true);
  const [uploading, setUploading] = useState(false);
  const [savingPhotoId, setSavingPhotoId] = useState<number | null>(null);
  const [savedPhotoId, setSavedPhotoId] = useState<number | null>(null);
  const [error, setError] = useState("");

  const fetchPhotos = async () => {
    setLoading(true);
    setError("");

    try {
      const res = await fetch(apiUrl(`/photos.php?inquiry_id=${inquiryId}`));
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke hente feltbilder.");
      }

      setPhotos(Array.isArray(data.photos) ? data.photos : []);
    } catch (err) {
      setError(err instanceof Error ? err.message : "Kunne ikke hente feltbilder.");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (inquiryId > 0) fetchPhotos();
  }, [inquiryId]);

  const handleFileUpload = async (
    event: React.ChangeEvent<HTMLInputElement>
  ) => {
    const files = Array.from(event.target.files || []);
    if (!files.length) return;

    setUploading(true);
    setError("");

    try {
      for (const file of files) {
        const formData = new FormData();
        formData.append("inquiry_id", inquiryId.toString());
        formData.append("photo", file);
        // Felt-/lekkasjesøk-dokumentasjon er alltid fase 1 · Før.
        formData.append("documentation_phase", "1");
        formData.append("include_in_report", "0");

        const res = await fetch(apiUrl("/photos.php"), {
          method: "POST",
          body: formData,
        });

        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(data.message || `Kunne ikke laste opp ${file.name}.`);
        }
      }

      await fetchPhotos();
      event.target.value = "";
    } catch (err) {
      setError(err instanceof Error ? err.message : "Bildeopplasting feilet.");
    } finally {
      setUploading(false);
    }
  };

  const handleAudioSaved = (photoId: number, audioUrl: string) => {
    setPhotos((prev) =>
      prev.map((photo) =>
        photo.id === photoId ? { ...photo, audio_url: audioUrl } : photo
      )
    );
  };

  const patchLocalPhoto = (photoId: number, patch: Partial<PhotoData>) => {
    setPhotos((prev) =>
      prev.map((photo) =>
        photo.id === photoId ? { ...photo, ...patch } : photo
      )
    );
  };

  const savePhotoReportSettings = async (photo: PhotoData) => {
    setSavingPhotoId(photo.id);
    setSavedPhotoId(null);
    setError("");

    try {
      const formData = new FormData();
      formData.append("photo_id", String(photo.id));
      formData.append("inquiry_id", String(inquiryId));
      formData.append(
        "include_in_report",
        photo.include_in_report ? "1" : "0"
      );
      formData.append("caption_text", photo.caption_text || "");

      if (photo.documentation_phase) {
        formData.append(
          "documentation_phase",
          String(photo.documentation_phase)
        );
      }

      if (photo.work_completion_item_id) {
        formData.append(
          "work_completion_item_id",
          String(photo.work_completion_item_id)
        );
      }

      if (photo.custom_point_title) {
        formData.append("custom_point_title", photo.custom_point_title);
      }

      if (
        photo.report_sort_order !== null &&
        photo.report_sort_order !== undefined
      ) {
        formData.append("report_sort_order", String(photo.report_sort_order));
      } else {
        formData.append("report_sort_order", "");
      }

      const res = await fetch(apiUrl("/photos.php"), {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke lagre rapportvalget.");
      }

      if (data.photo) {
        patchLocalPhoto(photo.id, data.photo);
      }

      setSavedPhotoId(photo.id);
      window.setTimeout(() => {
        setSavedPhotoId((current) => (current === photo.id ? null : current));
      }, 1800);
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Kunne ikke lagre rapportvalget."
      );
    } finally {
      setSavingPhotoId(null);
    }
  };

  const selectedForReport = photos.filter(
    (photo) => Boolean(Number(photo.include_in_report))
  ).length;

  return (
    <section className="bg-[#211612] border border-slate-800 rounded-3xl p-6 space-y-5">
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800/80 pb-4">
        <div>
          <h3 className="font-extrabold text-base text-white flex items-center gap-2">
            <Camera className="w-5 h-5 text-orange-300" />
            Felt-dokumentasjon
          </h3>
          <p className="text-[11px] text-slate-400 mt-1">
            Bilder og lydnotater fra prosjektansvarlig og tekniker. Velg selv hvilke
            bilder som skal inngå i den endelige rapporten.
          </p>
        </div>

        <div className="flex flex-wrap items-center gap-2">
          <span className="inline-flex items-center gap-2 rounded-xl border border-slate-700 bg-slate-950 px-3 py-2 text-[11px] font-extrabold text-slate-300">
            <FileText className="w-3.5 h-3.5 text-red-400" />
            {selectedForReport} valgt til rapport
          </span>

          <label className="bg-[#ff951a] hover:bg-orange-400 text-slate-950 font-extrabold px-4 py-2.5 rounded-xl text-xs flex items-center justify-center gap-2 cursor-pointer transition-all">
            {uploading ? (
              <Loader2 className="w-4 h-4 animate-spin" />
            ) : (
              <Upload className="w-4 h-4" />
            )}
            {uploading ? "Laster opp..." : "Legg til bilder"}
            <input
              type="file"
              accept="image/*"
              multiple
              capture="environment"
              onChange={handleFileUpload}
              className="hidden"
              disabled={uploading}
            />
          </label>
        </div>
      </div>

      {error && (
        <div className="rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-xs text-red-300">
          {error}
        </div>
      )}

      {loading ? (
        <div className="py-8 flex items-center justify-center gap-2 text-xs text-slate-400">
          <Loader2 className="w-4 h-4 animate-spin text-amber-400" />
          Henter feltbilder...
        </div>
      ) : photos.length === 0 ? (
        <div className="border border-dashed border-slate-800 rounded-2xl py-10 text-center text-xs text-slate-500">
          Ingen feltbilder er lastet opp ennå.
        </div>
      ) : (
        <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
          {photos.map((photo) => {
            const included = Boolean(Number(photo.include_in_report));
            const isSaving = savingPhotoId === photo.id;
            const isSaved = savedPhotoId === photo.id;

            return (
              <article
                key={photo.id}
                className={`overflow-hidden rounded-2xl border transition-all ${
                  included
                    ? "border-red-500/40 bg-red-500/[0.035] shadow-[0_0_0_1px_rgba(239,68,68,0.04)]"
                    : "border-slate-800 bg-slate-950/50"
                }`}
              >
                <div className="p-3">
                  <PhotoWithAudioNote
                    photoId={photo.id}
                    photoUrl={photo.photo_url}
                    onAudioSaved={handleAudioSaved}
                  />
                </div>

                <div className="border-t border-slate-800 p-4 space-y-4">
                  <label className="flex items-start gap-3 cursor-pointer select-none">
                    <input
                      type="checkbox"
                      checked={included}
                      onChange={(event) =>
                        patchLocalPhoto(photo.id, {
                          include_in_report: event.target.checked ? 1 : 0,
                        })
                      }
                      className="mt-0.5 h-4 w-4 rounded border-slate-600 bg-slate-900 accent-red-500"
                    />
                    <span className="min-w-0">
                      <span className="block text-xs font-extrabold text-white">
                        Ta med i rapport
                      </span>
                      <span className="block text-[10px] leading-4 text-slate-500 mt-0.5">
                        Bare valgte bilder blir med i PDF-rapporten.
                      </span>
                    </span>
                  </label>

                  <div>
                    <label className="block text-[9px] uppercase tracking-wider font-extrabold text-slate-500 mb-1.5">
                      Bildetekst
                    </label>
                    <textarea
                      value={photo.caption_text || ""}
                      onChange={(event) =>
                        patchLocalPhoto(photo.id, {
                          caption_text: event.target.value,
                        })
                      }
                      rows={2}
                      placeholder="Beskriv hva bildet viser..."
                      className="w-full resize-none rounded-xl border border-slate-800 bg-[#211410] px-3 py-2.5 text-xs text-slate-200 outline-none transition focus:border-red-500/40"
                    />
                  </div>

                  <div className="grid grid-cols-[minmax(0,1fr)_auto] gap-3 items-end">
                    <div>
                      <label className="block text-[9px] uppercase tracking-wider font-extrabold text-slate-500 mb-1.5">
                        Rekkefølge i rapport
                      </label>
                      <input
                        type="number"
                        min={1}
                        step={1}
                        value={photo.report_sort_order ?? ""}
                        onChange={(event) =>
                          patchLocalPhoto(photo.id, {
                            report_sort_order:
                              event.target.value === ""
                                ? null
                                : Number(event.target.value),
                          })
                        }
                        placeholder="1"
                        className="w-full rounded-xl border border-slate-800 bg-[#211410] px-3 py-2.5 text-xs text-slate-200 outline-none transition focus:border-red-500/40"
                      />
                    </div>

                    <button
                      type="button"
                      onClick={() => savePhotoReportSettings(photo)}
                      disabled={isSaving}
                      className="h-[38px] rounded-xl border border-slate-700 bg-slate-900 px-3.5 text-[11px] font-extrabold text-white transition hover:border-red-500/40 hover:bg-slate-800 disabled:opacity-50"
                    >
                      {isSaving ? (
                        <span className="flex items-center gap-1.5">
                          <Loader2 className="w-3.5 h-3.5 animate-spin" />
                          Lagrer
                        </span>
                      ) : isSaved ? (
                        <span className="flex items-center gap-1.5 text-emerald-400">
                          <CheckCircle2 className="w-3.5 h-3.5" />
                          Lagret
                        </span>
                      ) : (
                        "Lagre"
                      )}
                    </button>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </section>
  );
}

