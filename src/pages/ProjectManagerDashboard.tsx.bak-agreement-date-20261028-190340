                slot?.slot_date &&
                slot?.start_time &&
                slot.available !== false
            )
            .slice(0, 3)
        : [];

      setSuggestedBookingSlots(slots);

      // Hvis saken ikke allerede har et tidsforslag, velg første ledige tid automatisk.
      if (
        slots.length > 0 &&
        !fieldSchedule?.id &&
        !inquiry?.booking_date
      ) {
        chooseSuggestedBookingSlot(slots[0]);
