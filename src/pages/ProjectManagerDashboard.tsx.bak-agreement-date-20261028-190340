interface WorkCompletionItem {
  id: number;
  title: string;
  description?: string | null;
  item_status?: string | null;
  result_status?: string | null;
  result_tg?: string | null;
  comment?: string | null;
  sort_order?: number | null;
}

interface WorkDocumentation {
  id: number;
  inquiry_id: number;
  checklist_item_id?: string | null;
  documentation_phase?: number | null;
  work_completion_item_id?: number | null;
  custom_point_title?: string | null;
  photo_url?: string | null;
  audio_url?: string | null;
  audio_transcript?: string | null;
  caption_text?: string | null;
  created_at?: string | null;
}

interface CustomPoint {
  key: string;
  title: string;
}

interface Props {
  inquiryId: number;
}

const phaseMeta = {
  1: {
    label: "1 · Før",
    description: "Dokumentasjon av mangelen før utbedring.",
  },
  2: {
    label: "2 · Under arbeid",
    description: "Dokumentasjon av selve utførelsen.",
  },
  3: {
    label: "3 · Resultat",
    description: "Dokumentasjon av ferdig resultat.",
  },
} as const;

export function LegacyWorkDocumentationWorkspace({ inquiryId }: Props) {
  const [items, setItems] = useState<WorkCompletionItem[]>([]);
  const [documents, setDocuments] = useState<WorkDocumentation[]>([]);
  const [customPoints, setCustomPoints] = useState<CustomPoint[]>([]);
  const [newPointTitle, setNewPointTitle] = useState("");
  const [loading, setLoading] = useState(true);
  const [uploadingKey, setUploadingKey] = useState<string | null>(null);
  const [savingCaptionId, setSavingCaptionId] = useState<number | null>(null);
  const [captionDrafts, setCaptionDrafts] = useState<Record<number, string>>({});
  const [linkTarget, setLinkTarget] = useState<Record<number, number | "">>({});
  const [message, setMessage] = useState("");
  const [error, setError] = useState("");

  const fetchData = async () => {
    setLoading(true);
    setError("");

    try {
      const [completionRes, photosRes] = await Promise.all([
        fetch(apiUrl(`/work_completion.php?inquiry_id=${inquiryId}`)),
        fetch(apiUrl(`/photos.php?inquiry_id=${inquiryId}`)),
      ]);

      const completionData = await completionRes.json();
      const photosData = await photosRes.json();

      if (!completionRes.ok || !completionData.success) {
        throw new Error(
          completionData.message || "Kunne ikke hente utbedringstiltak."
        );
      }

      if (!photosRes.ok || !photosData.success) {
        throw new Error(
          photosData.message || "Kunne ikke hente dokumentasjon."
        );
      }

      const nextItems = Array.isArray(completionData.items)
        ? completionData.items
        : [];
      const nextDocuments = Array.isArray(photosData.photos)
        ? photosData.photos
        : [];

      setItems(nextItems);
      setDocuments(nextDocuments);

      const persistedCustomTitles: string[] = Array.from(
        new Set<string>(
          (nextDocuments as WorkDocumentation[])
            .map((doc) => String(doc.custom_point_title || "").trim())
            .filter((title): title is string => title.length > 0)
        )
      );

      setCustomPoints((current) => {
        const merged = [
          ...current,
          ...persistedCustomTitles.map((title) => ({
            key: `persisted-${title}`,
            title,
          })),
        ];

        const seen = new Set<string>();
        return merged.filter((point) => {
          const normalized = point.title.trim().toLowerCase();
          if (!normalized || seen.has(normalized)) return false;
          seen.add(normalized);
          return true;
        });
      });

      setCaptionDrafts(
        Object.fromEntries(
          nextDocuments.map((doc: WorkDocumentation) => [
            doc.id,
            doc.caption_text || "",
          ])
        )
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke hente dokumentasjonen."
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    fetchData();
  }, [inquiryId]);

  const documentsForItem = (itemId: number, phase: 1 | 2 | 3) =>
    documents.filter(
      (doc) =>
        Number(doc.work_completion_item_id || 0) === itemId &&
        Number(doc.documentation_phase || 0) === phase
    );

  const documentsForCustomPoint = (title: string, phase: 1 | 2 | 3) =>
    documents.filter(
      (doc) =>
        String(doc.custom_point_title || "").trim() === title.trim() &&
        !doc.work_completion_item_id &&
        Number(doc.documentation_phase || 0) === phase
    );

  const unlinkedPreviousDocuments = useMemo(
    () =>
      documents.filter(
        (doc) =>
          !doc.work_completion_item_id &&
          !doc.custom_point_title &&
          !doc.documentation_phase
      ),
    [documents]
  );

  const upload = async ({
    file,
    phase,
    itemId,
    customTitle,
    kind,
  }: {
    file: File;
    phase: 1 | 2 | 3;
    itemId?: number;
    customTitle?: string;
    kind: "photo" | "audio";
  }) => {
    const identity = itemId ? `item-${itemId}` : `custom-${customTitle}`;
    const key = `${identity}-${phase}-${kind}`;

    setUploadingKey(key);
    setMessage("");
    setError("");

    try {
      const formData = new FormData();
      formData.append("inquiry_id", String(inquiryId));
      formData.append("documentation_phase", String(phase));

      if (itemId) {
        formData.append("work_completion_item_id", String(itemId));
      }

      if (customTitle) {
        formData.append("custom_point_title", customTitle);
      }

      formData.append(kind, file);

      const res = await fetch(apiUrl("/photos.php"), {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke laste opp dokumentasjon.");
      }

      setMessage("Dokumentasjonen er lagret.");
      await fetchData();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke laste opp dokumentasjonen."
      );
    } finally {
      setUploadingKey(null);
    }
  };

  const linkExistingAsBefore = async (doc: WorkDocumentation) => {
    const targetItemId = Number(linkTarget[doc.id] || 0);
    if (!targetItemId) {
      setError("Velg hvilket utbedringstiltak dokumentasjonen tilhører.");
      return;
    }

    setMessage("");
    setError("");

    try {
      const formData = new FormData();
      formData.append("photo_id", String(doc.id));
      formData.append("inquiry_id", String(inquiryId));
      formData.append("documentation_phase", "1");
      formData.append("work_completion_item_id", String(targetItemId));

      const res = await fetch(apiUrl("/photos.php"), {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke koble dokumentasjonen til tiltaket."
        );
      }

      setMessage("Tidligere dokumentasjon er koblet som fase 1 · Før.");
      await fetchData();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke koble dokumentasjonen."
      );
    }
  };

  const saveCaption = async (doc: WorkDocumentation) => {
    setSavingCaptionId(doc.id);
    setMessage("");
    setError("");

    try {
      const formData = new FormData();
      formData.append("photo_id", String(doc.id));
      formData.append("inquiry_id", String(inquiryId));
      formData.append("caption_text", captionDrafts[doc.id] || "");

      if (doc.documentation_phase) {
        formData.append(
          "documentation_phase",
          String(doc.documentation_phase)
        );
      }

      if (doc.work_completion_item_id) {
        formData.append(
          "work_completion_item_id",
          String(doc.work_completion_item_id)
        );
      }

      if (doc.custom_point_title) {
        formData.append("custom_point_title", doc.custom_point_title);
      }

      const res = await fetch(apiUrl("/photos.php"), {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke lagre kommentaren.");
      }

      setMessage("Kommentaren er lagret.");
      await fetchData();
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Kunne ikke lagre kommentaren."
      );
    } finally {
      setSavingCaptionId(null);
    }
  };

  const addCustomPoint = () => {
    const title = newPointTitle.trim();
    if (!title) return;

    setCustomPoints((current) => [
      ...current,
      {
        key: `local-${Date.now()}`,
        title,
      },
    ]);
    setNewPointTitle("");
  };

  const renderDocuments = (docs: WorkDocumentation[]) => {
    if (docs.length === 0) {
      return (
        <p className="mt-3 text-[9px] text-slate-700">
          Ingen dokumentasjon registrert.
        </p>
      );
    }

    return (
      <div className="mt-3 space-y-2">
        {docs.map((doc) => (
          <div
            key={doc.id}
            className="rounded-xl border border-slate-800 bg-slate-950/60 p-3"
          >
            <div className="flex items-center gap-3">
              {doc.photo_url ? (
                <div className="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-blue-500/20 bg-blue-500/10">
                  <Camera className="h-4 w-4 text-blue-400" />
                </div>
              ) : (
                <div className="grid h-10 w-10 shrink-0 place-items-center rounded-lg border border-violet-500/20 bg-violet-500/10">
                  <FileAudio className="h-4 w-4 text-violet-400" />
                </div>
              )}

              <div className="min-w-0 flex-1">
                <p className="truncate text-[10px] font-black text-slate-300">
                  {doc.photo_url ? "Bilde" : "Lydfil"}
                </p>

                <div className="mt-1 flex flex-wrap gap-2">
                  {doc.photo_url && (
                    <a
                      href={apiAssetUrl(doc.photo_url)}
                      target="_blank"
                      rel="noreferrer"
                      className="text-[9px] font-bold text-blue-400 hover:text-blue-300"
                    >
                      Åpne bilde
                    </a>
                  )}
                  {doc.audio_url && (
                    <a
                      href={apiAssetUrl(doc.audio_url)}
                      target="_blank"
                      rel="noreferrer"
                      className="text-[9px] font-bold text-violet-400 hover:text-violet-300"
                    >
                      Åpne lyd
                    </a>
                  )}
                </div>
              </div>

              <CheckCircle2 className="h-4 w-4 shrink-0 text-emerald-400" />
            </div>

            <div className="mt-3 flex gap-2">
              <input
                value={captionDrafts[doc.id] ?? ""}
                onChange={(event) =>
                  setCaptionDrafts((current) => ({
                    ...current,
                    [doc.id]: event.target.value,
                  }))
                }
                placeholder="Kommentar til dokumentasjonen..."
                className="min-w-0 flex-1 rounded-lg border border-slate-800 bg-[#211410] px-3 py-2 text-[10px] text-white outline-none focus:border-cyan-500/40"
              />
              <button
                type="button"
                onClick={() => saveCaption(doc)}
                disabled={savingCaptionId === doc.id}
                className="grid h-9 w-9 shrink-0 place-items-center rounded-lg border border-slate-700 bg-slate-900 text-slate-300 hover:text-white disabled:opacity-50"
                aria-label="Lagre kommentar"
              >
                {savingCaptionId === doc.id ? (
                  <Loader2 className="h-3.5 w-3.5 animate-spin" />
                ) : (
                  <Save className="h-3.5 w-3.5" />
                )}
              </button>
            </div>
          </div>
        ))}
      </div>
    );
  };

  const renderPhase = ({
    phase,
    docs,
    itemId,
    customTitle,
  }: {
    phase: 1 | 2 | 3;
    docs: WorkDocumentation[];
    itemId?: number;
    customTitle?: string;
