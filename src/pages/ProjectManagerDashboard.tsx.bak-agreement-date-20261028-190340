                  className="w-full rounded-xl border border-slate-800 bg-[#211410] px-4 py-3 text-xs text-white outline-none focus:border-violet-500/40"
                />
              </div>
              <button
                type="button"
                onClick={addCustomPoint}
                disabled={!newPointTitle.trim()}
                className="inline-flex items-center justify-center gap-2 rounded-xl border border-violet-500/30 bg-violet-500/10 px-4 py-3 text-xs font-black text-violet-300 hover:bg-violet-500/15 disabled:opacity-40"
              >
                <Plus className="h-4 w-4" />
                Legg til punkt
              </button>
            </div>
          </section>
        </>
      )}
    </div>
  );
}

