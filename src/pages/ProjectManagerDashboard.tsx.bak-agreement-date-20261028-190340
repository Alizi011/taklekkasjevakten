                  </p>
                </div>

                <div className="rounded-xl border border-slate-800 bg-slate-950 px-3 py-2 text-[10px] font-black text-slate-300">
                  {inquiries.length} oppdrag
                </div>
              </div>

              {teamError && (
                <div className="mt-4 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-xs text-red-300">
                  {teamError}
                </div>
              )}

              {teamMessage && (
                <div className="mt-4 rounded-xl border border-emerald-500/25 bg-emerald-500/10 px-4 py-3 text-xs text-emerald-300">
                  {teamMessage}
                </div>
              )}

              <div className="mt-4 space-y-4">
                {inquiries.map((inquiry) => {
                  const inquiryId = normalizeInquiryId(inquiry.id);
                  const key = inquiryId.toString();
                  const team = teamOverview[key];
                  const schedule = fieldScheduleOverview[key] || null;

                  const eligibleTechnicians = staffEmployees.filter((employee) => {
                    const role = String(employee.role || "").toLowerCase();
                    const status = String(employee.status || "").toLowerCase();

                    return (
                      status === "aktiv" &&
                      ["tekniker", "blikkenslager", "lærling"].includes(role)
                    );
                  });

                  const selectedTechnicianId =
                    teamTechnicianDrafts[key] ??
                    (team?.technician?.employee_id
                      ? String(team.technician.employee_id)
                      : "");

                  const draft = {
                    date:
                      teamScheduleDrafts[key]?.date ??
                      schedule?.schedule_date ??
                      "",
                    startTime:
                      teamScheduleDrafts[key]?.startTime ??
                      (schedule?.start_time
                        ? String(schedule.start_time).substring(0, 5)
                        : "09:00"),
                    endTime:
                      teamScheduleDrafts[key]?.endTime ??
                      (schedule?.end_time
                        ? String(schedule.end_time).substring(0, 5)
                        : ""),
                    comment:
                      teamScheduleDrafts[key]?.comment ??
                      schedule?.comment ??
                      "",
                  };

                  const technicianBusy =
                    teamSavingId === `technician-${inquiryId}`;
                  const scheduleBusy =
                    teamSavingId === `schedule-${inquiryId}`;

                  return (
                    <article
                      key={inquiry.id}
                      className="rounded-2xl border border-slate-800 bg-slate-950/50 p-4"
                    >
                      <div className="flex flex-col gap-3 border-b border-slate-800/80 pb-4 sm:flex-row sm:items-start sm:justify-between">
                        <div className="min-w-0">
                          <div className="flex flex-wrap items-center gap-2">
                            <p className="text-xs font-black text-white">
                              {customerName(inquiry)} · #{inquiry.id}
                            </p>
                            <span className="rounded-lg border border-slate-700 bg-slate-900 px-2 py-1 text-[9px] font-black text-slate-300">
                              {serviceLabel(inquiry.recommended_service)}
                            </span>
                          </div>
                          <p className="mt-1 truncate text-[10px] text-slate-500">
                            {fullAddress(inquiry) || "Adresse ikke oppgitt"}
                          </p>
                        </div>

                        <button
                          type="button"
                          onClick={() => openInquiry(inquiry)}
                          className="inline-flex shrink-0 items-center gap-2 rounded-xl border border-slate-700 bg-slate-900 px-3 py-2 text-[10px] font-black text-slate-300 transition hover:border-amber-500/30 hover:text-white"
                        >
                          Åpne oppdrag
                          <ArrowUpRight className="h-3.5 w-3.5" />
                        </button>
                      </div>

                      <div className="mt-4 grid gap-4 xl:grid-cols-[0.8fr_1.2fr]">
                        <section className="rounded-2xl border border-cyan-500/15 bg-[#211410] p-4">
                          <div className="flex items-center gap-2">
                            <UserCheck className="h-4 w-4 text-cyan-400" />
                            <div>
                              <p className="text-[9px] font-black uppercase tracking-wider text-cyan-400">
                                Bemanning
                              </p>
                              <p className="text-[10px] text-slate-500">
                                Velg utførende tekniker.
                              </p>
                            </div>
                          </div>

                          <div className="mt-4">
                            <label className="mb-1.5 block text-[9px] font-black uppercase tracking-wider text-slate-500">
                              Prosjektansvarlig
                            </label>
                            <div className="rounded-xl border border-slate-800 bg-slate-950 px-3 py-2.5 text-xs font-black text-white">
                              {team?.project_manager?.name ||
                                previewEmployee?.name ||
                                inquiry.assigned_to ||
                                "Ikke tildelt"}
                            </div>
                          </div>

                          <div className="mt-3">
                            <label className="mb-1.5 block text-[9px] font-black uppercase tracking-wider text-slate-500">
                              Tekniker
                            </label>
                            <select
                              value={selectedTechnicianId}
                              onChange={(event) =>
                                setTeamTechnicianDrafts((current) => ({
                                  ...current,
                                  [key]: event.target.value,
                                }))
                              }
                              className="w-full rounded-xl border border-slate-800 bg-slate-950 px-3 py-2.5 text-xs text-white outline-none focus:border-cyan-500/40"
                            >
                              <option value="">Velg tekniker</option>
                              {eligibleTechnicians.map((employee) => (
                                <option
                                  key={employee.id}
                                  value={employee.id}
                                >
                                  {employee.name} · {employee.role}
                                </option>
                              ))}
                            </select>
                          </div>

                          <button
                            type="button"
                            disabled={!selectedTechnicianId || technicianBusy}
                            onClick={() =>
                              assignTechnicianToInquiry(
                                inquiry,
                                Number(selectedTechnicianId)
                              )
                            }
                            className="mt-3 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-cyan-500/10 px-4 py-2.5 text-[10px] font-black text-cyan-300 ring-1 ring-inset ring-cyan-500/25 transition hover:bg-cyan-500/15 disabled:cursor-not-allowed disabled:opacity-40"
                          >
                            {technicianBusy ? (
                              <Loader2 className="h-3.5 w-3.5 animate-spin" />
                            ) : (
                              <UserCheck className="h-3.5 w-3.5" />
                            )}
                            {team?.technician
                              ? "Endre tekniker"
                              : "Tildel tekniker"}
                          </button>
                        </section>

                        <section className="rounded-2xl border border-amber-500/15 bg-[#211410] p-4">
                          <div className="flex items-center gap-2">
                            <CalendarDays className="h-4 w-4 text-amber-400" />
                            <div>
                              <p className="text-[9px] font-black uppercase tracking-wider text-amber-400">
                                Arbeidsordre
                              </p>
                              <p className="text-[10px] text-slate-500">
                                Sett tidspunkt og gi teknikeren nødvendig arbeidsbeskrivelse.
                              </p>
                            </div>
                          </div>

                          <div className="mt-4 grid gap-3 sm:grid-cols-3">
                            <div>
                              <label className="mb-1.5 block text-[9px] font-black uppercase tracking-wider text-slate-500">
                                Dato
                              </label>
                              <input
                                type="date"
                                value={draft.date}
                                onChange={(event) =>
                                  updateTeamScheduleDraft(inquiryId, {
                                    date: event.target.value,
                                  })
                                }
                                className="w-full rounded-xl border border-slate-800 bg-slate-950 px-3 py-2.5 text-xs text-white outline-none focus:border-amber-500/40"
                              />
                            </div>

                            <div>
                              <label className="mb-1.5 block text-[9px] font-black uppercase tracking-wider text-slate-500">
                                Fra
                              </label>
                              <input
                                type="time"
                                value={draft.startTime}
                                onChange={(event) =>
                                  updateTeamScheduleDraft(inquiryId, {
                                    startTime: event.target.value,
                                  })
                                }
                                className="w-full rounded-xl border border-slate-800 bg-slate-950 px-3 py-2.5 text-xs text-white outline-none focus:border-amber-500/40"
                              />
                            </div>

                            <div>
                              <label className="mb-1.5 block text-[9px] font-black uppercase tracking-wider text-slate-500">
                                Til
                              </label>
                              <input
                                type="time"
                                value={draft.endTime}
                                onChange={(event) =>
                                  updateTeamScheduleDraft(inquiryId, {
                                    endTime: event.target.value,
                                  })
                                }
                                className="w-full rounded-xl border border-slate-800 bg-slate-950 px-3 py-2.5 text-xs text-white outline-none focus:border-amber-500/40"
                              />
                            </div>
                          </div>

                          <div className="mt-3">
                            <label className="mb-1.5 block text-[9px] font-black uppercase tracking-wider text-slate-500">
                              Arbeidsbeskrivelse / beskjed til tekniker
                            </label>
                            <textarea
                              rows={3}
                              value={draft.comment}
                              onChange={(event) =>
                                updateTeamScheduleDraft(inquiryId, {
                                  comment: event.target.value,
                                })
                              }
                              placeholder="Beskriv hva som skal utføres, hva som skal kontrolleres og eventuell dokumentasjon som kreves."
                              className="w-full resize-none rounded-xl border border-slate-800 bg-slate-950 px-3 py-2.5 text-xs text-white outline-none focus:border-amber-500/40"
                            />
                          </div>

                          <div className="mt-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                            <p className="text-[10px] text-slate-500">
                              {schedule
                                ? `Tidspunkt: ${formatFieldScheduleDateTime(schedule)}`
                                : "Ingen tidsforslag ennå"}
                            </p>

                            <button
                              type="button"
                              onClick={() => saveTeamSchedule(inquiry)}
                              disabled={scheduleBusy}
                              className="inline-flex items-center justify-center gap-2 rounded-xl bg-[#ff951a] px-4 py-2.5 text-[10px] font-black text-slate-950 transition hover:bg-orange-400 disabled:cursor-not-allowed disabled:opacity-50"
                            >
                              {scheduleBusy ? (
                                <Loader2 className="h-3.5 w-3.5 animate-spin" />
                              ) : (
                                <Save className="h-3.5 w-3.5" />
                              )}
                              {schedule ? "Send nytt tidsforslag" : "Foreslå tidspunkt"}
                            </button>
                          </div>
                        </section>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          </div>
        )}

        {view === "kunder" && (
          <ProjectManagerCustomers
            inquiries={inquiries}
            onOpenInquiry={(inquiryId) => {
              setActiveInquiryId(inquiryId);
              setView("felt");
            }}
          />
        )}

        {view === "meldinger" && (
          <ProjectManagerCommunication
            inquiries={inquiries}
            projectManagerId={
              previewEmployee?.id ? Number(previewEmployee.id) : null
            }
            projectManagerName={previewEmployee?.name || null}
            onUnreadCountChange={setUnreadMessageCount}
            onOpenInquiry={(inquiryId) => {
              setActiveInquiryId(inquiryId);
              setView("felt");
            }}
          />
        )}

        {view === "eiendom" && overviewInquiry && (
          <PropertyAndBuildingCase
            inquiryId={normalizeInquiryId(overviewInquiry.id)}
            customerName={customerName(overviewInquiry)}
            onBack={() => setView("felt")}
          />
        )}

        {view === "eiendom" && !overviewInquiry && !loadingInquiries && (
          <div className="bg-[#211612] border border-slate-800 rounded-3xl p-12 text-center">
            <Building2 className="w-8 h-8 text-slate-700 mx-auto mb-3" />
            <p className="font-bold text-slate-300">
              Ingen aktivt oppdrag er valgt.
            </p>
            <button
              type="button"
              onClick={() => setView("oversikt")}
              className="mt-4 px-4 py-2 bg-[#ff951a] text-slate-950 rounded-xl text-xs font-extrabold"
            >
              Gå til oversikten
            </button>
          </div>
        )}

        {view === "felt" && !overviewInquiry && !loadingInquiries && (
          <div className="bg-[#211612] border border-slate-800 rounded-3xl p-12 text-center">
            <Wrench className="w-8 h-8 text-slate-700 mx-auto mb-3" />
            <p className="font-bold text-slate-300">
              Ingen aktivt oppdrag er valgt.
            </p>
            <button
              type="button"
              onClick={() => setView("oversikt")}
              className="mt-4 px-4 py-2 bg-[#ff951a] text-slate-950 rounded-xl text-xs font-extrabold"
            >
              Gå til oversikten
            </button>
          </div>
        )}
      </main>

      <OfferGenerator
        open={offerGeneratorOpen}
        projectManagerSessionToken={
          onBackToAdmin
            ? null
            : window.localStorage.getItem("taklekkasjevakten_project_manager_session")
        }
        inquiry={overviewInquiry}
        employee={
          previewEmployee
            ? {
                id: previewEmployee.id,
                name: previewEmployee.name,
              }
            : null
        }
        initialService={offerGeneratorService}
        digitalInspectionComment={digitalInspectionComment}
        mode={offerGeneratorMode}
        followUpType={
          offerGeneratorMode === "followup"
            ? offerGeneratorFollowUpType
            : null
        }
        followUpReason={followUpReason}
        sourceReportId={
          offerGeneratorMode === "followup" ? report?.id || null : null
        }
        allowPublish={
          offerGeneratorMode !== "followup" ||
          (report?.status === "publisert" &&
            offerGeneratorFollowUpType !== null)
        }
        onDraftSaved={(offerId) => {
          if (offerGeneratorMode === "followup") {
            setFollowUpOfferPrepared(true);
            setFollowUpOfferDraftId(offerId);
            setPostReportMessage(
              postReportAction === "service"
                ? "Servicegrunnlaget er lagret som internt utkast."
                : "Tilbudsutkastet er lagret og koblet til rapporten."
            );
          }
        }}
        onClose={() => {
          setOfferGeneratorOpen(false);
          if (offerGeneratorMode === "followup") {
            setOfferGeneratorFollowUpType(null);
          }
        }}
        onPublished={async () => {
          if (offerGeneratorMode === "followup") {
            setFollowUpReason("");
            setOfferGeneratorFollowUpType(null);
            if (activeInquiryId) {
              await fetchFollowUpOffer(activeInquiryId);
            }
          } else {
            setDigitalInspectionMessage(
              "Tilbudet er publisert til kunden."
            );
          }
          await fetchInquiries();
          setView("oversikt");
        }}
      />

      {reportSectionEditor && (
        <div
          className="fixed inset-0 z-[120] flex items-center justify-center bg-slate-950/85 p-4 backdrop-blur-sm"
          onMouseDown={(e) => {
            if (e.currentTarget === e.target) setReportSectionEditor(null);
          }}
        >
          <div className="flex max-h-[90vh] w-full max-w-5xl flex-col overflow-hidden rounded-3xl border border-slate-700 bg-[#211410] shadow-2xl">
            <div className="flex items-start justify-between gap-4 border-b border-slate-800 px-5 py-4 md:px-6">
              <div>
                <p className="text-[10px] font-black uppercase tracking-[0.14em] text-amber-400">
                  Rapportredigering
                </p>
                <h3 className="mt-1 text-lg font-black text-white">
                  {reportSectionEditor.heading.replace(/^\d+[\.)]\s*/, "")}
                </h3>
                <p className="mt-1 text-[11px] text-slate-500">
                  {reportLocked
                    ? "Rapporten er låst for redigering. Du kan fortsatt lese hele seksjonen."
                    : "Rediger bare denne delen av rapporten."}
                </p>
              </div>
              <button
                type="button"
                onClick={() => setReportSectionEditor(null)}
                className="rounded-xl border border-slate-700 px-3 py-2 text-xs font-bold text-slate-400 hover:text-white"
              >
                Lukk
              </button>
            </div>

            <div className="grid min-h-0 flex-1 md:grid-cols-2">
              <div className="min-h-0 border-b border-slate-800 p-5 md:border-b-0 md:border-r md:p-6">
                <p className="mb-2 text-[9px] font-black uppercase tracking-wider text-slate-600">
                  Rediger tekst
                </p>
                <textarea
                  value={reportSectionEditor.body}
                  onChange={(e) =>
                    setReportSectionEditor((current) =>
                      current ? { ...current, body: e.target.value } : current
                    )
                  }
                  readOnly={reportLocked}
                  className="h-[55vh] w-full resize-none rounded-2xl border border-slate-800 bg-slate-950 p-4 text-sm leading-6 text-slate-200 outline-none focus:border-amber-500"
                />
              </div>

              <div className="min-h-0 overflow-y-auto bg-slate-100 p-5 text-slate-950 md:p-6">
                <div className="mx-auto min-h-full max-w-[700px] bg-white p-7 shadow-xl">
                  <p className="text-[9px] font-black uppercase tracking-[0.18em] text-amber-600">
                    Forhåndsvisning
                  </p>
                  <h4 className="mt-3 text-xl font-black">
                    {reportSectionEditor.heading.replace(/^\d+[\.)]\s*/, "")}
                  </h4>
                  <div className="mt-5 whitespace-pre-wrap text-sm leading-6 text-slate-700">
                    {reportSectionEditor.body || "Ingen tekst i denne seksjonen."}
                  </div>
                </div>
              </div>
            </div>

            <div className="flex flex-col gap-2 border-t border-slate-800 px-5 py-4 sm:flex-row sm:justify-end md:px-6">
              <button
                type="button"
                onClick={() => setReportSectionEditor(null)}
                className="rounded-xl border border-slate-700 bg-slate-900 px-4 py-2.5 text-xs font-bold text-slate-300"
              >
                Avbryt
              </button>
              {!reportLocked && (
                <button
                  type="button"
                  onClick={persistReportSection}
                  disabled={savingReportSection}
                  className="flex items-center justify-center gap-2 rounded-xl bg-[#ff951a] px-5 py-2.5 text-xs font-black text-slate-950 hover:bg-orange-400 disabled:opacity-50"
                >
                  {savingReportSection ? (
                    <Loader2 className="h-4 w-4 animate-spin" />
                  ) : (
                    <CheckCircle2 className="h-4 w-4" />
                  )}
                  Lagre endringer
                </button>
              )}
            </div>
          </div>
        </div>
      )}

      {pdfPreviewOpen && (
        <div
          className="fixed inset-0 z-[130] flex items-center justify-center bg-slate-950/90 p-3 backdrop-blur-sm md:p-6"
          onMouseDown={(e) => {
            if (e.currentTarget === e.target) setPdfPreviewOpen(false);
          }}
        >
          <div className="flex h-[92vh] w-full max-w-7xl flex-col overflow-hidden rounded-3xl border border-slate-700 bg-[#211410] shadow-2xl">
            <div className="flex items-center justify-between gap-4 border-b border-slate-800 px-5 py-4">
              <div>
                <p className="text-sm font-black text-white">PDF-forhåndsvisning</p>
                <p className="mt-0.5 text-[10px] text-slate-500">
                  Rapport for oppdrag #{activeInquiryId}
                </p>
              </div>
              <div className="flex items-center gap-2">
                <button
                  type="button"
                  onClick={downloadPdf}
                  disabled={!report?.pdf_url}
                  className="flex items-center gap-2 rounded-xl border border-slate-700 px-3 py-2 text-xs font-bold text-slate-300 disabled:opacity-40"
                >
                  <Download className="h-4 w-4" />
                  Last ned
                </button>
                <button
                  type="button"
                  onClick={() => setPdfPreviewOpen(false)}
                  className="rounded-xl border border-slate-700 px-3 py-2 text-xs font-bold text-slate-300 hover:text-white"
                >
                  Lukk
                </button>
              </div>
            </div>

            <div className="min-h-0 flex-1 bg-slate-200">
              {report?.pdf_url ? (
                <iframe
                  src={apiAssetUrl(report.pdf_url)}
                  title="PDF-forhåndsvisning"
                  className="h-full w-full bg-white"
                />
              ) : (
                <div className="h-full overflow-y-auto p-5 md:p-8">
                  <div className="mx-auto min-h-full max-w-[850px] bg-white p-8 text-slate-950 shadow-xl md:p-12">
                    <p className="text-[10px] font-black uppercase tracking-[0.2em] text-amber-600">
                      Perun AS
                    </p>
                    <h4 className="mt-2 text-2xl font-black">Teknisk kontrollrapport</h4>
                    <div className="mt-6 whitespace-pre-wrap text-sm leading-6 text-slate-700">
                      {report?.admin_final || report?.ai_draft || reportDraft}
                    </div>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      {liveInspectionOpen && activeInquiry && (
        <LiveInspectionRoom
          inquiryId={normalizeInquiryId(activeInquiry.id)}
          role="project_manager"
          employeeId={Number(
            previewEmployee?.id ||
              activeInquiry.assigned_project_manager_id ||
              0
          )}
          displayName={customerName(activeInquiry)}
          onClose={() => setLiveInspectionOpen(false)}
        />
      )}
      
    </div>
  );
}


export { InquiryPhotosManager };



