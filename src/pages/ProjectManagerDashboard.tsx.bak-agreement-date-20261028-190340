      setReportDraft(data.report || "");
      setReportMessage("AI-rapportutkastet ble generert og lagret.");
      await fetchReport(activeInquiryId);
    } catch (err) {
      setReportError(
        err instanceof Error
          ? err.message
          : "Kunne ikke generere rapportutkast."
      );
    } finally {
      setGeneratingReport(false);
    }
  };

  const openPdfPreview = async () => {
    if (!activeInquiryId) return;

    setFieldWorkspaceTab("rapport");

    // Publiserte/godkjente rapporter skal kunne leses, men aldri regenereres
    // eller overskrives av prosjektansvarlig.
    if (reportLocked) {
      if (report?.pdf_url || reportReadable) {
        setPdfPreviewOpen(true);
        return;
      }

      setReportError("Rapporten er låst, men ingen forhåndsvisning er tilgjengelig.");
      return;
    }
    setGeneratingPdf(true);
    setReportError("");
    setReportMessage("");

    try {
      let draft = reportDraft.trim();
      let currentReport = report;

      // Hvis rapportutkast ikke finnes ennå, opprettes det automatisk fra feltgrunnlaget.
      if (!draft) {
        const draftRes = await fetch(
          `${API_BASE}/generate_report.php?inquiry_id=${activeInquiryId}`
        );
        const draftData = await draftRes.json();

        if (!draftRes.ok || !draftData.success) {
          throw new Error(
            draftData.message || "Kunne ikke generere rapportutkast."
          );
        }

        draft = String(draftData.report || "").trim();
        setReportDraft(draft);

        const reportRes = await fetch(
          `${API_BASE}/reports.php?inquiry_id=${activeInquiryId}`
        );
        const reportData = await reportRes.json();

        if (!reportRes.ok || !reportData.success) {
          throw new Error(
            reportData.message || "Kunne ikke hente rapportutkastet."
          );
        }

        currentReport = reportData.report || null;
        setReport(currentReport);
      }

      // Sørg for at eventuelle manuelle endringer er lagret før PDF-en genereres.
      if (
        draft &&
        !reportLocked &&
        (!currentReport || String(currentReport.ai_draft || "") !== draft)
      ) {
        const saveRes = await fetch(`${API_BASE}/reports.php`, {
          method: currentReport ? "PUT" : "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            inquiry_id: activeInquiryId,
          session_token: window.localStorage.getItem("taklekkasjevakten_project_manager_session") || "",
            ai_draft: draft,
            status: "utkast",
          }),
        });
        const saveData = await saveRes.json();

        if (!saveRes.ok || !saveData.success) {
          throw new Error(
            saveData.message || "Kunne ikke lagre rapportutkastet før PDF."
          );
        }

        currentReport = saveData.report || currentReport;
        if (saveData.report) setReport(saveData.report);
      }

      const pdfRes = await fetch(`${API_BASE}/generate_report_pdf.php`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ inquiry_id: activeInquiryId, session_token: localStorage.getItem("taklekkasjevakten_project_manager_session") }),
      });
      const pdfData = await pdfRes.json();

      if (!pdfRes.ok || !pdfData.success) {
        throw new Error(
          pdfData.message || "Kunne ikke generere PDF-forhåndsvisning."
        );
      }

      await fetchReport(activeInquiryId);
      setReportMessage("PDF-forhåndsvisningen er klar.");
      setPdfPreviewOpen(true);
    } catch (err) {
      setReportError(
        err instanceof Error
          ? err.message
          : "Kunne ikke åpne PDF-forhåndsvisningen."
      );
    } finally {
      setGeneratingPdf(false);
    }
  };

  const downloadPdf = async () => {
    if (!report?.pdf_url) return;

    const pdfUrl = apiAssetUrl(report.pdf_url);
    const fallbackName = `rapport-oppdrag-${activeInquiryId || "rapport"}.pdf`;
    const fileName =
      report.pdf_url.split("/").pop()?.split("?")[0] || fallbackName;

    setReportError("");
    setReportMessage("");

    try {
      const response = await fetch(pdfUrl);

      if (!response.ok) {
        throw new Error("Kunne ikke hente PDF-filen.");
      }

      const blob = await response.blob();
      const objectUrl = URL.createObjectURL(blob);
      const link = document.createElement("a");

      link.href = objectUrl;
      link.download = fileName;
      document.body.appendChild(link);
      link.click();
      link.remove();

      window.setTimeout(() => URL.revokeObjectURL(objectUrl), 1000);
      setReportMessage("PDF-en er lastet ned.");
    } catch (err) {
      // Dersom serveren blokkerer cross-origin blob-henting,
      // åpnes PDF-en direkte slik at brukeren fortsatt kan lagre den.
      window.open(pdfUrl, "_blank", "noopener,noreferrer");
      setReportMessage(
        "PDF-en ble åpnet i en ny fane. Bruk nettleserens nedlastingsknapp dersom automatisk nedlasting ble blokkert."
      );
    }
  };

  const saveDraft = async () => {
    if (!activeInquiryId || !reportDraft.trim()) return;

    setSavingReport(true);
    setReportError("");
    setReportMessage("");

    try {
      const method = report ? "PUT" : "POST";

      const res = await fetch(`${API_BASE}/reports.php`, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: activeInquiryId,
          session_token: window.localStorage.getItem("taklekkasjevakten_project_manager_session") || "",
          ai_draft: reportDraft,
          status: "utkast",
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke lagre rapportutkast.");
      }

      setReport(data.report);
      setReportOverview((prev) => ({
        ...prev,
        [activeInquiryId.toString()]: data.report || null,
      }));
      setReportDraft(data.report?.ai_draft || reportDraft);
      setReportMessage("Rapportutkastet er lagret.");
    } catch (err) {
      setReportError(
        err instanceof Error ? err.message : "Kunne ikke lagre utkast."
      );
    } finally {
      setSavingReport(false);
    }
  };

  const sendToAdmin = async () => {
    if (!activeInquiryId || !report || !reportDraft.trim()) return;

    setReportError("");
    setPostReportError("");

    if (!postReportAction) {
      setPostReportError(
        "Velg videre anbefaling før rapporten sendes til admin."
      );
      setFieldWorkspaceTab("rapport");
      return;
    }

    const recommendationReason =
      followUpReason.trim() ||
      extractFollowUpReasonFromReport({
        ...report,
        ai_draft: reportDraft,
      });

    if (!recommendationReason.trim()) {
      setPostReportError(
        "Faglig begrunnelse for videre anbefaling mangler. Hent den fra rapporten eller skriv den inn."
      );
      return;
    }

    if (
      (postReportAction === "service" ||
        postReportAction === "varig_utbedring") &&
      !followUpOfferPrepared
    ) {
      setPostReportError(
        postReportAction === "service"
          ? "Lagre servicegrunnlaget på timesats før rapporten sendes inn."
          : "Opprett og lagre tilbudsutkastet for varig utbedring før rapporten sendes inn."
      );
      return;
    }

    const reportWithRecommendation = upsertReportRecommendation(
      reportDraft,
      postReportAction,
      maintenanceInterval,
      recommendationReason,
      checklistDeviations
    );

    const confirmed = window.confirm(
      "Sende rapporten med videre anbefaling til admin? Rapporten låses inntil den eventuelt returneres for korrigering."
    );

    if (!confirmed) return;

    setSendingReport(true);
    setReportError("");
    setReportMessage("");

    try {
      // Lagre siste redigering samtidig som status endres.
      const res = await fetch(`${API_BASE}/reports.php`, {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: activeInquiryId,
          session_token: window.localStorage.getItem("taklekkasjevakten_project_manager_session") || "",
          ai_draft: reportWithRecommendation,
          status: "sendt_til_admin",
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke sende rapporten til admin.");
      }

      setReport(data.report);
      setReportOverview((prev) => ({
        ...prev,
        [activeInquiryId.toString()]: data.report || null,
      }));
      setReportDraft(data.report?.ai_draft || reportDraft);
      setReportMessage(
        report.status === "returnert_til_prosjektansvarlig"
          ? "Den korrigerte rapporten er sendt tilbake til admin."
          : "Rapportutkastet er sendt til admin for kvalitetssikring."
      );
    } catch (err) {
      setReportError(
        err instanceof Error
          ? err.message
          : "Kunne ikke sende rapporten til admin."
      );
    } finally {
      setSendingReport(false);
    }
  };

  const saveMaintenanceFollowUp = async () => {
    if (!activeInquiryId || postReportAction !== "vedlikeholdskontroll") return;

    const reason =
      followUpReason.trim() ||
      extractFollowUpReasonFromReport(report);

    if (!reason.trim()) {
      setPostReportError(
        "Faglig begrunnelse mangler. Hent den fra rapporten eller skriv den inn før du lagrer."
      );
      return;
    }

    // Foreslå konkret kontrolltid ut fra valgt intervall.
    // Vi bruker lokal dato for å unngå at UTC-konvertering flytter dagen.
    const target = new Date();
    const originalDay = target.getDate();
    target.setDate(1);
    target.setMonth(target.getMonth() + maintenanceInterval);
    const lastDayInTargetMonth = new Date(
      target.getFullYear(),
      target.getMonth() + 1,
      0
    ).getDate();
    target.setDate(Math.min(originalDay, lastDayInTargetMonth));

    const pad = (value: number) => String(value).padStart(2, "0");
    const scheduleDate = `${target.getFullYear()}-${pad(
      target.getMonth() + 1
    )}-${pad(target.getDate())}`;
    const startTime = "09:00";

    const confirmed = window.confirm(
      `Publisere forslag om vedlikeholdskontroll ${
        maintenanceInterval === 12
          ? "om 1 år"
          : `om ${maintenanceInterval} måneder`
      } – ${scheduleDate} kl. ${startTime}?`
    );

    if (!confirmed) return;

    setSavingMaintenanceFollowUp(true);
    setPostReportError("");
    setPostReportMessage("");

    try {
      const res = await fetch(apiUrl("/field_schedule.php"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: activeInquiryId,
          service: "takkontroll",
          mode: "followup_proposal",
          schedule_date: scheduleDate,
          start_time: startTime,
          proposed_by_employee_id: previewEmployee?.id
            ? Number(previewEmployee.id)
            : activeInquiry?.assigned_project_manager_id
            ? Number(activeInquiry.assigned_project_manager_id)
            : null,
          proposed_by_name:
            previewEmployee?.name ||
            (activeInquiryId
              ? teamOverview[activeInquiryId.toString()]?.project_manager?.name
              : null) ||
            activeInquiry?.assigned_to ||
            null,
          comment: reason,
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke publisere vedlikeholdsforslaget."
        );
      }

      setFollowUpReason(reason);
      setPostReportMessage(
        `Vedlikeholdskontroll er foreslått ${scheduleDate} kl. ${startTime}. Kunden kan bekrefte, foreslå annet tidspunkt eller si nei.`
      );

      await fetchInquiries();
    } catch (err) {
      setPostReportError(
        err instanceof Error
          ? err.message
          : "Kunne ikke publisere vedlikeholdsforslaget."
      );
    } finally {
      setSavingMaintenanceFollowUp(false);
    }
  };

  const reportLocked =
    report?.status === "sendt_til_admin" ||
    report?.status === "under_gjennomgang" ||
    report?.status === "godkjent" ||
    report?.status === "publisert";

  const reportReadable = Boolean(
    reportDraft.trim() ||
      report?.ai_draft ||
      report?.admin_final ||
      report?.pdf_url
  );

  const reportPublished = report?.status === "publisert";

  // Den opprinnelige feltbookingen er ikke lenger neste handling når
  // lekkasjesøket er utført og rapportprosessen har begynt.
  // Ikke bruk passert dato alene: en avtale kan være utsatt eller ikke utført.
  const initialFieldworkFinished = Boolean(
    ["sendt_til_admin", "under_gjennomgang", "godkjent", "publisert"].includes(report?.status || "") ||
    String(report?.ai_draft || "").trim() ||
    String(report?.admin_final || "").trim() ||
    workCompletionSnapshot?.status === "arbeid_ferdig"
  );

  const followUpOfferStatus = String(followUpOffer?.status || "").toLowerCase();
  const followUpAccepted = followUpOfferStatus === "akseptert";
  const followUpWaitingForCustomer = [
    "publisert",
    "sendt",
    "sendt_til_kunde",
    "tilbud_sendt",
  ].includes(followUpOfferStatus);
  const followUpRejected = ["avvist", "tilbud_avvist"].includes(
    followUpOfferStatus
  );

  const scheduledFollowUpConfirmed = Boolean(
    reportPublished &&
      fieldSchedule?.id &&
      fieldSchedule?.schedule_date &&
      ["planlagt", "bekreftet", "låst", "locked", "akseptert"].includes(
        String(fieldSchedule.status || "").toLowerCase()
      )
  );

  // Arbeid etter Rapport 1 åpnes først når kunden har akseptert
  // oppfølgingstilbudet. En allerede bekreftet feltavtale er også et sterkt
  // signal om at akseptflyten er fullført.
  const followUpWorkAuthorized =
    !reportPublished || followUpAccepted || scheduledFollowUpConfirmed;

  // Ikke tilby prosjektansvarlig å velge oppfølging på nytt når kunden
  // allerede har et aktivt eller akseptert oppfølgingstilbud.
  const canManagePostReportAction =
    (!reportLocked || reportPublished) &&
    (!reportPublished ||
      !followUpOffer ||
      followUpRejected ||
      followUpOfferStatus === "utkast");

  const parsedReportSections = useMemo(() => {
    const source = String(
      reportLocked
        ? report?.admin_final || report?.ai_draft || reportDraft
        : reportDraft
    )
      .replace(/\r\n/g, "\n")
      .trim();
    if (!source) return [] as Array<{ heading: string; body: string }>;

    const headingRegex = /^\s*\d+[\.)]\s+.+$/gm;
    const matches = Array.from(source.matchAll(headingRegex));

    if (matches.length === 0) {
      return [{ heading: "Rapportinnhold", body: source }];
    }

    return matches.map((match, index) => {
      const start = match.index || 0;
      const heading = match[0].trim();
      const bodyStart = start + match[0].length;
      const nextStart =
        index + 1 < matches.length
          ? matches[index + 1].index || source.length
          : source.length;

      return {
        heading,
        body: source.slice(bodyStart, nextStart).trim(),
      };
    });
  }, [reportDraft, reportLocked, report?.admin_final, report?.ai_draft]);

  const persistReportSection = async () => {
    if (!reportSectionEditor || !activeInquiryId || reportLocked) return;

    const nextSections = parsedReportSections.map((section, index) =>
      index === reportSectionEditor.index
        ? {
            heading: reportSectionEditor.heading,
            body: reportSectionEditor.body,
          }
        : section
    );

    const nextDraft = nextSections
      .map((section) =>
        [section.heading.trim(), section.body.trim()].filter(Boolean).join("\n")
      )
      .join("\n\n")
      .trim();

    setSavingReportSection(true);
    setReportError("");

    try {
      const method = report ? "PUT" : "POST";
      const res = await fetch(`${API_BASE}/reports.php`, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: activeInquiryId,
          session_token: window.localStorage.getItem("taklekkasjevakten_project_manager_session") || "",
          ai_draft: nextDraft,
          status: "utkast",
        }),
      });

      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke lagre rapportseksjonen.");
      }

      setReportDraft(data.report?.ai_draft || nextDraft);
      if (data.report) {
        setReport(data.report);
        setReportOverview((prev) => ({
          ...prev,
          [activeInquiryId.toString()]: data.report,
        }));
      }

      setReportSectionEditor(null);
      setReportMessage("Rapportseksjonen er lagret.");
    } catch (err) {
      setReportError(
        err instanceof Error ? err.message : "Kunne ikke lagre rapportseksjonen."
      );
    } finally {
      setSavingReportSection(false);
    }
  };

  const checklistDone = checklistRows.filter(
    (item) => Boolean(item.status)
  ).length;

  const checklistDeviations = checklistRows.filter((item) =>
    ["tg1", "tg2", "tg3"].includes((item.status || "").toLowerCase())
  ).length;

  const checklistStatusCounts = {
    tg0: checklistRows.filter((item) => (item.status || "").toLowerCase() === "tg0").length,
    tg1: checklistRows.filter((item) => (item.status || "").toLowerCase() === "tg1").length,
    tg2: checklistRows.filter((item) => (item.status || "").toLowerCase() === "tg2").length,
    tg3: checklistRows.filter((item) => (item.status || "").toLowerCase() === "tg3").length,
    notApplicable: checklistRows.filter(
      (item) => (item.status || "").toLowerCase() === "ikke_aktuell"
    ).length,
  };

  const checklistTotal = checklistRows.length;
  const checklistRemaining = Math.max(checklistTotal - checklistDone, 0);
  const checklistComplete = checklistTotal > 0 && checklistRemaining === 0;

  useEffect(() => {
    if (
      checklistComplete &&
      checklistDeviations === 0 &&
      !reportLocked &&
      !postReportAction
    ) {
      setPostReportAction("vedlikeholdskontroll");
      setMaintenanceInterval(12);
    }
  }, [
    checklistComplete,
    checklistDeviations,
    reportLocked,
    postReportAction,
  ]);

  const isDigitalInspection = activeInquiry
    ? isPureDigitalWorkflow(activeInquiry)
    : false;
  const reportReturned =
    report?.status === "returnert_til_prosjektansvarlig";
  const overviewInquiry = activeInquiry;
  const overviewInquiryStatus = overviewInquiry
    ? effectiveWorkflowStatus(overviewInquiry)
    : "";

  const overviewStandardService = standardServiceForInquiry(overviewInquiry);
  const overviewStandardTemplate = getStandardServiceOfferTemplate(
    overviewStandardService
  );

  return (
    <div className="min-h-screen bg-[radial-gradient(ellipse_at_75%_0%,#4a210f_0%,#24140f_43%,#170f0d_100%)] text-white font-sans">
      <aside
        className={`hidden lg:flex fixed inset-y-0 left-0 z-50 bg-[linear-gradient(180deg,#26150f_0%,#1a100e_100%)] border-r border-orange-900/40 flex-col transition-[width] duration-300 ${
          sidebarCollapsed ? "w-[76px]" : "w-[238px]"
        }`}
      >
        <div
          className={`h-[86px] flex items-center border-b border-slate-800/80 transition-all duration-300 ${
            sidebarCollapsed ? "px-3 justify-center" : "px-5 gap-3"
          }`}
        >
          <div
            className={`flex items-center justify-center overflow-hidden transition-all duration-300 ${
              sidebarCollapsed ? "w-12" : "w-[174px]"
            }`}
          >
            <img
              src="/logo.png"
              alt="Taklekkasjevakten – Perun AS"
              className={`w-full h-auto object-contain transition-all duration-300 ${
                sidebarCollapsed ? "max-h-11" : "max-h-[62px]"
              }`}
            />
          </div>

          <button
            type="button"
            onClick={() => setSidebarCollapsed((current) => !current)}
            className={`absolute top-[29px] -right-3 w-7 h-7 rounded-full border border-slate-700 bg-[#291915] text-slate-300 hover:text-white hover:border-amber-500/50 hover:bg-slate-900 flex items-center justify-center shadow-lg transition-colors ${
              sidebarCollapsed ? "rotate-180" : ""
            }`}
            title={sidebarCollapsed ? "Åpne meny" : "Lukk meny"}
            aria-label={sidebarCollapsed ? "Åpne meny" : "Lukk meny"}
          >
            <ChevronLeft className="w-3.5 h-3.5" />
          </button>
        </div>

        <nav className={`py-4 space-y-1.5 ${sidebarCollapsed ? "px-2" : "px-3"}`}>
          <button type="button" onClick={() => { setView("oversikt"); setOverviewDisplay("liste"); }} className={`w-full flex items-center px-3 py-3 rounded-xl text-sm font-extrabold transition-colors ${sidebarCollapsed ? "justify-center" : "gap-3"} ${view === "oversikt" && overviewDisplay === "liste" ? "bg-orange-500/20 text-orange-300 border border-orange-500/30" : "text-slate-200 hover:text-white hover:bg-slate-900/70"}`}>
            <Briefcase className="w-4 h-4 shrink-0" />{!sidebarCollapsed && <span>Oppdrag</span>}
          </button>
          <button type="button" onClick={() => { setView("oversikt"); setOverviewDisplay("kalender"); }} className={`w-full flex items-center px-3 py-3 rounded-xl text-sm font-bold transition-colors ${sidebarCollapsed ? "justify-center" : "gap-3"} ${view === "oversikt" && overviewDisplay === "kalender" ? "bg-orange-500/20 text-orange-300" : "text-slate-200 hover:text-white hover:bg-slate-900/70"}`}>
            <CalendarDays className="w-4 h-4 shrink-0" />{!sidebarCollapsed && <span>Kalender</span>}
          </button>
          <button
            type="button"
            onClick={() => setView("kunder")}
            className={`w-full flex items-center px-3 py-3 rounded-xl text-sm font-bold transition-colors ${
              sidebarCollapsed ? "justify-center" : "gap-3"
            } ${
              view === "kunder"
                ? "bg-orange-500/20 text-orange-300 border border-orange-500/30"
                : "text-slate-300 hover:text-slate-300 hover:bg-slate-900/50"
            }`}
          >
            <Users className="w-4 h-4 shrink-0" />
            {!sidebarCollapsed && <span>Kunder</span>}
          </button>
          <button
            type="button"
            onClick={() => setView("rapporter")}
            className={`w-full flex items-center px-3 py-3 rounded-xl text-sm font-bold transition-colors ${sidebarCollapsed ? "justify-center" : "gap-3"} ${view === "rapporter" ? "bg-orange-500/20 text-orange-300 border border-orange-500/30" : "text-slate-300 hover:text-slate-300 hover:bg-slate-900/50"}`}
          >
            <FileText className="w-4 h-4 shrink-0" />{!sidebarCollapsed && <span>Rapporter</span>}
            {approvalQueue.length > 0 && (
              <span className="ml-auto inline-flex min-w-5 items-center justify-center rounded-full bg-amber-400 px-1.5 py-0.5 text-[11px] font-black text-slate-950">
                {approvalQueue.length}
              </span>
            )}
          </button>
          <button
            type="button"
            onClick={() => setView("sjekklister")}
            className={`w-full flex items-center px-3 py-3 rounded-xl text-sm font-bold transition-colors ${sidebarCollapsed ? "justify-center" : "gap-3"} ${view === "sjekklister" ? "bg-orange-500/20 text-orange-300 border border-orange-500/30" : "text-slate-300 hover:text-slate-300 hover:bg-slate-900/50"}`}
          >
