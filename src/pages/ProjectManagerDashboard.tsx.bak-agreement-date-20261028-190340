  const generateDigitalInspectionSlotDrafts = (
    count: number = 4
  ): DigitalSlotDraft[] => {
    const result: DigitalSlotDraft[] = [];
    const cursor = new Date();
    cursor.setHours(12, 0, 0, 0);

    // Digital befaring: tirsdag og fredag kl. 09:00.
    // Vi starter fra neste kalenderdag slik at prosjektansvarlig alltid
    // foreslår fremtidige tidspunkt.
    cursor.setDate(cursor.getDate() + 1);

    while (result.length < count) {
      const day = cursor.getDay();

      if (day === 2 || day === 5) {
        const year = cursor.getFullYear();
        const month = String(cursor.getMonth() + 1).padStart(2, "0");
        const date = String(cursor.getDate()).padStart(2, "0");

        result.push({
          date: `${year}-${month}-${date}`,
          start_time: "09:00",
          end_time: "09:30",
          note: "",
        });
      }

      cursor.setDate(cursor.getDate() + 1);
    }

    return result;
  };

