type MaintenanceInterval = 3 | 6 | 9 | 12;

function postReportActionLabel(
  action: PostReportAction,
  interval: MaintenanceInterval
): string {
  if (action === "service") return "Service på timesats";
  if (action === "varig_utbedring") return "Varig utbedring – nytt pristilbud";
  return `Vedlikeholdskontroll om ${interval === 12 ? "1 år" : `${interval} måneder`}`;
}

function upsertReportRecommendation(
  source: string,
  action: PostReportAction,
  interval: MaintenanceInterval,
  reason: string,
  deviationCount: number
): string {
  const cleaned = String(source || "")
    .replace(
      /\n{2,}VIDERE ANBEFALING TIL KUNDE\n[\s\S]*?\nSLUTT VIDERE ANBEFALING\s*$/i,
      ""
    )
    .trim();

  const recommendation = [
    "VIDERE ANBEFALING TIL KUNDE",
    `Tekniske mangler registrert: ${deviationCount}`,
    `Anbefalt tiltak: ${postReportActionLabel(action, interval)}`,
    "",
    "Faglig begrunnelse:",
    reason.trim(),
    "SLUTT VIDERE ANBEFALING",
  ].join("\n");

  return `${cleaned}\n\n${recommendation}`.trim();
}

const NORWEGIAN_MONTHS: Record<string, number> = {
  januar: 0,
  februar: 1,
  mars: 2,
  april: 3,
  mai: 4,
  juni: 5,
  juli: 6,
  august: 7,
  september: 8,
  oktober: 9,
  november: 10,
  desember: 11,
};

function parseInquiryBooking(inquiry: Inquiry): Date | null {
  if (inquiry.booking_date) {
    const time = String(inquiry.booking_time || "00:00").substring(0, 5);
    const [year, month, day] = inquiry.booking_date.split("-").map(Number);
    const [hour, minute] = time.split(":").map(Number);

    if (year && month && day) {
      return new Date(year, month - 1, day, hour || 0, minute || 0);
    }
  }

  const notes = inquiry.notes || "";

  // 1) DD.MM.YYYY (HH:MM), evt. med norsk ukedag foran.
  const dotted = notes.match(
    /Valgt dato\/tid:\s*(?:mandag|tirsdag|onsdag|torsdag|fredag|lørdag|søndag)?\s*(\d{1,2})\.(\d{1,2})\.(\d{4})\s*\((\d{1,2}):(\d{2})\)/i
  );

  if (dotted) {
    return new Date(
      Number(dotted[3]),
      Number(dotted[2]) - 1,
      Number(dotted[1]),
      Number(dotted[4]),
      Number(dotted[5])
    );
  }

  // 2) YYYY-MM-DD (HH:MM), brukt ved booking fra kundeportalen.
  const iso = notes.match(
    /Valgt dato\/tid:\s*(\d{4})-(\d{2})-(\d{2})\s*\((\d{1,2}):(\d{2})\)/i
  );

  if (iso) {
    return new Date(
      Number(iso[1]),
      Number(iso[2]) - 1,
      Number(iso[3]),
      Number(iso[4]),
      Number(iso[5])
    );
  }

  // 3) Eksempel: "15. august 2026 (11:00)"
  const written = notes.match(
    /Valgt dato\/tid:\s*(?:mandag|tirsdag|onsdag|torsdag|fredag|lørdag|søndag)?\s*(\d{1,2})\.?\s+([a-zæøå]+)\s+(\d{4})\s*\((\d{1,2}):(\d{2})\)/i
  );

  if (written) {
    const month = NORWEGIAN_MONTHS[written[2].toLowerCase()];
    if (month !== undefined) {
      return new Date(
        Number(written[3]),
        month,
        Number(written[1]),
        Number(written[4]),
        Number(written[5])
      );
    }
  }

  return null;
}

function formatBooking(date: Date | null): string {
  if (!date) return "Ikke satt";

  return new Intl.DateTimeFormat("nb-NO", {
    weekday: "short",
    day: "2-digit",
    month: "2-digit",
    year: "2-digit",
    hour: "2-digit",
    minute: "2-digit",
  }).format(date);
}

function sameDay(a: Date, b: Date): boolean {
  return (
    a.getFullYear() === b.getFullYear() &&
    a.getMonth() === b.getMonth() &&
    a.getDate() === b.getDate()
  );
}

function startOfWeek(date: Date): Date {
  const d = new Date(date);
  const day = d.getDay() || 7;
  d.setDate(d.getDate() - day + 1);
  d.setHours(0, 0, 0, 0);
  return d;
}

