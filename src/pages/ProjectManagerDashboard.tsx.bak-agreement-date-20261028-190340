      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke hente automatiske tidsforslag."
        );
      }

      const slots: BookingSlot[] = Array.isArray(data.slots)
        ? data.slots
            .filter(
