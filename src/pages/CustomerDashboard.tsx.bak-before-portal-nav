                        (item) =>
                          item.status === "akseptert" ||
                          item.status === "avvist"
                      )
                      .map((item) => {
                        const isAccepted = item.status === "akseptert";

                        return (
                          <div
                            key={item.id}
                            className={`rounded-2xl border px-4 md:px-5 py-4 ${
                              isAccepted
                                ? "border-emerald-500/20 bg-emerald-500/[0.045]"
                                : "border-slate-800 bg-slate-950/45"
                            }`}
