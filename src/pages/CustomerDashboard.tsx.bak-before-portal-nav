            .meta { color:#64748b; margin-bottom:28px; font-size:12px; }
            .row { padding:12px 0; border-bottom:1px solid #e5e7eb; }
            .label { font-size:11px; font-weight:700; text-transform:uppercase; color:#64748b; margin-bottom:4px; }
            .value { white-space:pre-wrap; font-size:13px; }
            h2 { margin-top:28px; font-size:16px; }
            li { margin:6px 0; font-size:12px; }
            .footer { margin-top:36px; color:#64748b; font-size:10px; }
            @media print { body { margin:20mm; } }
          </style>
        </head>
        <body>
          <h1>Innsendte opplysninger</h1>
          <div class="meta">
            Sak #${safe(inq.id)} · ${safe(inq.customer_name || "")}<br/>
