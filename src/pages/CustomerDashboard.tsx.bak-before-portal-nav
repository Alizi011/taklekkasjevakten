  const respondToFollowup = async (
    action:
      | "customer_confirm"
      | "customer_propose_time"
      | "customer_defer"
      | "customer_decline"
      | "customer_reopen"
  ) => {
    if (!followupSchedule?.id || !inquiryData?.inquiry?.id) return;

    if (
      (action === "customer_propose_time" || action === "customer_reopen") &&
      (!followupDate || !followupTime)
    ) {
      setFollowupError("Velg dato og tidspunkt først.");
      return;
    }

    setUpdatingFollowup(true);
    setFollowupError("");
    setFollowupMessage("");

    try {
      const payload: Record<string, unknown> = {
        id: followupSchedule.id,
        inquiry_id: inquiryData.inquiry.id,
        action,
      };

      // Ved bekreftelse godtar kunden prosjektlederens eksisterende tidspunkt.
      // Dato/tid sendes bare når kunden foreslår et annet tidspunkt.
      if (action === "customer_propose_time" || action === "customer_reopen") {
        payload.schedule_date = followupDate;
        payload.start_time = followupTime;
      }

      const res = await fetch(apiUrl("/field_schedule.php"), {
        method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke oppdatere oppfølgingen.");
      }

      setShowCustomerTimeProposal(false);
      setFollowupMessage(data.message || "Oppfølgingen er oppdatert.");
