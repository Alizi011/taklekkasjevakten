            : "Oppdraget er godkjent. Vi varsler deg når tidspunktet er klart for bekreftelse."
          : "Vi har registrert at du ikke ønsker å gå videre med dette oppdraget."
      );

      setOfferTermsConfirmed(false);

      // Hent hele tilbudslisten på nytt. Dette er viktig når en sak har flere tilbud.
      await fetchOffer(inquiryData.inquiry.id);
      await fetchCustomerData(inquiryData.inquiry.id);
    } catch (err) {
      setOfferError(
        err instanceof Error ? err.message : "Kunne ikke oppdatere tilbudet."
      );
    } finally {
      setUpdatingOffer(false);
    }
  };

