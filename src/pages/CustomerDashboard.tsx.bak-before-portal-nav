          ))}
        </div>
      )}
    </div>
  );
}


type DigitalReportSection = {
  number: string;
  title: string;
  body: string;
};

function parseDigitalReport(text?: string | null): DigitalReportSection[] {
  const source = String(text || "").replace(/\r\n/g, "\n").trim();
  if (!source) return [];

  const headingRegex = /(?:^|\n)\s*(\d+)\.\s+([^\n]+)\n?/g;
  const matches = [...source.matchAll(headingRegex)];

  if (matches.length === 0) {
    return [
      {
        number: "1",
        title: "Rapport",
        body: source,
      },
    ];
  }

  return matches.map((match, index) => {
    const start = (match.index || 0) + match[0].length;
    const end =
      index + 1 < matches.length
        ? matches[index + 1].index || source.length
        : source.length;

    return {
      number: match[1],
      title: match[2].trim(),
      body: source.slice(start, end).trim(),
    };
  });
}

function DigitalReportBody({ body }: { body: string }) {
  const lines = body.split("\n");

  return (
    <div className="space-y-2.5">
      {lines.map((line, index) => {
        const value = line.trim();

        if (!value) {
          return <div key={`space-${index}`} className="h-1" />;
        }

        if (value.startsWith("- ")) {
          return (
            <div
              key={`bullet-${index}`}
              className="flex items-start gap-2.5 text-xs md:text-[13px] leading-6 text-slate-300"
            >
              <span className="mt-[9px] h-1.5 w-1.5 rounded-full bg-amber-400 shrink-0" />
              <span>{value.slice(2)}</span>
            </div>
          );
        }

        return (
          <p
            key={`text-${index}`}
            className="text-xs md:text-[13px] leading-6 text-slate-300"
          >
            {value}
          </p>
        );
      })}
    </div>
  );
}

const CUSTOMER_PORTAL_SESSION_STORAGE_KEY = "taklekkasjevakten_customer_session";

export default function CustomerDashboard({
  onBackToMain,
  previewInquiryId,
  previewMode = false,
}: CustomerDashboardProps) {
  const [showSubmittedSummary, setShowSubmittedSummary] = useState(false);
  const [serviceSlide, setServiceSlide] = useState(0);
  const [expandedProcessStep, setExpandedProcessStep] = useState<number | null>(null);
  const [liveInspectionOpen, setLiveInspectionOpen] = useState(false);
  const [emailOrPhone, setEmailOrPhone] = useState("");
  const [accessCode, setAccessCode] = useState("");
  const [isLoggedIn, setIsLoggedIn] = useState(false);
  const [loading, setLoading] = useState(false);
  const [tokenLoginLoading, setTokenLoginLoading] = useState(() => {
    if (previewMode || typeof window === "undefined") return false;

    const magicToken = new URLSearchParams(window.location.search).get("t");
    const savedSession = window.localStorage.getItem(
      CUSTOMER_PORTAL_SESSION_STORAGE_KEY
    );

    return Boolean(magicToken || savedSession);
  });
  const [tokenLoginError, setTokenLoginError] = useState("");
  const [inquiryData, setInquiryData] = useState<any>(null);
  const [verificationSent, setVerificationSent] = useState(false);
  const [verificationId, setVerificationId] = useState("");
  const [verificationInquiryId, setVerificationInquiryId] = useState<number | null>(null);

  const [bookingSuccess, setBookingSuccess] = useState(false);
  const [offer, setOffer] = useState<CustomerOffer | null>(null);
  const [offers, setOffers] = useState<CustomerOffer[]>([]);
  const [expandedOfferId, setExpandedOfferId] = useState<number | null>(null);
  const [reportExpanded, setReportExpanded] = useState(false);
  const [completionReportExpanded, setCompletionReportExpanded] = useState(false);
  const [completionReport, setCompletionReport] =
    useState<PublishedCompletionReport | null>(null);
  const [propertyImage, setPropertyImage] =
    useState<PropertyImageData | null>(null);
  const [customerPortalView, setCustomerPortalView] = useState<"overview" | "messages">("overview");
  const [showPreinspectionForm, setShowPreinspectionForm] = useState(false);
  const [customerUnreadMessages, setCustomerUnreadMessages] = useState(0);
  const [loadingOffer, setLoadingOffer] = useState(false);
  const [updatingOffer, setUpdatingOffer] = useState(false);
  const [offerError, setOfferError] = useState("");
  const [offerMessage, setOfferMessage] = useState("");
  const [offerTermsConfirmed, setOfferTermsConfirmed] = useState(false);
  const [digitalSlots, setDigitalSlots] = useState<DigitalInspectionSlot[]>([]);
  const [loadingDigitalSlots, setLoadingDigitalSlots] = useState(false);
  const [selectingDigitalSlot, setSelectingDigitalSlot] = useState(false);
  const [digitalSlotError, setDigitalSlotError] = useState("");
  const [selectedDigitalSlotId, setSelectedDigitalSlotId] = useState<number | null>(null);

  const [followupSchedule, setFollowupSchedule] = useState<FollowupSchedule | null>(null);
  const [loadingFollowup, setLoadingFollowup] = useState(false);
  const [updatingFollowup, setUpdatingFollowup] = useState(false);
  const [followupError, setFollowupError] = useState("");
  const [followupMessage, setFollowupMessage] = useState("");
  const [followupDate, setFollowupDate] = useState("");
  const [followupTime, setFollowupTime] = useState("");
  const [showCustomerTimeProposal, setShowCustomerTimeProposal] = useState(false);

  const [preinspection, setPreinspection] = useState<PreinspectionData | null>(null);
  const [preinspectionFiles, setPreinspectionFiles] = useState<PreinspectionFile[]>([]);
  const [loadingPreinspection, setLoadingPreinspection] = useState(false);
  const [savingPreinspection, setSavingPreinspection] = useState(false);
  const [uploadingCategory, setUploadingCategory] = useState<string | null>(null);
  const [preinspectionMessage, setPreinspectionMessage] = useState("");
  const [preinspectionError, setPreinspectionError] = useState("");

  const [problemDescription, setProblemDescription] = useState("");
  const [problemStartedDate, setProblemStartedDate] = useState("");
  const [problemDiscoveredDate, setProblemDiscoveredDate] = useState("");

  const [insuranceCase, setInsuranceCase] = useState<YesNoValue>("");
  const [insuranceDetails, setInsuranceDetails] = useState("");

  const [otherCompaniesInvolved, setOtherCompaniesInvolved] =
    useState<YesNoValue>("");
  const [otherCompaniesDetails, setOtherCompaniesDetails] = useState("");

  const [workSinceTakeover, setWorkSinceTakeover] = useState<YesNoValue>("");
  const [workDescription, setWorkDescription] = useState("");
  const [workPerformedByProfessionals, setWorkPerformedByProfessionals] =
    useState<YesNoValue>("");
  const [selfPerformedWork, setSelfPerformedWork] =
    useState<YesNoValue>("");

  const [buildingApplication, setBuildingApplication] =
    useState<YesNoValue>("");
  const [buildingApplicationDetails, setBuildingApplicationDetails] =
    useState("");

  const [lastMaintenanceDate, setLastMaintenanceDate] = useState("");
  const [lastMaintenanceDetails, setLastMaintenanceDetails] = useState("");
  const [additionalInformation, setAdditionalInformation] = useState("");

  const handleRequestCode = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!emailOrPhone.trim()) return;

    setLoading(true);

    try {
      const res = await fetch(apiUrl("/customer_portal.php"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "request_code",
          email: emailOrPhone.trim(),
          phone: emailOrPhone.trim(),
        }),
      });

      const data = await res.json();

      if (res.ok && data.success) {
        setVerificationId(String(data.verification_id || ""));
        setVerificationInquiryId(Number(data.inquiry_id || 0) || null);
        setVerificationSent(true);
        setAccessCode("");
      } else {
        alert(data.message || "Kunne ikke sende engangskode.");
      }
    } catch (err) {
      console.error(err);
      alert("Feil ved sending av engangskode. Prøv igjen.");
    } finally {
      setLoading(false);
    }
  };

  const handleVerifyCode = async (e: React.FormEvent) => {
    e.preventDefault();

    if (!verificationId || !accessCode.trim()) return;

    setLoading(true);

    try {
      const res = await fetch(apiUrl("/customer_portal.php"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "verify_code",
          inquiry_id: verificationInquiryId,
          verification_id: verificationId,
          code: accessCode.trim(),
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        alert(data.message || "Feil tilgangskode. Sjekk koden du mottok.");
        return;
      }

      const inquiryId = Number(data.inquiry_id || 0);

      if (!inquiryId) {
        alert("Kundeportalen returnerte ingen gyldig sak.");
        return;
      }

      if (data.session_token) {
        window.localStorage.setItem(
          CUSTOMER_PORTAL_SESSION_STORAGE_KEY,
          String(data.session_token)
        );
      }

      await fetchCustomerData(inquiryId);
      setIsLoggedIn(true);
    } catch (err) {
      console.error(err);
      alert("Kunne ikke bekrefte engangskoden. Prøv igjen.");
    } finally {
      setLoading(false);
    }
  };

  const toYesNo = (value: unknown): YesNoValue => {
    if (value === 1 || value === true || value === "1" || value === "true") {
      return "yes";
    }

    if (value === 0 || value === false || value === "0" || value === "false") {
      return "no";
    }

    return "";
  };

  const yesNoPayload = (value: YesNoValue): boolean | null => {
    if (value === "yes") return true;
    if (value === "no") return false;
    return null;
  };

  const populatePreinspectionForm = (data: PreinspectionData | null) => {
    setPreinspection(data);

    setProblemDescription(data?.problem_description || "");
    setProblemStartedDate(data?.problem_started_date || "");
    setProblemDiscoveredDate(data?.problem_discovered_date || "");

    setInsuranceCase(toYesNo(data?.insurance_case));
    setInsuranceDetails(data?.insurance_details || "");

    setOtherCompaniesInvolved(toYesNo(data?.other_companies_involved));
    setOtherCompaniesDetails(data?.other_companies_details || "");

    setWorkSinceTakeover(toYesNo(data?.work_since_takeover));
    setWorkDescription(data?.work_description || "");
    setWorkPerformedByProfessionals(
      toYesNo(data?.work_performed_by_professionals)
    );
    setSelfPerformedWork(toYesNo(data?.self_performed_work));

    setBuildingApplication(toYesNo(data?.building_application));
    setBuildingApplicationDetails(
      data?.building_application_details || ""
    );

    setLastMaintenanceDate(data?.last_maintenance_date || "");
    setLastMaintenanceDetails(data?.last_maintenance_details || "");
    setAdditionalInformation(data?.additional_information || "");
  };

  const fetchPreinspection = async (inquiryId: number) => {
    setLoadingPreinspection(true);
    setPreinspectionError("");

    try {
      const res = await fetch(
        apiUrl(`/preinspection.php?inquiry_id=${inquiryId}`)
      );
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke hente forhåndskartleggingen."
        );
      }

      populatePreinspectionForm(data.preinspection || null);
      setPreinspectionFiles(
        Array.isArray(data.files) ? data.files : []
      );
    } catch (err) {
      setPreinspectionError(
        err instanceof Error
          ? err.message
          : "Kunne ikke hente forhåndskartleggingen."
      );
    } finally {
      setLoadingPreinspection(false);
    }
  };

  const buildPreinspectionPayload = () => ({
    inquiry_id: inquiryData?.inquiry?.id,
    problem_description: problemDescription,
    problem_started_date: problemStartedDate || null,
    problem_discovered_date: problemDiscoveredDate || null,

    insurance_case: yesNoPayload(insuranceCase),
    insurance_details:
      insuranceCase === "yes" ? insuranceDetails : "",

    other_companies_involved: yesNoPayload(otherCompaniesInvolved),
    other_companies_details:
      otherCompaniesInvolved === "yes"
        ? otherCompaniesDetails
        : "",

    work_since_takeover: yesNoPayload(workSinceTakeover),
    work_description:
      workSinceTakeover === "yes" ? workDescription : "",
    work_performed_by_professionals:
      workSinceTakeover === "yes"
        ? yesNoPayload(workPerformedByProfessionals)
        : null,
    self_performed_work:
      workSinceTakeover === "yes"
        ? yesNoPayload(selfPerformedWork)
        : null,

    building_application: yesNoPayload(buildingApplication),
    building_application_details:
      buildingApplication === "yes"
        ? buildingApplicationDetails
        : "",

    last_maintenance_date: lastMaintenanceDate || null,
    last_maintenance_details: lastMaintenanceDetails,
    additional_information: additionalInformation,
  });

  const savePreinspection = async (submit: boolean) => {
    if (!inquiryData?.inquiry?.id) return;

    if (submit && !problemDescription.trim()) {
      setPreinspectionError(
        "Beskriv problemet før opplysningene sendes inn."
      );
      return;
    }

    setSavingPreinspection(true);
    setPreinspectionError("");
    setPreinspectionMessage("");

    try {
      const res = await fetch(apiUrl("/preinspection.php"), {
        method: preinspection ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...buildPreinspectionPayload(),
          submit,
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke lagre opplysningene."
        );
      }

      populatePreinspectionForm(data.preinspection || null);
      setPreinspectionFiles(
        Array.isArray(data.files) ? data.files : preinspectionFiles
      );

      setPreinspectionMessage(
        submit
          ? "Opplysningene er sendt inn og avventer behandling."
          : "Utkastet er lagret."
      );
    } catch (err) {
      setPreinspectionError(
        err instanceof Error
          ? err.message
          : "Kunne ikke lagre opplysningene."
      );
    } finally {
      setSavingPreinspection(false);
    }
  };

  const uploadPreinspectionFiles = async (
    category: string,
    files: FileList | null
  ) => {
    if (!files?.length || !inquiryData?.inquiry?.id) return;

    setUploadingCategory(category);
    setPreinspectionError("");
    setPreinspectionMessage("");

    try {
      const formData = new FormData();
      formData.append(
        "inquiry_id",
        String(inquiryData.inquiry.id)
      );
      formData.append("category", category);

      Array.from(files).forEach((file) => {
        formData.append("files[]", file);
      });

      const res = await fetch(apiUrl("/preinspection.php"), {
        method: "POST",
        body: formData,
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke laste opp dokumentene."
        );
      }

      await fetchPreinspection(inquiryData.inquiry.id);
      setPreinspectionMessage("Dokumentene er lastet opp.");
    } catch (err) {
      setPreinspectionError(
        err instanceof Error
          ? err.message
          : "Kunne ikke laste opp dokumentene."
      );
    } finally {
      setUploadingCategory(null);
    }
