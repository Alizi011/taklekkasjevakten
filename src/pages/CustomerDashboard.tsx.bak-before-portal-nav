                                <p className="text-[10px] font-bold text-slate-400">
                                  {(() => {
                                    const date =
                                      item.accepted_at ||
                                      item.rejected_at ||
                                      item.published_at;
                                    return date
                                      ? new Date(
                                          String(date).replace(" ", "T")
                                        ).toLocaleDateString("nb-NO")
                                      : "";
                                  })()}
                                </p>
                              </div>
                            </div>
                          </div>
                        );
                      })}

