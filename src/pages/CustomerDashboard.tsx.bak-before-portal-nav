                                        type="checkbox"
                                        checked={
                                          expandedOfferId === item.id &&
                                          offerTermsConfirmed
                                        }
                                        onChange={(e) => {
                                          setExpandedOfferId(item.id);
                                          setOfferTermsConfirmed(
                                            e.target.checked
                                          );
                                          if (e.target.checked)
                                            setOfferError("");
                                        }}
