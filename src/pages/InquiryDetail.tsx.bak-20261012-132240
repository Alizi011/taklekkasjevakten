function serviceLabel(service?: Inquiry["recommended_service"]) {
  switch (service) {
    case "lekkasjesok":
      return "Lekkasjesøk";
    case "service":
      return "Service";
    case "takkontroll":
      return "Takkontroll";
    default:
      return "Ikke valgt";
  }
}


function orderedServiceLabel(value?: string | null) {
  switch (String(value || "").trim().toLowerCase()) {
    case "lekkasjesok":
    case "lekkasjesøk":
      return "Lekkasjesøk";
    case "takkontroll":
      return "Takkontroll";
    case "service":
      return "Servicearbeid";
    case "akutt":
      return "Akutt utbedring";
    case "digital":
    case "digital_befaring":
      return "Digital konsultasjon";
    default:
      return "Ikke oppgitt";
  }
}

function reportStatusLabel(status?: string) {
  switch (status) {
    case "utkast":
      return "Utkast hos feltteam";
    case "sendt_til_admin":
      return "Sendt til admin";
    case "under_gjennomgang":
      return "Under admin-gjennomgang";
    case "godkjent":
      return "Godkjent";
