            </section>
          )}

        <section id="documents" className={`${adminCaseTab === "documents" ? "" : "hidden"} scroll-mt-6 rounded-2xl border border-slate-800 bg-[#0b0f17] p-5`}>
          <div className="mb-5 flex flex-wrap items-start justify-between gap-3">
            <div>
              <h3 className="text-lg font-black text-white">Kundens informasjon og vedlegg</h3>
              <p className="mt-1 text-sm text-slate-400">Beskrivelse til venstre, bilder og dokumenter til høyre.</p>
            </div>
            <button type="button" onClick={() => setAdminCaseTab("customer")}
              className="rounded-xl border border-cyan-500/30 bg-cyan-500/10 px-4 py-2.5 text-xs font-bold text-cyan-200 hover:bg-cyan-500/15">
              Vis hele kundeskjemaet
            </button>
          </div>
          <div className="grid gap-5 xl:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)]">
            <div className="min-w-0 rounded-2xl border border-slate-800 bg-slate-950/60 p-5">
              <h4 className="text-sm font-black text-white">Beskrivelse fra kunden</h4>
              <p className="mt-1 text-xs text-slate-500">Opplysninger mottatt i skjemaet</p>
              <p className="mt-4 whitespace-pre-wrap break-words text-sm leading-7 text-slate-200">
                {preinspection?.problem_description || "Ingen problembeskrivelse er registrert i kundeskjemaet."}
              </p>
              <div className="mt-6 border-t border-slate-800 pt-5">
                <h4 className="text-sm font-black text-white">Saksnotater</h4>
                <p className="mt-3 whitespace-pre-wrap break-words text-xs leading-6 text-slate-400">
                  {inquiry.notes || "Ingen saksnotater."}
                </p>
              </div>
            </div>
            <div className="min-w-0 overflow-hidden rounded-2xl border border-slate-800 bg-slate-950/40">
              <div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-800 p-3">
                <div className="flex gap-2" role="tablist" aria-label="Kundevedlegg">
                  {(["images", "documents"] as const).map((tab) => {
                    const count = preinspectionFiles.filter((file) =>
                      tab === "images" ? isCustomerImage(file) : !isCustomerImage(file)
                    ).length;
                    return (
                      <button key={tab} type="button" role="tab"
                        aria-selected={customerAttachmentTab === tab}
                        onClick={() => setCustomerAttachmentTab(tab)}
                        className={`rounded-xl px-4 py-2.5 text-xs font-bold transition ${customerAttachmentTab === tab
                          ? "bg-amber-500/15 text-amber-300 ring-1 ring-amber-500/40"
                          : "text-slate-400 hover:bg-slate-800 hover:text-white"}`}>
                        {tab === "images" ? "Bilder" : "Dokumenter"} ({count})
                      </button>
                    );
                  })}
                </div>
              </div>
              <div className="min-h-[230px] p-4" role="tabpanel">
                {loadingPreinspection ? (
                  <p className="text-sm text-slate-400">Henter vedlegg fra kunden...</p>
                ) : preinspectionError ? (
                  <p className="text-sm text-red-300">{preinspectionError}</p>
                ) : (
                  (() => {
                    const visibleFiles = preinspectionFiles.filter((file) =>
                      customerAttachmentTab === "images" ? isCustomerImage(file) : !isCustomerImage(file)
                    );
                    return visibleFiles.length ? (
                      <div className={`grid gap-3 ${customerAttachmentTab === "images" ? "sm:grid-cols-2" : "grid-cols-1"}`}>
                        {visibleFiles.map((file) => <CustomerAttachment key={file.id} file={file} />)}
                      </div>
                    ) : (
                      <div className="flex min-h-[190px] items-center justify-center rounded-xl border border-dashed border-slate-800 p-5 text-center text-sm text-slate-500">
                        {customerAttachmentTab === "images" ? "Ingen bilder registrert i kundeskjemaet." : "Ingen dokumenter registrert i kundeskjemaet."}
                      </div>
                    );
                  })()
                )}
              </div>
            </div>
          </div>
        </section>

        <div
          id="messages"
          className={`${adminCaseTab === "messages" ? "" : "hidden"} scroll-mt-6 space-y-4`}
        >
          <div className="flex flex-wrap gap-2 rounded-2xl border border-slate-800 bg-[#0b0f17] p-2">
            <button
              type="button"
              onClick={() => setCommunicationView("messages")}
              className={`rounded-xl px-4 py-2.5 text-xs font-extrabold transition ${
                communicationView === "messages"
                  ? "bg-[#F5B800] text-slate-950"
                  : "text-slate-400 hover:bg-slate-900 hover:text-white"
              }`}
            >
              Samtaler
            </button>

            <button
              type="button"
              onClick={() => setCommunicationView("log")}
              className={`rounded-xl px-4 py-2.5 text-xs font-extrabold transition ${
                communicationView === "log"
                  ? "bg-[#F5B800] text-slate-950"
                  : "text-slate-400 hover:bg-slate-900 hover:text-white"
              }`}
            >
              Kommunikasjonslogg
            </button>
          </div>

          {communicationView === "messages" ? (
            <InquiryMessages
              inquiryId={inquiryId}
              projectManagerName={
                currentProjectManager?.name ||
                inquiry.assigned_to ||
                null
              }
            />
          ) : (
            <InquiryCommunicationLog inquiryId={inquiryId} />
          )}
        </div>

        {!isDigitalBefaring && (
          <>
        <section id="checklist-administration"
          className={`${adminCaseTab === "checklists" ? "" : "hidden"} scroll-mt-6 rounded-2xl border border-slate-800 bg-[#0b0f17] p-5 space-y-5`}>
          <div className="flex flex-wrap items-start justify-between gap-3 border-b border-slate-800 pb-4">
            <div>
              <h3 className="text-base font-black text-white">Sjekkliste for oppdraget</h3>
              <p className="mt-1 text-xs text-slate-400">Forhåndsvis malene. Endelig tildeling krever lagring via Perun Core.</p>
            </div>
            <div className="text-xs text-slate-400">Registrert taktype: <strong className="text-white">{inquiry.roof_type || inquiry.roofType || "Ukjent"}</strong></div>
          </div>
          <div className="grid gap-3 md:grid-cols-3">
            {checklistTemplateOptions.map((item) => (
              <button key={item.key} type="button"
                onClick={() => setSelectedChecklistTemplate(item.key)}
                aria-pressed={selectedChecklistTemplate === item.key}
                className={`rounded-xl border p-4 text-left transition ${selectedChecklistTemplate === item.key
                  ? "border-amber-400/70 bg-amber-400/10"
                  : "border-slate-700 bg-slate-950/50 hover:border-slate-500"}`}>
                <div className="flex items-center gap-2 text-sm font-black text-white">
                  <ClipboardCheck className="h-4 w-4 text-amber-300" />{item.label}
                </div>
                <p className="mt-2 text-[11px] leading-5 text-slate-400">{item.details}</p>
              </button>
            ))}
          </div>
          {selectedChecklistTemplate && (
            <div className="rounded-xl border border-slate-700 bg-slate-900/50 p-4">
              <p className="text-xs font-bold text-white">Valgt for forhåndsvisning: {checklistTemplateOptions.find(x => x.key === selectedChecklistTemplate)?.label}</p>
              <p className="mt-2 text-xs text-slate-400">Valget er foreløpig ikke lagret. Tildeling må gå gjennom et autentisert Perun Core-endepunkt som kontrollerer eksisterende resultater og vedlegg før lagring.</p>
            </div>
          )}
          <div className="space-y-4 border-t border-slate-800 pt-5">
            <div className="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h4 className="text-sm font-black text-white">
                  Registreringer fra prosjektleder
                </h4>
                <p className="mt-1 text-xs text-slate-400">
                  Lagrede kontrollpunkter og dokumentasjon fra oppdraget.
                </p>
              </div>
              <div className="flex items-center gap-2">
                <span className="rounded-lg bg-slate-800 px-3 py-1.5 text-xs text-white">
                  {checklists.length} registrerte punkter
                </span>
                <button
                  type="button"
                  onClick={() => setSelectedChecklistTemplate("")}
                  className="rounded-lg border border-slate-700 px-3 py-1.5 text-xs text-slate-300 hover:text-white"
                >
                  Vis alle
                </button>
              </div>
            </div>

            {loadingFieldStatus ? (
              <p className="text-sm text-slate-400">
                Henter registreringer...
              </p>
            ) : fieldError ? (
              <p className="text-sm text-red-300">
                Kunne ikke hente dokumentasjonen: {fieldError}
              </p>
            ) : (
              <>
                {checklists.length > 0 && (
                  <div className="rounded-xl border border-amber-500/30 bg-amber-500/10 p-3 text-xs text-amber-200">
                    Påbegynt – registreringer finnes. Dette betyr ikke
                    at sjekklisten er ferdigstilt.
                  </div>
                )}

                <div className="space-y-3">
                  {checklists
                    .filter((item) => {
                      if (!selectedChecklistTemplate) return true;
                      const key = item.item_id.toLowerCase();

                      if (selectedChecklistTemplate === "tlv_flatt")
                        return key.startsWith("flatt-");

                      if (selectedChecklistTemplate === "tlv_skratak")
                        return key.startsWith("skra") ||
                          key.startsWith("skrå");

                      if (selectedChecklistTemplate === "tlv_balkong")
                        return key.startsWith("balk") ||
                          key.startsWith("terrasse");

                      return true;
                    })
                    .map((item) => (
                      <div
                        key={item.id}
                        className="rounded-xl border border-slate-700 bg-slate-900/60 p-4"
                      >
                        <div className="flex flex-wrap items-start justify-between gap-2">
                          <div>
                            <p className="text-sm font-bold text-white">
                              {item.item_title}
                            </p>
                            <p className="mt-1 text-[11px] text-slate-500">
                              Kontrollpunkt: {item.item_id}
                            </p>
                          </div>

                          <span className="rounded-lg border border-amber-500/30 bg-amber-500/10 px-3 py-1 text-xs font-bold uppercase text-amber-200">
                            {item.status === "ikke_aktuell"
                              ? "Ikke aktuell"
                              : item.status}
                          </span>
                        </div>

                        <div className="mt-3 rounded-lg bg-slate-950 p-3">
                          <p className="text-[11px] font-bold uppercase tracking-wide text-slate-500">
                            Notat
                          </p>
                          <p className="mt-1 whitespace-pre-wrap text-sm text-slate-200">
                            {item.comment?.trim() || "Ingen notat registrert"}
                          </p>
                        </div>

                        {photos
                          .filter((photo) => photo.checklist_item_id === item.item_id)
                          .map((photo) => (
                            <div
                              key={photo.id}
                              className="mt-3 rounded-xl border border-slate-700 bg-slate-950 p-3 space-y-2"
                            >
                              {photo.photo_url && (
                                <a
                                  href={new URL(photo.photo_url, apiUrl("/")).href}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                >
                                  <img
                                    src={new URL(photo.photo_url, apiUrl("/")).href}
                                    alt={photo.caption_text || "Dokumentasjon"}
                                    loading="lazy"
                                    className="max-h-64 w-full rounded-lg object-contain"
                                  />
                                </a>
                              )}

                              {photo.caption_text && (
                                <p className="whitespace-pre-wrap text-xs text-slate-300">
                                  {photo.caption_text}
                                </p>
                              )}

                              {photo.audio_url && (
                                <audio
                                  controls
                                  preload="none"
                                  className="w-full"
                                  src={new URL(photo.audio_url, apiUrl("/")).href}
                                />
                              )}
                            </div>
                          ))}

                        {item.photo_url && (
                          <a
                            href={new URL(item.photo_url, apiUrl("/")).href}
                            target="_blank"
                            rel="noopener noreferrer"
                            className="mt-3 inline-block text-xs text-amber-300 underline"
                          >
                            Åpne tilknyttet bilde
                          </a>
                        )}

                        {item.audio_url && (
                          <audio
                            controls
                            preload="none"
                            className="mt-3 w-full"
                            src={new URL(item.audio_url, apiUrl("/")).href}
                          />
                        )}
                      </div>
                    ))}

                  {checklists.length === 0 && (
                    <p className="rounded-xl border border-slate-800 p-4 text-sm text-slate-400">
                      Ingen kontrollpunkter er lagret på denne saken ennå.
                    </p>
                  )}
                </div>

                {photos.length > 0 && (
                  <div className="space-y-3 border-t border-slate-800 pt-4">
                    <h4 className="text-sm font-bold text-white">
                      Prosjektdokumentasjon ({photos.length})
                    </h4>
                    <p className="text-xs text-slate-400">
                      Dokumentasjon som ikke er knyttet til et registrert kontrollpunkt.
                    </p>

                    <div className="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                      {photos.filter((photo) => !photo.checklist_item_id || !checklists.some((item) => item.item_id === photo.checklist_item_id)).map((photo) => (
                        <div
                          key={photo.id}
                          className="overflow-hidden rounded-xl border border-slate-700 bg-slate-900"
                        >
                          {photo.photo_url && (
                            <a
                              href={new URL(photo.photo_url, apiUrl("/")).href}
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              <img
                                src={new URL(photo.photo_url, apiUrl("/")).href}
                                alt={photo.caption_text || "Prosjektbilde"}
                                loading="lazy"
                                className="h-44 w-full object-cover"
                              />
                            </a>
                          )}

                          <div className="space-y-2 p-3">
                            <p className="whitespace-pre-wrap text-xs text-slate-200">
                              {photo.caption_text || "Ingen bildetekst"}
                            </p>

                            {photo.audio_url && (
                              <audio
                                controls
                                preload="none"
                                className="w-full"
                                src={new URL(photo.audio_url, apiUrl("/")).href}
                              />
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </>
            )}
          </div>

          <p className="text-[11px] text-slate-500">
            Skrivebeskyttet visning. Eksisterende registreringer endres ikke.
          </p>
        </section>
        <section id="field-status" className={`${adminCaseTab === "field" ? "" : "hidden"} scroll-mt-6 bg-[#0b0f17] border border-slate-800 rounded-2xl p-6 space-y-5`}>
          <div className="border-b border-slate-800/80 pb-4">
            <h3 className="font-extrabold text-sm text-white flex items-center gap-2">
              <CheckCircle2 className="w-5 h-5 text-[#F5B800]" />
              Feltstatus
            </h3>
          </div>

          {fieldError && (
            <div className="bg-red-500/10 border border-red-500/30 rounded-xl p-3 text-xs text-red-300 flex items-start gap-2">
              <AlertTriangle className="w-4 h-4 shrink-0 mt-0.5" />
              {fieldError}
            </div>
          )}

          {loadingFieldStatus ? (
            <div className="py-8 flex items-center justify-center gap-2 text-xs text-slate-400">
              <Loader2 className="w-4 h-4 animate-spin text-[#F5B800]" />
              Henter feltstatus...
            </div>
          ) : (
            <>
              <div className="grid grid-cols-2 lg:grid-cols-5 gap-3">
                <div className="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <span className="block text-[9px] uppercase tracking-wider font-extrabold text-slate-500">
                    Kontrollpunkter
                  </span>
                  <strong className="text-xl font-black text-white block mt-1">
                    {activeChecklistItems.length}
                  </strong>
                </div>

                <div className="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <span className="block text-[9px] uppercase tracking-wider font-extrabold text-slate-500">
                    Avvik TG1–TG3
                  </span>
                  <strong className="text-xl font-black text-amber-400 block mt-1">
                    {deviations.length}
                  </strong>
                </div>

                <div className="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <span className="block text-[9px] uppercase tracking-wider font-extrabold text-slate-500">
                    TG2 / TG3
                  </span>
                  <strong className="text-xl font-black text-red-400 block mt-1">
                    {highDeviations}
                  </strong>
                </div>

                <div className="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <span className="block text-[9px] uppercase tracking-wider font-extrabold text-slate-500">
                    Bilder
                  </span>
                  <strong className="text-xl font-black text-white block mt-1">
                    {photos.length}
                  </strong>
                </div>

                <div className="bg-slate-950 border border-slate-800 rounded-xl p-4">
                  <span className="block text-[9px] uppercase tracking-wider font-extrabold text-slate-500">
                    Lydnotater
                  </span>
                  <strong className="text-xl font-black text-white block mt-1">
                    {audioCount}
                  </strong>
                </div>
              </div>

              {deviations.length > 0 && (
                <div>
                  <h4 className="text-[10px] uppercase tracking-wider font-extrabold text-slate-500 mb-3">
                    Registrerte avvik
                  </h4>

                  <div className="space-y-2">
                    {deviations.slice(0, 8).map((item) => (
                      <div
                        key={item.id}
                        className="bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-2"
                      >
                        <div>
                          <p className="text-xs font-bold text-slate-200">
                            {item.item_title}
                          </p>
                          {item.comment && (
                            <p className="text-[11px] text-slate-500 mt-1">
                              {item.comment}
                            </p>
                          )}
                        </div>

                        <span className="shrink-0 uppercase text-[10px] font-black px-2.5 py-1 rounded-lg bg-amber-500/10 text-amber-400 border border-amber-500/30">
                          {item.status}
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 flex items-center gap-3">
                  <Camera className="w-5 h-5 text-blue-400" />
                  <div>
                    <span className="block text-[9px] uppercase text-slate-500 font-extrabold">
                      Dokumentasjon
                    </span>
                    <span className="text-xs font-bold text-slate-200">
                      {photos.length} feltbilder
                    </span>
                  </div>
                </div>

                <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 flex items-center gap-3">
                  <FileText className="w-5 h-5 text-amber-400" />
                  <div>
                    <span className="block text-[9px] uppercase text-slate-500 font-extrabold">
                      Rapportstatus
                    </span>
                    <span className="text-xs font-bold text-slate-200">
                      {reportStatusLabel(report?.status)}
                    </span>
                  </div>
                </div>

                <div className="bg-slate-950 border border-slate-800 rounded-xl p-4 flex items-center gap-3">
                  <Wrench className="w-5 h-5 text-emerald-400" />
                  <div>
                    <span className="block text-[9px] uppercase text-slate-500 font-extrabold">
                      Feltansvar
                    </span>
                    <span className="text-xs font-bold text-slate-200">
                      {isDigitalBefaring
                        ? "Kun prosjektansvarlig"
                        : "Prosjektansvarlig + tekniker"}
                    </span>
                  </div>
                </div>
              </div>
            </>
          )}
        </section>

          </>
        )}

        <div id="history" className="hidden" />

        {!isDigitalBefaring && (
          <div id="reports" className={`${adminCaseTab === "reports" ? "" : "hidden"} scroll-mt-6`}>
            <AdminReportReview inquiryId={inquiryId} />
          </div>
        )}
      </div>
    </div>
  );
}


