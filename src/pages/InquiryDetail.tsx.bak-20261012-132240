      } else {
        setOfferMessage(
          data.message ||
            "Saken er avsluttet. Tilbud og kommunikasjon er beholdt i historikken."
        );
      }
    } catch (err) {
      setOfferError(
        err instanceof Error
          ? err.message
          : "Kunne ikke følge opp det avviste tilbudet."
      );
    } finally {
      setHandlingRejectedOffer(false);
    }
  };

