      if (action === "revise_offer") {
        const nextOffer = data.offer || null;
        setOffer(nextOffer);
        hydrateOfferForm(nextOffer);
        setShowPublishedOfferDetails(true);
        setOfferMessage(
          data.message ||
            "Nytt tilbudsutkast er opprettet. Kontroller endringene før du publiserer."
