      return;
    }

    setSavingTeam(true);
    setTeamError("");
    setTeamMessage("");

    try {
      await saveTeamAssignment(managerId, "Prosjektleder");

      // Digital befaring utføres kun av prosjektansvarlig.
      if (!isDigitalBefaring) {
        await saveTeamAssignment(techId, "Tekniker");
      }

      await fetchTeamData();

      const selectedManager = employees.find(
