import { useCallback, useEffect, useState } from "react";
import { CheckCircle2, Eye, FileText, Loader2, RotateCcw, X, ShieldCheck, AlertTriangle } from "lucide-react";
import { apiUrl, apiAssetUrl } from "../lib/api";

type WorkflowState = "editing" | "awaiting_pm" | "awaiting_admin" | "returned" | "approved" | "published" | string;
type WorkflowResponse = {
  success: boolean;
  state?: WorkflowState;
  report_id?: number;
  pdf_url?: string | null;
  message?: string;
  content_unchanged?: boolean;
  review_opened?: boolean;
  review_confirmed?: boolean;
  workflow?: { return_comment?: string };
};

const SESSION_KEY = "taklekkasjevakten_project_manager_session";

/**
 * Faglig gjennomgang av Rapport 1.
 * Admin-forhåndsvisning er skrivebeskyttet; PHP verifiserer alle handlinger.
 * Merk: Bekreftelse er en sporbar erklæring, ikke teknisk bevis for at PDF er lest.
 */
export default function ProjectManagerReportApproval({
  inquiryId,
  onUpdated,
  previewMode = false,
}: {
  inquiryId: number;
  onUpdated?: () => void;
  previewMode?: boolean;
}) {
  const [report, setReport] = useState<WorkflowResponse | null>(null);
  const [error, setError] = useState("");
  const [message, setMessage] = useState("");
  const [busy, setBusy] = useState(false);
  const [loading, setLoading] = useState(true);
  const [readerOpen, setReaderOpen] = useState(false);
  const [previewOpened, setPreviewOpened] = useState(false);
  const [confirmedCheck, setConfirmedCheck] = useState(false);
  const [comment, setComment] = useState("");
  const [refresh, setRefresh] = useState(0);
  const session = typeof window !== "undefined" ? window.localStorage.getItem(SESSION_KEY) : null;
  const canAct = !previewMode && Boolean(session);

  const callWorkflow = useCallback(async (action: string, extra: Record<string, unknown> = {}): Promise<WorkflowResponse> => {
    const response = await fetch(apiUrl("/tlv_report_approval_workflow.php"), {
      method: "POST",
      credentials: "include",
      cache: "no-store",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        inquiry_id: inquiryId,
        action,
        ...(canAct ? { session_token: session } : {}),
        ...extra,
      }),
    });
    const result: WorkflowResponse = await response.json();
    if (!response.ok || !result.success) throw new Error(result.message || "Kunne ikke behandle rapporten.");
    return result;
  }, [inquiryId, canAct, session]);

  useEffect(() => {
    let mounted = true;
    setReport(null);
    setError("");
    setLoading(true);
    if (inquiryId <= 0 || (!previewMode && !session)) {
      setLoading(false);
      return;
    }
    callWorkflow(canAct ? "pm_status" : "status")
      .then((data) => { if (mounted) setReport(data); })
      .catch((err) => { if (mounted) setError(err instanceof Error ? err.message : "Kunne ikke hente status."); })
      .finally(() => { if (mounted) setLoading(false); });
    return () => { mounted = false; };
  }, [inquiryId, previewMode, session, canAct, callWorkflow, refresh]);

  useEffect(() => { setReaderOpen(false); setPreviewOpened(false); setConfirmedCheck(false); setComment(""); setMessage(""); }, [inquiryId]);

  const refreshStatus = () => setRefresh((value) => value + 1);
  const contentValid = report?.content_unchanged !== false;
  const awaiting = report?.state === "awaiting_pm";
  const pdfUrl = report?.pdf_url ? apiAssetUrl(report.pdf_url) : null;

  const openReader = async () => {
    if (!pdfUrl) return;
    setError("");
    setReaderOpen(true);
    if (previewMode) setPreviewOpened(true);
    if (canAct && awaiting && contentValid) {
      setBusy(true);
      try {
        await callWorkflow("pm_review_open");
        refreshStatus();
      } catch (err) {
        setError(err instanceof Error ? err.message : "Kunne ikke registrere åpning av rapporten.");
      } finally {
        setBusy(false);
      }
    }
  };

  const confirmReview = async () => {
    if (!canAct || !confirmedCheck || !report?.review_opened || busy) return;
    setBusy(true);
    setError("");
    try {
      await callWorkflow("pm_review_confirm", { confirmed: true });
      setMessage("Gjennomgangen er bekreftet for denne rapportversjonen.");
      refreshStatus();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Kunne ikke bekrefte gjennomgangen.");
    } finally {
      setBusy(false);
    }
  };

  const decide = async (action: "pm_approve" | "pm_return") => {
    if (!canAct || busy || !report?.review_confirmed || !contentValid) return;
    if (action === "pm_return" && !comment.trim()) {
      setError("Skriv en kommentar med hva administrator må korrigere.");
      return;
    }
    setBusy(true);
    setError("");
    setMessage("");
    try {
      await callWorkflow(action, { comment: comment.trim() });
      setComment("");
      setMessage(action === "pm_approve"
        ? "Rapporten er faglig godkjent og sendt til administrator for sluttgodkjenning."
        : "Rapporten er returnert til administrator med kommentaren din.");
      refreshStatus();
      onUpdated?.();
    } catch (err) {
      setError(err instanceof Error ? err.message : "Handlingen feilet.");
    } finally {
      setBusy(false);
    }
  };

  if (!previewMode && !session) return null;
  if (loading) return <div className="flex items-center gap-2 rounded-2xl border border-orange-500/25 bg-[#281a13] p-5 text-sm text-slate-200"><Loader2 className="h-4 w-4 animate-spin" /> Henter faglig godkjenning …</div>;
  if (!report && error) return <div role="alert" className="rounded-2xl border border-red-500/35 bg-red-500/10 p-5 text-sm text-red-200">{error}<button type="button" onClick={refreshStatus} className="ml-3 underline">Prøv igjen</button></div>;
  if (!report) return null;

  return (
    <section className="space-y-5 rounded-3xl border border-orange-500/35 bg-gradient-to-br from-[#302016] via-[#251914] to-[#1b1513] p-5 text-slate-100 shadow-[0_12px_35px_rgba(0,0,0,0.15)] sm:p-6" aria-label="Faglig godkjenning Rapport 1">
      <div className="flex flex-wrap items-start justify-between gap-3">
        <div>
          <p className="text-xs font-black uppercase tracking-wider text-orange-300">Rapport 1 · faglig kontroll</p>
          <h3 className="mt-1 text-lg font-black text-white">{awaiting ? "Rapporten venter på faglig gjennomgang" : "Godkjenningsstatus"}</h3>
          <p className="mt-1 text-sm text-slate-300">{previewMode ? "Forhåndsvisning – bare prosjektansvarlig kan godkjenne." : "Åpne rapporten, kontroller innholdet og bekreft gjennomgang før du beslutter."}</p>
        </div>
        <span className="rounded-full border border-orange-400/30 bg-orange-500/15 px-3 py-1.5 text-xs font-extrabold text-orange-200">
          {awaiting ? "Venter på prosjektansvarlig" : report.state === "awaiting_admin" ? "Faglig godkjent" : report.state === "returned" ? "Returnert til admin" : report.state === "approved" ? "Sluttgodkjent" : report.state === "published" ? "Publisert" : "Under behandling"}
        </span>
      </div>
      {!contentValid && <p role="alert" className="flex items-center gap-2 rounded-xl border border-red-500/30 bg-red-500/10 p-3 text-sm text-red-200"><AlertTriangle className="h-4 w-4" /> Rapportinnholdet er endret. Administrator må sende inn en ny gjennomgang.</p>}
      <div className="flex flex-col gap-3 rounded-xl border border-orange-500/20 bg-[#201510] p-4 sm:flex-row sm:items-center sm:justify-between">
        <div className="flex items-center gap-2"><FileText className="h-5 w-5 text-orange-300" /><span className="text-sm font-bold">Rapport #{report.report_id ?? "–"} · låst PDF</span></div>
        <button type="button" onClick={() => void openReader()} disabled={!pdfUrl || busy} className="inline-flex items-center justify-center gap-2 rounded-xl bg-[#ff951a] px-4 py-2.5 text-sm font-black text-slate-950 hover:bg-orange-400 disabled:opacity-40"><Eye className="h-4 w-4" /> Les rapporten</button>
      </div>
      {awaiting && canAct && contentValid && (
        <div className="space-y-3">
          <div className="flex items-center gap-2 text-sm text-slate-200"><ShieldCheck className="h-4 w-4 text-emerald-300" /> {report.review_confirmed ? "Gjennomgang bekreftet" : report.review_opened ? "Rapport åpnet – bekreft gjennomgangen" : "Trinn 1: Åpne rapporten"}</div>
          {!report.review_confirmed && (
            <div className="rounded-xl border border-orange-500/20 bg-orange-500/5 p-4">
              <label className="flex cursor-pointer items-start gap-3 text-sm leading-6 text-slate-100">
                <input type="checkbox" checked={confirmedCheck} disabled={!report.review_opened || busy} onChange={(event) => setConfirmedCheck(event.target.checked)} className="mt-1 h-4 w-4 accent-orange-500" />
                Jeg bekrefter at jeg har gjennomgått rapporten, vurderingene og konklusjonen for denne versjonen.
              </label>
              <button type="button" disabled={!report.review_opened || !confirmedCheck || busy} onClick={() => void confirmReview()} className="mt-3 rounded-xl border border-emerald-500/40 bg-emerald-500/15 px-4 py-2.5 text-sm font-bold text-emerald-200 disabled:opacity-40">Bekreft gjennomgang</button>
            </div>
          )}
          <div className="space-y-3 border-t border-orange-900/45 pt-4">
            <textarea rows={3} value={comment} onChange={(event) => setComment(event.target.value)} placeholder="Kommentar om hva som må korrigeres (påkrevd ved retur)" className="w-full resize-y rounded-xl border border-orange-900/50 bg-[#160f0d] p-3 text-sm text-white placeholder:text-slate-400" />
            <div className="flex flex-wrap gap-3">
              <button type="button" disabled={busy || !report.review_confirmed} onClick={() => void decide("pm_approve")} className="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-black text-white disabled:opacity-40"><CheckCircle2 className="h-4 w-4" /> Godkjenn faglig</button>
              <button type="button" disabled={busy || !report.review_confirmed || !comment.trim()} onClick={() => void decide("pm_return")} className="inline-flex items-center gap-2 rounded-xl border border-red-400/40 bg-red-500/10 px-4 py-2.5 text-sm font-black text-red-200 disabled:opacity-40"><RotateCcw className="h-4 w-4" /> Returner med kommentar</button>
            </div>
          </div>
        </div>
      )}
      {awaiting && previewMode && (
        <div className="space-y-4 rounded-xl border border-amber-500/20 bg-[#1d1613] p-4 sm:p-5">
          <div className="flex flex-wrap items-start justify-between gap-2">
            <div>
              <h4 className="text-sm font-extrabold text-white">Slik fungerer faglig beslutning</h4>
              <p className="mt-1 text-xs leading-5 text-slate-300">Test av grensesnittet. Dine valg her blir ikke lagret og endrer ikke rapportstatus.</p>
            </div>
            <span className="rounded-full border border-amber-500/25 bg-amber-500/10 px-2.5 py-1 text-[11px] font-bold text-amber-200">Forhåndsvisning</span>
          </div>
          <label className="flex items-start gap-3 rounded-xl border border-slate-700/50 bg-[#281d19] p-3 text-sm leading-6 text-slate-100">
            <input type="checkbox" checked={confirmedCheck} disabled={!previewOpened} onChange={(event) => { setConfirmedCheck(event.target.checked); setMessage(""); }} className="mt-1 h-4 w-4 accent-orange-500" />
            <span>Jeg bekrefter at jeg har gjennomgått Rapport 1.
              {!previewOpened && <span className="block text-xs text-amber-200">Åpne rapporten først for å aktivere avkrysningen.</span>}
            </span>
          </label>
          <div>
            <label htmlFor={`pm-preview-comment-${inquiryId}`} className="mb-2 block text-xs font-bold text-slate-200">Kommentar ved retur</label>
            <textarea id={`pm-preview-comment-${inquiryId}`} rows={3} value={comment} onChange={(event) => setComment(event.target.value)} placeholder="Beskriv hva administrator bør korrigere …" className="w-full resize-y rounded-xl border border-slate-700 bg-[#130f10] p-3 text-sm text-white placeholder:text-slate-500" />
          </div>
          <div className="flex flex-wrap gap-3">
            <button type="button" disabled={!confirmedCheck} onClick={() => setMessage("Testmodus: Rapporten ville blitt sendt til administrator for sluttgodkjenning. Ingen data ble endret.")} className="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white disabled:cursor-not-allowed disabled:opacity-40"><CheckCircle2 className="h-4 w-4" /> Godkjenn faglig (test)</button>
            <button type="button" disabled={!confirmedCheck || !comment.trim()} onClick={() => setMessage("Testmodus: Rapporten ville blitt returnert til administrator med kommentaren. Ingen data ble endret.")} className="inline-flex items-center gap-2 rounded-xl border border-red-400/40 bg-red-500/10 px-4 py-2.5 text-sm font-bold text-red-200 disabled:cursor-not-allowed disabled:opacity-40"><RotateCcw className="h-4 w-4" /> Returner med kommentar (test)</button>
          </div>
        </div>
      )}
      {busy && <p className="flex items-center gap-2 text-sm text-orange-200"><Loader2 className="h-4 w-4 animate-spin" /> Behandler …</p>}
      {message && <p role="status" className="text-sm text-emerald-200">{message}</p>}
      {error && <p role="alert" className="text-sm text-red-200">{error}</p>}
      {readerOpen && pdfUrl && (
        <div className="fixed inset-0 z-[150] flex flex-col bg-black/90 p-3 md:p-6" role="dialog" aria-modal="true" aria-label="Les Rapport 1">
          <div className="mb-3 flex items-center justify-between gap-3 text-white">
            <div><h4 className="text-base font-black">Rapport 1 – gjennomgang</h4><p className="text-xs text-slate-300">Bla gjennom PDF-en. Lukk når du er ferdig.</p></div>
            <button type="button" onClick={() => setReaderOpen(false)} className="flex items-center gap-2 rounded-xl border border-slate-600 px-4 py-2 text-sm font-bold"><X className="h-4 w-4" /> Lukk PDF</button>
          </div>
          <iframe src={pdfUrl} title={`Rapport 1 – oppdrag ${inquiryId}`} className="min-h-0 w-full flex-1 rounded-lg bg-white" />
          <p className="mt-2 text-xs text-slate-300">Avkryssingen etterpå er din egen bekreftelse på at rapporten er gjennomgått.</p>
        </div>
      )}
    </section>
  );
}
