import ReportApprovalWorkflow from "../components/ReportApprovalWorkflow";
import { useEffect, useMemo, useState } from "react";
import {
  AlertTriangle,
  ArrowLeft,
  Camera,
  Check,
  CheckCircle2,
  ChevronDown,
  ChevronUp,
  Eye,
  FileText,
  Image as ImageIcon,
  Loader2,
  Mic,
  RefreshCw,
  RotateCcw,
  Save,
  Send,
  ShieldCheck,
  X,
} from "lucide-react";
import { apiUrl, apiAssetUrl } from "../lib/api";

export type ReportStatus =
  | "utkast"
  | "sendt_til_admin"
  | "under_gjennomgang"
  | "returnert_til_prosjektansvarlig"
  | "godkjent"
  | "publisert";

export interface ReportData {
  id: number;
  inquiry_id: number;
  ai_draft: string | null;
  admin_final: string | null;
  admin_sections_json?: string | null;
  admin_notes?: string | null;
  pdf_url?: string | null;
  status: ReportStatus;
  created_at?: string | null;
  submitted_at?: string | null;
  returned_at?: string | null;
  approved_at?: string | null;
  published_at?: string | null;
  updated_at?: string | null;
  revision_no?: number | null;
  supersedes_report_id?: number | null;
}

interface CompletionReportData {
  id: number;
  inquiry_id: number;
  source_report_id: number;
  work_completion_id: number;
  revision_no?: number | null;
  supersedes_completion_report_id?: number | null;
  ai_draft: string | null;
  admin_final: string | null;
  admin_sections_json?: string | null;
  admin_notes?: string | null;
  pdf_url?: string | null;
  status: ReportStatus;
  submitted_at?: string | null;
  returned_at?: string | null;
  approved_at?: string | null;
  published_at?: string | null;
  created_at?: string | null;
  updated_at?: string | null;
}

interface ChecklistRow {
  id: number;
  inquiry_id: number;
  item_id?: string | null;
  category?: string | null;
  item_title: string;
  status: string;
  comment?: string | null;
  photo_url?: string | null;
  audio_url?: string | null;
  created_at?: string | null;
}

interface PhotoData {
  id: number;
  inquiry_id: number;
  checklist_item_id?: string | null;
  photo_url?: string | null;
  audio_url?: string | null;
  audio_transcript?: string | null;
  caption_text?: string | null;
  include_in_report?: number | boolean | string | null;
  report_sort_order?: number | null;
  created_at?: string | null;
}

interface ReportApprovalEntry {
  approved: boolean;
  approved_by_name?: string;
  approved_by_title?: string;
  company_name?: string;
  approved_at?: string;
}

type ReportApprovals = Record<string, ReportApprovalEntry>;

interface AdminItemSection {
  included: boolean;
  admin_text: string;
  order: number;
}

interface AdminSectionsDocument {
  version: 1;
  summary: string;
  main_cause: string;
  scope: string;
  items: Record<string, AdminItemSection>;
  recommendations: string;
  consequences: string;
  limitations: string;
}

type ClosureType = "avsluttet" | "vedlikehold" | "garanti";

interface AdminReportReviewProps {
  inquiryId: number;
  customerName?: string;
  address?: string;
  onBack?: () => void;
  onChanged?: () => void;
}

function statusLabel(status?: ReportStatus) {
  switch (status) {
    case "utkast":
      return "Utkast hos prosjektansvarlig";
    case "sendt_til_admin":
      return "Venter på admin";
    case "under_gjennomgang":
      return "Under gjennomgang";
    case "returnert_til_prosjektansvarlig":
      return "Returnert til prosjektansvarlig";
    case "godkjent":
      return "Godkjent";
    case "publisert":
      return "Publisert til kunde";
    default:
      return "Ingen rapport";
  }
}

function statusClass(status?: ReportStatus) {
  switch (status) {
    case "sendt_til_admin":
      return "bg-orange-500/10 text-orange-300 border-orange-500/30";
    case "under_gjennomgang":
      return "bg-blue-500/10 text-blue-300 border-blue-500/30";
    case "returnert_til_prosjektansvarlig":
      return "bg-red-500/10 text-red-300 border-red-500/30";
    case "godkjent":
      return "bg-emerald-500/10 text-emerald-300 border-emerald-500/30";
    case "publisert":
      return "bg-cyan-500/10 text-cyan-300 border-cyan-500/30";
    default:
      return "bg-[#43202b] text-[#efdae2] border-[#754453]";
  }
}

function tgClass(status?: string) {
  switch ((status || "").toLowerCase()) {
    case "tg3":
      return "bg-red-500/10 text-red-300 border-red-500/30";
    case "tg2":
      return "bg-orange-500/10 text-orange-300 border-orange-500/30";
    case "tg1":
      return "bg-amber-500/10 text-amber-300 border-amber-500/30";
    case "tg0":
      return "bg-emerald-500/10 text-emerald-300 border-emerald-500/30";
    case "ikke_aktuell":
      return "bg-[#43202b] text-[#d7bfca] border-[#754453]";
    default:
      return "bg-blue-500/10 text-blue-300 border-blue-500/30";
  }
}

function normalizeItemKey(row: ChecklistRow): string {
  return String(row.item_id || row.category || row.id);
}

function boolValue(value: PhotoData["include_in_report"]): boolean {
  return value === true || value === 1 || value === "1";
}

function extractNumberedSection(text: string, number: number): string {
  if (!text.trim()) return "";

  const normalized = text.replace(/\r\n/g, "\n");
  const startPattern = new RegExp(
    `(?:^|\\n)\\s*${number}\\.\\s+[^\\n]*\\n`,
    "i"
  );
  const match = startPattern.exec(normalized);
  if (!match) return "";

  const start = (match.index || 0) + match[0].length;
  const rest = normalized.slice(start);
  const next = /\n\s*\d+\.\s+[A-ZÆØÅ0-9]/.exec(rest);
  return (next ? rest.slice(0, next.index) : rest).trim();
}

/** Match chapter by title rather than chapter number (legacy reports have different numbering). */
function extractSectionByHeading(text: string, titlePattern: RegExp): string {
  const normalized = text.replace(/\r\n/g, "\n");
  const lines = normalized.split("\n");
  let start = -1;
  for (let i = 0; i < lines.length; i++) {
    const title = lines[i].trim().replace(/^\d+\.\s*/, "");
    if (titlePattern.test(title)) { start = i + 1; break; }
  }
  if (start < 0) return "";
  let end = lines.length;
  for (let i = start; i < lines.length; i++) {
    if (/^\s*\d+\.\s+\S/.test(lines[i])) { end = i; break; }
  }
  return lines.slice(start, end).join("\n").trim();
}

function createInitialSections(
  report: ReportData | null,
  rows: ChecklistRow[]
): AdminSectionsDocument {
  const source = report?.admin_final || report?.ai_draft || "";
  const items: Record<string, AdminItemSection> = {};

  rows.forEach((row, index) => {
    const key = normalizeItemKey(row);
    items[key] = {
      included: (row.status || "").toLowerCase() !== "ikke_aktuell",
      admin_text: (row.comment || "").trim(),
      order: index,
    };
  });

  const base: AdminSectionsDocument = {
    version: 1,
    summary: extractSectionByHeading(source, /^SAMMENDRAG OG HOVEDKONKLUSJON$/i) || extractNumberedSection(source, 1),
    main_cause: extractSectionByHeading(source, /^(?:HOVEDÅRSAK TIL LEKKASJEN|SANNSYNLIG HOVEDÅRSAK TIL LEKKASJEN)$/i),
    scope: extractSectionByHeading(source, /^OPPDRAG OG OMFANG$/i),
    items,
    recommendations: extractSectionByHeading(source, /^ANBEFALTE TILTAK$/i),
    consequences: extractSectionByHeading(source, /^KONSEKVENSER VED UTSATT UTBEDRING$/i),
    limitations: extractSectionByHeading(source, /^FORBEHOLD OG BEGRENSNINGER$/i),
  };

  if (!report?.admin_sections_json) return base;

  try {
    const parsed = JSON.parse(report.admin_sections_json);

    if (parsed && parsed.version === 1 && parsed.items) {
      return {
        ...base,
        ...parsed,
        version: 1,
        main_cause: String(parsed.main_cause ?? base.main_cause),
        items: {
          ...base.items,
          ...(parsed.items || {}),
        },
      };
    }

    // Bakoverkompatibilitet med en enkel objektstruktur per kontrollpunkt.
    if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
      const legacyItems: Record<string, AdminItemSection> = {};
      Object.entries(parsed).forEach(([key, value], index) => {
        if (!value || typeof value !== "object") return;
        const item = value as Partial<AdminItemSection>;
        legacyItems[key] = {
          included: item.included !== false,
          admin_text: String(item.admin_text || ""),
          order: Number.isFinite(Number(item.order))
            ? Number(item.order)
            : index,
        };
      });

      return {
        ...base,
        items: {
          ...base.items,
          ...legacyItems,
        },
      };
    }
  } catch {
    // Hvis gammel/ugyldig JSON finnes, behold trygg lokal standard.
  }

  return base;
}

function buildAdminFinal(
  sections: AdminSectionsDocument,
  rows: ChecklistRow[]
): string {
  const includedRows = rows
    .map((row, index) => ({
      row,
      index,
      key: normalizeItemKey(row),
      section: sections.items[normalizeItemKey(row)],
    }))
    .filter(({ section }) => section?.included)
    .sort(
      (a, b) =>
        (a.section?.order ?? a.index) - (b.section?.order ?? b.index)
    );

  const registered =
    includedRows.length > 0
      ? includedRows
          .map(({ row, section }) => {
            const status = (row.status || "").toUpperCase();
            const text = section?.admin_text?.trim();
            return [
              `- ${row.item_title}${status ? ` (${status})` : ""}`,
              text ? `  ${text}` : "",
            ].join("\n");
          })
          .join("\n\n")
      : "Ingen kontrollpunkter er valgt for sluttversjonen.";

  const parts = [
    ["1. SAMMENDRAG OG HOVEDKONKLUSJON", sections.summary],
    ["2. HOVEDÅRSAK TIL LEKKASJEN", sections.main_cause],
    ["3. OPPDRAG OG OMFANG", sections.scope],
    ["4. REGISTRERTE FORHOLD OG FAGLIG VURDERING", registered],
    ["5. ANBEFALTE TILTAK", sections.recommendations],
    ["6. KONSEKVENSER VED UTSATT UTBEDRING", sections.consequences],
    ["7. FORBEHOLD OG BEGRENSNINGER", sections.limitations],
  ];

  return parts
    .map(([heading, body]) => `${heading}\n${(body || "").trim()}`)
    .join("\n\n")
    .trim();
}

export default function AdminReportReview({
  inquiryId,
  customerName,
  address,
  onBack,
  onChanged,
}: AdminReportReviewProps) {
  const [report, setReport] = useState<ReportData | null>(null);
  const [approvalLocked, setApprovalLocked] = useState(false);
  const [completionReport, setCompletionReport] =
    useState<CompletionReportData | null>(null);
  const [completionDraft, setCompletionDraft] = useState("");
  const [reportApprovals, setReportApprovals] = useState<ReportApprovals>({});
  const [completionApprovals, setCompletionApprovals] = useState<ReportApprovals>({});
  const [approvalBusy, setApprovalBusy] = useState<string | null>(null);
  const [completionReturnNote, setCompletionReturnNote] = useState("");
  const [completionSaving, setCompletionSaving] = useState(false);
  const [completionPdfBusy, setCompletionPdfBusy] = useState(false);
  const [completionReturning, setCompletionReturning] = useState(false);
  const [completionApproving, setCompletionApproving] = useState(false);
  const [completionPublishing, setCompletionPublishing] = useState(false);
  const [showClosureDialog, setShowClosureDialog] = useState(false);
  const [closureType, setClosureType] = useState<ClosureType>("avsluttet");
  const [maintenanceInterval, setMaintenanceInterval] = useState("kontroll_12m");
  const [closureReason, setClosureReason] = useState("");
  const [closureSaving, setClosureSaving] = useState(false);
  const [closureError, setClosureError] = useState("");
  const [closureResult, setClosureResult] = useState("");
  const [checklistRows, setChecklistRows] = useState<ChecklistRow[]>([]);
  const [photos, setPhotos] = useState<PhotoData[]>([]);
  const [adminSections, setAdminSections] =
    useState<AdminSectionsDocument | null>(null);
  const [lastSavedSections, setLastSavedSections] = useState("");
  const [returnNote, setReturnNote] = useState("");

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [generatingPdf, setGeneratingPdf] = useState(false);
  const [returning, setReturning] = useState(false);
  const [reopening, setReopening] = useState(false);
  const [savingPhotoId, setSavingPhotoId] = useState<number | null>(null);

  const [error, setError] = useState("");
  const [message, setMessage] = useState("");
  const [showOriginal, setShowOriginal] = useState(false);
  const [lightboxUrl, setLightboxUrl] = useState("");
  const [expandedItems, setExpandedItems] = useState<Record<string, boolean>>(
    {}
  );
  const [openTranscripts, setOpenTranscripts] = useState<
    Record<number, boolean>
  >({});

  const editable = useMemo(
    () =>
      !approvalLocked && (
      report?.status === "sendt_til_admin" ||
      report?.status === "under_gjennomgang" ||
      report?.status === "godkjent"),
    [report?.status, approvalLocked]
  );
  const pdfSrc = report?.pdf_url ? apiAssetUrl(report.pdf_url) : "";

  const adminText = useMemo(
    () =>
      adminSections
        ? buildAdminFinal(adminSections, checklistRows)
        : report?.admin_final || report?.ai_draft || "",
    [adminSections, checklistRows, report?.admin_final, report?.ai_draft]
  );

  const serializedSections = useMemo(
    () => (adminSections ? JSON.stringify(adminSections) : ""),
    [adminSections]
  );

  const hasUnsavedChanges =
    Boolean(adminSections) && serializedSections !== lastSavedSections;

  const selectedPhotoCount = useMemo(
    () => photos.filter((photo) => boolValue(photo.include_in_report)).length,
    [photos]
  );

  const photosByItem = useMemo(() => {
    const map: Record<string, PhotoData[]> = {};
    photos.forEach((photo) => {
      const key = String(photo.checklist_item_id || "__other__");
      if (!map[key]) map[key] = [];
      map[key].push(photo);
    });
    return map;
  }, [photos]);

  const loadReviewData = async () => {
    setLoading(true);
    setError("");

    try {
      const [reportRes, completionRes, checklistRes, photoRes] = await Promise.all([
        fetch(apiUrl(`/reports.php?inquiry_id=${inquiryId}`), { credentials: "include" }),
        fetch(apiUrl(`/completion_reports.php?inquiry_id=${inquiryId}`)),
        fetch(apiUrl(`/checklists.php?inquiry_id=${inquiryId}`)),
        fetch(apiUrl(`/photos.php?inquiry_id=${inquiryId}`)),
      ]);

      const [reportData, completionData, checklistData, photoData] =
        await Promise.all([
          reportRes.json(),
          completionRes.json(),
          checklistRes.json(),
          photoRes.json(),
        ]);

      if (!reportRes.ok || !reportData.success) {
        throw new Error(reportData.message || "Kunne ikke hente rapporten.");
      }

      const nextReport: ReportData | null = reportData.report || null;
      const nextCompletionReport: CompletionReportData | null =
        completionRes.ok && completionData.success
          ? completionData.report || null
          : null;

      setCompletionReport(nextCompletionReport);
      setCompletionDraft(
        nextCompletionReport?.admin_final ||
          nextCompletionReport?.ai_draft ||
          ""
      );
      setCompletionReturnNote(nextCompletionReport?.admin_notes || "");

      const nextRows: ChecklistRow[] =
        checklistRes.ok &&
        checklistData.success &&
        Array.isArray(checklistData.checklists)
          ? checklistData.checklists
          : [];
      const nextPhotos: PhotoData[] =
        photoRes.ok && photoData.success && Array.isArray(photoData.photos)
          ? photoData.photos
          : [];

      setReport(nextReport);
      setChecklistRows(nextRows);
      setPhotos(nextPhotos);
      setReturnNote(nextReport?.admin_notes || "");

      const nextSections = createInitialSections(nextReport, nextRows);
      setAdminSections(nextSections);
      setLastSavedSections(JSON.stringify(nextSections));

      const initialExpanded: Record<string, boolean> = {};
      nextRows.forEach((row, index) => {
        const key = normalizeItemKey(row);
        initialExpanded[key] =
          index === 0 ||
          ["tg2", "tg3"].includes((row.status || "").toLowerCase());
      });
      setExpandedItems(initialExpanded);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke hente rapportgrunnlaget."
      );
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    if (inquiryId > 0) void loadReviewData();
  }, [inquiryId]);

  const loadReportApprovals = async (
    reportType: "rapport1" | "rapport2",
    reportId: number
  ) => {
    if (!reportId) return {};

    const res = await fetch(
      apiUrl(
        `/report_approvals.php?report_type=${encodeURIComponent(
          reportType
        )}&report_id=${reportId}&inquiry_id=${inquiryId}`
      )
    );
    const data = await res.json();

    if (!res.ok || !data.success) {
      throw new Error(data.message || "Kunne ikke hente faglige godkjenninger.");
    }

    return (data.approvals || {}) as ReportApprovals;
  };

  const setReportApproval = async (
    reportType: "rapport1" | "rapport2",
    reportId: number,
    approvalKey: "field_execution" | "report_review" | "work_lead",
    approved: boolean
  ) => {
    const busyKey = `${reportType}-${approvalKey}`;
    setApprovalBusy(busyKey);
    setError("");
    setMessage("");

    try {
      const res = await fetch(apiUrl("/report_approvals.php"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          report_type: reportType,
          report_id: reportId,
          inquiry_id: inquiryId,
          approval_key: approvalKey,
          approved,
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke oppdatere godkjenningen.");
      }

      const nextApprovals = (data.approvals || {}) as ReportApprovals;

      if (reportType === "rapport1") {
        setReportApprovals(nextApprovals);
      } else {
        setCompletionApprovals(nextApprovals);
      }

      setMessage(
        approved
          ? "Faglig godkjenning er registrert. Oppdater PDF for å få godkjenningen inn i rapporten."
          : "Godkjenningen er trukket tilbake. Oppdater PDF før publisering."
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke oppdatere godkjenningen."
      );
    } finally {
      setApprovalBusy(null);
    }
  };

  useEffect(() => {
    if (!report?.id) {
      setReportApprovals({});
      return;
    }

    void loadReportApprovals("rapport1", report.id)
      .then(setReportApprovals)
      .catch((err) =>
        setError(
          err instanceof Error
            ? err.message
            : "Kunne ikke hente godkjenninger for Rapport 1."
        )
      );
  }, [report?.id, inquiryId]);

  useEffect(() => {
    if (!completionReport?.id) {
      setCompletionApprovals({});
      return;
    }

    void loadReportApprovals("rapport2", completionReport.id)
      .then(setCompletionApprovals)
      .catch((err) =>
        setError(
          err instanceof Error
            ? err.message
            : "Kunne ikke hente godkjenninger for Rapport 2."
        )
      );
  }, [completionReport?.id, inquiryId]);

  const report1FieldApproved = Boolean(reportApprovals.field_execution?.approved);
  const report1ReviewApproved = Boolean(reportApprovals.report_review?.approved);
  const report1FullyApproved = report1FieldApproved && report1ReviewApproved;
  const report2WorkLeadApproved = Boolean(completionApprovals.work_lead?.approved);

  const completionReportIsAdminFlow =
    completionReport &&
    [
      "sendt_til_admin",
      "under_gjennomgang",
      "godkjent",
      "publisert",
    ].includes(completionReport.status);

  const updateCompletionReport = async (
    payload: Record<string, unknown>,
    successMessage = ""
  ): Promise<CompletionReportData> => {
    const res = await fetch(apiUrl("/completion_reports.php"), {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        inquiry_id: inquiryId,
        ...payload,
      }),
    });

    const data = await res.json();
    if (!res.ok || !data.success || !data.report) {
      throw new Error(
        data.message || "Kunne ikke oppdatere utførelsesrapporten."
      );
    }

    const nextReport = data.report as CompletionReportData;
    setCompletionReport(nextReport);
    setCompletionDraft(
      nextReport.admin_final || nextReport.ai_draft || completionDraft
    );
    setCompletionReturnNote(nextReport.admin_notes || "");

    if (successMessage) setMessage(successMessage);
    onChanged?.();
    return nextReport;
  };

  const handleCompletionSave = async () => {
    if (!completionReport || !completionDraft.trim()) return;
    setCompletionSaving(true);
    setError("");
    setMessage("");

    try {
      await updateCompletionReport(
        {
          admin_final: completionDraft.trim(),
          status:
            completionReport.status === "sendt_til_admin"
              ? "under_gjennomgang"
              : completionReport.status,
        },
        "Admins sluttversjon av utførelsesrapporten er lagret."
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke lagre utførelsesrapporten."
      );
    } finally {
      setCompletionSaving(false);
    }
  };

  const handleCompletionPdf = async () => {
    if (!completionReport || !completionDraft.trim()) return;
    setCompletionPdfBusy(true);
    setError("");
    setMessage("");

    try {
      await updateCompletionReport({
        admin_final: completionDraft.trim(),
        status:
          completionReport.status === "sendt_til_admin"
            ? "under_gjennomgang"
            : completionReport.status,
      });

      const res = await fetch(apiUrl("/generate_completion_report_pdf.php"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ inquiry_id: inquiryId }),
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke generere PDF for utførelsesrapporten."
        );
      }

      if (data.report) {
        setCompletionReport(data.report);
      } else {
        await loadReviewData();
      }

      setMessage("PDF-forhåndsvisningen for utførelsesrapporten er oppdatert.");
      onChanged?.();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke generere Utførelsesrapport-PDF."
      );
    } finally {
      setCompletionPdfBusy(false);
    }
  };

  const handleCompletionReturn = async () => {
    if (!completionReturnNote.trim()) {
      setError("Skriv en kommentar før utførelsesrapporten returneres.");
      return;
    }

    if (
      !window.confirm(
        "Returnere utførelsesrapporten til prosjektansvarlig for korrigering?"
      )
    ) {
      return;
    }

    setCompletionReturning(true);
    setError("");
    setMessage("");

    try {
      await updateCompletionReport(
        {
          admin_final: completionDraft.trim(),
          admin_notes: completionReturnNote.trim(),
          status: "returnert_til_prosjektansvarlig",
        },
        "Utførelsesrapporten er returnert til prosjektansvarlig."
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke returnere utførelsesrapporten."
      );
    } finally {
      setCompletionReturning(false);
    }
  };

  const handleCompletionApprove = async () => {
    if (!completionDraft.trim()) return;

    setCompletionApproving(true);
    setError("");
    setMessage("");

    try {
      const next = await updateCompletionReport(
        {
          admin_final: completionDraft.trim(),
          status: "godkjent",
        },
        "Utførelsesrapporten er godkjent."
      );

      if (!next.pdf_url) {
        setMessage(
          "Utførelsesrapporten er godkjent. Generer PDF før publisering."
        );
      }
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke godkjenne utførelsesrapporten."
      );
    } finally {
      setCompletionApproving(false);
    }
  };

  const handleCompletionPublish = async () => {
    if (!completionReport || !completionDraft.trim()) return;

    if (!completionReport.pdf_url) {
      setError("Generer Utførelsesrapport-PDF før publisering.");
      return;
    }

    if (!window.confirm("Publisere utførelsesrapporten til kunden nå?")) {
      return;
    }

    setCompletionPublishing(true);
    setError("");
    setMessage("");

    try {
      await updateCompletionReport(
        {
          admin_final: completionDraft.trim(),
          status: "publisert",
        },
        "Utførelsesrapporten er publisert til kunden."
      );

      setClosureType("avsluttet");
      setMaintenanceInterval("kontroll_12m");
      setClosureReason("");
      setClosureError("");
      setClosureResult("");
      setShowClosureDialog(true);
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke publisere utførelsesrapporten."
      );
    } finally {
      setCompletionPublishing(false);
    }
  };

  const handleCloseInquiry = async () => {
    setClosureSaving(true);
    setClosureError("");

    try {
      const payload: Record<string, unknown> = {
        inquiry_id: inquiryId,
        closure_type: closureType,
        reason: closureReason.trim(),
      };

      if (closureType === "vedlikehold") {
        payload.maintenance_interval = maintenanceInterval;
      }

      const res = await fetch(apiUrl("/close_inquiry.php"), {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke avslutte arbeidsoppdraget.");
      }

      const successText =
        data.message ||
        (closureType === "garanti"
          ? "Arbeidsoppdraget er avsluttet og overført til garanti."
          : closureType === "vedlikehold"
          ? "Arbeidsoppdraget er avsluttet og overført til vedlikehold."
          : "Arbeidsoppdraget er avsluttet.");

      setClosureResult(successText);
      setMessage(successText);
      setShowClosureDialog(false);
      onChanged?.();
    } catch (err) {
      setClosureError(
        err instanceof Error
          ? err.message
          : "Kunne ikke avslutte arbeidsoppdraget."
      );
    } finally {
      setClosureSaving(false);
    }
  };

  const updateReport = async (
    payload: Record<string, unknown>,
    successMessage: string
  ): Promise<ReportData> => {
    const res = await fetch(apiUrl("/reports.php"), {
      credentials: "include", method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        inquiry_id: inquiryId,
        ...payload,
      }),
    });

    const data = await res.json();

    if (!res.ok || !data.success) {
      throw new Error(data.message || "Kunne ikke oppdatere rapporten.");
    }

    const nextReport: ReportData = data.report;
    setReport(nextReport);
    setReturnNote(nextReport.admin_notes || "");

    if (nextReport.admin_sections_json) {
      const nextSections = createInitialSections(nextReport, checklistRows);
      setAdminSections(nextSections);
      setLastSavedSections(JSON.stringify(nextSections));
    } else if (adminSections && "admin_sections_json" in payload) {
      setLastSavedSections(JSON.stringify(adminSections));
    }

    if (successMessage) setMessage(successMessage);
    onChanged?.();
    return nextReport;
  };

  const saveAdminVersion = async (silent = false) => {
    if (!report || !adminSections || !adminText.trim()) {
      throw new Error("Admins sluttversjon kan ikke være tom.");
    }

    return updateReport(
      {
        admin_final: adminText.trim(),
        admin_sections_json: adminSections,
        status:
          report.status === "sendt_til_admin"
            ? "under_gjennomgang"
            : report.status,
      },
      silent ? "" : "Admins punktvise sluttversjon er lagret."
    );
  };

  const handleSave = async () => {
    setSaving(true);
    setError("");
    setMessage("");
    try {
      await saveAdminVersion();
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Kunne ikke lagre rapporten."
      );
    } finally {
      setSaving(false);
    }
  };

  const handleGeneratePdf = async () => {
    if (!adminText.trim()) return;

    setGeneratingPdf(true);
    setError("");
    setMessage("");

    try {
      if (report?.status !== "godkjent") await saveAdminVersion(true);

      const res = await fetch(apiUrl("/generate_report_pdf.php"), {
        credentials: "include", method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: inquiryId,
          admin_mode: true,
        }),
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(data.message || "Kunne ikke generere admin-PDF.");
      }

      if (data.report) {
        setReport(data.report);
      } else {
        const reportRes = await fetch(
          apiUrl(`/reports.php?inquiry_id=${inquiryId}`)
        );
        const reportData = await reportRes.json();
        if (reportRes.ok && reportData.success) {
          setReport(reportData.report || null);
        }
      }

      setMessage("PDF er oppdatert med admins tekst- og bildevalg.");
      onChanged?.();
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Kunne ikke generere PDF."
      );
    } finally {
      setGeneratingPdf(false);
    }
  };

  const handleReturn = async () => {
    if (!returnNote.trim()) {
      setError(
        "Skriv en kommentar til prosjektansvarlig før rapporten returneres."
      );
      return;
    }

    if (
      !window.confirm(
        "Returnere rapporten til prosjektansvarlig for korrigering?"
      )
    ) {
      return;
    }

    setReturning(true);
    setError("");
    setMessage("");

    try {
      await updateReport(
        {
          admin_final: adminText.trim(),
          admin_sections_json: adminSections,
          admin_notes: returnNote.trim(),
          status: "returnert_til_prosjektansvarlig",
        },
        "Rapporten er returnert til prosjektansvarlig."
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke returnere rapporten."
      );
    } finally {
      setReturning(false);
    }
  };

  const handleReopenPublished = async () => {
    if (!report || report.status !== "publisert") return;
    if (
      !window.confirm(
        "Åpne publisert rapport for korrigering? Kunden beholder sist publiserte versjon frem til ny publisering."
      )
    ) {
      return;
    }

    setReopening(true);
    setError("");
    setMessage("");

    try {
      const res = await fetch(apiUrl("/reports.php"), {
        credentials: "include", method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: inquiryId,
          action: "start_correction",
        }),
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke åpne rapporten for korrigering."
        );
      }

      await loadReviewData();
      setMessage("Rapporten er åpnet for korrigering.");
      onChanged?.();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke åpne rapporten for korrigering."
      );
    } finally {
      setReopening(false);
    }
  };

  const updateGlobalSection = (
    field:
      | "summary"
      | "main_cause"
      | "scope"
      | "recommendations"
      | "consequences"
      | "limitations",
    value: string
  ) => {
    setAdminSections((current) =>
      current ? { ...current, [field]: value } : current
    );
  };

  const updateItemSection = (
    key: string,
    patch: Partial<AdminItemSection>
  ) => {
    setAdminSections((current) => {
      if (!current) return current;
      const existing = current.items[key] || {
        included: true,
        admin_text: "",
        order: Object.keys(current.items).length,
      };
      return {
        ...current,
        items: {
          ...current.items,
          [key]: {
            ...existing,
            ...patch,
          },
        },
      };
    });
  };

  const invalidatePdfAfterDocumentationChange = async () => {
    try {
      const res = await fetch(apiUrl("/reports.php"), {
        credentials: "include", method: "PUT",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: inquiryId,
          pdf_url: "",
        }),
      });
      const data = await res.json();
      if (res.ok && data.success && data.report) {
        setReport(data.report);
      } else {
        setReport((current) =>
          current ? { ...current, pdf_url: null } : current
        );
      }
    } catch {
      setReport((current) =>
        current ? { ...current, pdf_url: null } : current
      );
    }
  };

  const togglePhotoForReport = async (
    photo: PhotoData,
    include: boolean
  ) => {
    setSavingPhotoId(photo.id);
    setError("");
    setMessage("");

    try {
      const formData = new FormData();
      formData.append("photo_id", String(photo.id));
      formData.append("inquiry_id", String(inquiryId));
      formData.append("include_in_report", include ? "1" : "0");
      formData.append("caption_text", photo.caption_text || "");
      if (
        photo.report_sort_order !== null &&
        photo.report_sort_order !== undefined
      ) {
        formData.append(
          "report_sort_order",
          String(photo.report_sort_order)
        );
      } else {
        formData.append("report_sort_order", "");
      }

      const res = await fetch(apiUrl("/photos.php"), {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke oppdatere bildevalget."
        );
      }

      const updated: PhotoData = data.photo || {
        ...photo,
        include_in_report: include ? 1 : 0,
      };

      setPhotos((current) =>
        current.map((item) => (item.id === photo.id ? updated : item))
      );

      await invalidatePdfAfterDocumentationChange();
      setMessage(
        include
          ? "Bildet er valgt inn i rapporten. Oppdater PDF når du er klar."
          : "Bildet er tatt ut av rapporten. Oppdater PDF når du er klar."
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke oppdatere bildevalget."
      );
    } finally {
      setSavingPhotoId(null);
    }
  };

  const toggleExpanded = (key: string) => {
    setExpandedItems((current) => ({
      ...current,
      [key]: !current[key],
    }));
  };

  if (loading) {
    return (
      <div className="min-h-screen bg-[#270b13] text-white flex items-center justify-center p-8">
        <div className="w-full max-w-[560px] rounded-3xl border border-[#653444] bg-[#32121d] p-10 text-center shadow-2xl">
          <Loader2 className="w-7 h-7 animate-spin text-[#F5B800] mx-auto" />
          <p className="mt-4 text-sm font-bold text-[#efdae2]">Henter rapportgrunnlag</p>
          <p className="mt-1 text-xs text-[#c8acb7]">Rapport, kontrollpunkter og dokumentasjon lastes inn…</p>
        </div>
      </div>
    );
  }

  if (completionReportIsAdminFlow && completionReport) {
    const completionPdfSrc = completionReport.pdf_url
      ? apiAssetUrl(completionReport.pdf_url)
      : "";
    const completionEditable =
      completionReport.status === "sendt_til_admin" ||
      completionReport.status === "under_gjennomgang" ||
      completionReport.status === "godkjent";

    return (
      <div className="min-h-screen bg-[#270b13] text-white">
        <header className="sticky top-0 z-40 border-b border-cyan-500/20 bg-[#1b0b12] px-6 py-4">
          <div className="mx-auto flex max-w-[1600px] items-center justify-between gap-4">
            <div>
              <p className="text-[10px] font-black uppercase tracking-wider text-cyan-400">
                Admin kvalitetssikring · Utførelsesrapport
              </p>
              <h1 className="mt-1 text-lg font-extrabold">
                Utførelsesrapport #{completionReport.id} · Oppdrag #{inquiryId}
              </h1>
              <p className="mt-1 text-xs text-[#d7bfca]">
                {[customerName, address].filter(Boolean).join(" · ")}
              </p>
            </div>

            {onBack && (
              <button
                type="button"
                onClick={() => onBack()}
                className="flex items-center gap-2 rounded-xl border border-[#754453] bg-[#341722] px-4 py-2.5 text-xs font-bold text-[#efdae2] hover:text-white"
              >
                <ArrowLeft className="h-4 w-4" />
                Tilbake til rapporter
              </button>
            )}
          </div>
        </header>

        <main className="mx-auto max-w-[1600px] space-y-5 px-4 py-6 md:px-8">
          <section className="rounded-2xl border border-cyan-500/25 bg-[#32121d] px-5 py-4">
            <div className="flex flex-col justify-between gap-4 xl:flex-row xl:items-center">
              <div>
                <div className="flex flex-wrap items-center gap-2">
                  <h2 className="flex items-center gap-2 text-base font-extrabold">
                    <FileText className="h-5 w-5 text-cyan-400" />
                    Utførelsesrapport
                  </h2>
                  <span
                    className={`rounded-full border px-3 py-1 text-[10px] font-black uppercase ${statusClass(
                      completionReport.status
                    )}`}
                  >
                    {statusLabel(completionReport.status)}
                  </span>
                </div>
                <p className="mt-1 text-xs text-[#d7bfca]">
                  Den tekniske rapporten beholdes som historikk. Her kvalitetssikres ny tilstand,
                  utført arbeid og nye TG-verdier etter service.
                </p>
              </div>

              <div className="flex flex-wrap gap-2 text-[10px]">
                <span className="rounded-xl border border-[#653444] bg-[#1b0b12] px-3 py-2 text-[#d7bfca]">
                  Kilde teknisk rapport: #{completionReport.source_report_id}
                </span>
                <span className="rounded-xl border border-[#653444] bg-[#1b0b12] px-3 py-2 text-[#d7bfca]">
                  Arbeid: #{completionReport.work_completion_id}
                </span>
                <span className="rounded-xl border border-[#653444] bg-[#1b0b12] px-3 py-2 text-[#d7bfca]">
                  Revisjon {completionReport.revision_no || 1}
                </span>
              </div>
            </div>
          </section>

          {error && (
            <div className="flex gap-2 rounded-2xl border border-red-500/30 bg-red-500/10 px-5 py-4 text-xs text-red-300">
              <AlertTriangle className="h-4 w-4 shrink-0" />
              {error}
            </div>
          )}

          {message && (
            <div className="flex gap-2 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-3 text-xs text-emerald-300">
              <CheckCircle2 className="h-4 w-4 shrink-0" />
              {message}
            </div>
          )}

          <section className="grid grid-cols-1 items-start gap-5 xl:grid-cols-[minmax(0,1.05fr)_minmax(460px,0.95fr)]">
            <div className="space-y-4">
              <section className="overflow-hidden rounded-2xl border border-[#653444] bg-[#32121d]">
                <div className="border-b border-[#653444] px-5 py-4">
                  <p className="text-[10px] font-black uppercase tracking-wider text-cyan-400">
                    Admins sluttversjon
                  </p>
                  <p className="mt-1 text-[11px] text-[#c8acb7]">
                    Kontroller at utført arbeid og ny TG stemmer med feltregistreringen.
                    Teknisk rapport skal ikke overskrives.
                  </p>
                </div>

                <div className="p-5">
                  <textarea
                    value={completionDraft}
                    onChange={(event) =>
                      setCompletionDraft(event.target.value)
                    }
                    readOnly={
                      !completionEditable ||
                      completionReport.status === "publisert"
                    }
                    rows={34}
                    className="w-full resize-y rounded-2xl border border-[#653444] bg-[#1b0b12] p-4 text-xs leading-6 text-slate-200 outline-none focus:border-cyan-500/50 read-only:opacity-75"
                  />
                </div>
              </section>

              <section className="rounded-2xl border border-[#653444] bg-[#32121d] p-5">
                <p className="text-[10px] font-black uppercase tracking-wider text-[#c8acb7]">
                  Kommentar ved retur
                </p>
                <textarea
                  value={completionReturnNote}
                  onChange={(event) =>
                    setCompletionReturnNote(event.target.value)
                  }
                  disabled={completionReport.status === "publisert"}
                  rows={4}
                  placeholder="Beskriv hva prosjektansvarlig må korrigere i Utførelsesrapport..."
                  className="mt-3 w-full rounded-2xl border border-[#653444] bg-[#1b0b12] p-4 text-xs text-slate-200 outline-none focus:border-red-500/40 disabled:opacity-50"
                />
              </section>
            </div>

            <aside className="overflow-hidden rounded-3xl border border-[#653444] bg-[#32121d] xl:sticky xl:top-[96px]">
              <div className="flex items-center justify-between gap-3 border-b border-[#653444] px-5 py-4">
                <div>
                  <p className="text-[10px] font-black uppercase tracking-wider text-cyan-400">
                    Utførelsesrapport · PDF
                  </p>
                  <p className="mt-1 text-[11px] text-[#c8acb7]">
                    Samme godkjenningskrav som Teknisk rapport.
                  </p>
                </div>

                {completionReport.status !== "publisert" && (
                  <button
                    type="button"
                    onClick={handleCompletionPdf}
                    disabled={
                      completionPdfBusy || !completionDraft.trim() || !report2WorkLeadApproved
                    }
                    className="flex items-center gap-2 rounded-xl border border-[#754453] bg-[#341722] px-3.5 py-2 text-xs font-extrabold disabled:opacity-50"
                  >
                    {completionPdfBusy ? (
                      <Loader2 className="h-4 w-4 animate-spin" />
                    ) : (
                      <RefreshCw className="h-4 w-4" />
                    )}
                    {completionReport.pdf_url ? "Oppdater PDF" : "Generer PDF"}
                  </button>
                )}
              </div>

              {completionPdfSrc ? (
                <iframe
                  key={completionReport.pdf_url || "completion-report-pdf"}
                  title="Utførelsesrapport PDF"
                  src={completionPdfSrc}
                  className="h-[calc(100vh-250px)] min-h-[720px] w-full bg-white"
                />
              ) : (
                <div className="flex h-[calc(100vh-250px)] min-h-[720px] flex-col items-center justify-center px-8 text-center">
                  <FileText className="mb-3 h-10 w-10 text-slate-700" />
                  <p className="text-sm font-extrabold text-[#efdae2]">
                    PDF må genereres
                  </p>
                  <p className="mt-2 max-w-sm text-xs text-[#c8acb7]">
                    Kontroller utførelsesrapporten, lagre sluttversjonen og generer PDF før publisering.
                  </p>
                </div>
              )}
            </aside>
          </section>

          <section className="rounded-2xl border border-cyan-500/20 bg-cyan-500/[0.04] p-4">
            <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
              <div>
                <p className="text-[10px] font-black uppercase tracking-[0.12em] text-cyan-300">
                  Faglig ansvar · Rapport 2
                </p>
                <p className="mt-1 text-xs font-extrabold text-white">
                  Arbeidsledelse og utførelse
                </p>
                <p className="mt-1 text-[10px] leading-5 text-[#c8acb7]">
                  Når Miroslav godkjenner, vises teksten i PDF-en: «Arbeidet har blitt ledet av bygningsingeniør Miroslav Subanovic og utført av Perun AS.»
                </p>
              </div>

              <button
                type="button"
                onClick={() =>
                  setReportApproval(
                    "rapport2",
                    completionReport.id,
                    "work_lead",
                    !report2WorkLeadApproved
                  )
                }
                disabled={approvalBusy === "rapport2-work_lead" || completionReport.status === "publisert"}
                className={`flex shrink-0 items-center gap-2 rounded-xl border px-4 py-2.5 text-xs font-extrabold disabled:opacity-50 ${
                  report2WorkLeadApproved
                    ? "border-emerald-500/30 bg-emerald-500/10 text-emerald-300"
                    : "border-[#754453] bg-[#341722] text-[#efdae2]"
                }`}
              >
                {approvalBusy === "rapport2-work_lead" ? (
                  <Loader2 className="h-4 w-4 animate-spin" />
                ) : report2WorkLeadApproved ? (
                  <CheckCircle2 className="h-4 w-4" />
                ) : (
                  <ShieldCheck className="h-4 w-4" />
                )}
                {report2WorkLeadApproved ? "Godkjent av Miroslav" : "Miroslav godkjenner"}
              </button>
            </div>
          </section>

          {completionReport.status !== "publisert" ? (
            <section className="sticky bottom-3 z-30 rounded-2xl border border-[#754453] bg-[#1b0b12]/95 p-4 shadow-2xl backdrop-blur">
              <div className="flex flex-col justify-between gap-3 lg:flex-row lg:items-center">
                <div>
                  <p className="text-xs font-bold text-[#efdae2]">
                    Utførelsesrapporten følger samme kontrollflyt som Teknisk rapport.
                  </p>
                  <p className="mt-1 text-[10px] text-[#c8acb7]">
                    Returner ved feil, eller godkjenn og publiser etter at PDF er kontrollert.
                  </p>
                </div>

                <div className="flex flex-wrap justify-end gap-2">
                  <button
                    type="button"
                    onClick={handleCompletionSave}
                    disabled={
                      completionSaving ||
                      !completionDraft.trim() ||
                      !completionEditable
                    }
                    className="flex items-center gap-2 rounded-xl border border-[#754453] bg-[#341722] px-4 py-2.5 text-xs font-extrabold disabled:opacity-50"
                  >
                    {completionSaving ? (
                      <Loader2 className="h-4 w-4 animate-spin" />
                    ) : (
                      <Save className="h-4 w-4" />
                    )}
                    Lagre
                  </button>

                  <button
                    type="button"
                    onClick={handleCompletionReturn}
                    disabled={
                      completionReturning ||
                      !completionReturnNote.trim()
                    }
                    className="flex items-center gap-2 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-2.5 text-xs font-extrabold text-red-300 disabled:opacity-50"
                  >
                    {completionReturning ? (
                      <Loader2 className="h-4 w-4 animate-spin" />
                    ) : (
                      <RotateCcw className="h-4 w-4" />
                    )}
                    Returner
                  </button>

                  {completionReport.status === "godkjent" ? (
                    <button
                      type="button"
                      onClick={handleCompletionPublish}
                      disabled={
                        completionPublishing ||
                        !completionDraft.trim() ||
                        !completionReport.pdf_url ||
                        !report2WorkLeadApproved
                      }
                      className="flex items-center gap-2 rounded-xl bg-[#F5B800] px-5 py-2.5 text-xs font-black text-slate-950 disabled:opacity-50"
                    >
                      {completionPublishing ? (
                        <Loader2 className="h-4 w-4 animate-spin" />
                      ) : (
                        <Send className="h-4 w-4" />
                      )}
                      Publiser utførelsesrapport
                    </button>
                  ) : (
                    <button
                      type="button"
                      onClick={handleCompletionApprove}
                      disabled={
                        completionApproving ||
                        !completionDraft.trim()
                      }
                      className="flex items-center gap-2 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-4 py-2.5 text-xs font-extrabold text-emerald-300 disabled:opacity-50"
                    >
                      {completionApproving ? (
                        <Loader2 className="h-4 w-4 animate-spin" />
                      ) : (
                        <ShieldCheck className="h-4 w-4" />
                      )}
                      Godkjenn utførelsesrapport
                    </button>
                  )}
                </div>
              </div>
            </section>
          ) : (
            <div className="rounded-2xl border border-cyan-500/30 bg-cyan-500/10 p-4">
              <div className="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                <div>
                  <p className="text-xs font-extrabold text-cyan-300">
                    Utførelsesrapporten er publisert til kunden.
                  </p>
                  <p className="mt-1 text-[11px] text-[#d7bfca]">
                    Arbeidet er dokumentert ferdig. Velg avslutning dersom saken ikke allerede er overført til vedlikehold eller garanti.
                  </p>
                  {closureResult && (
                    <p className="mt-2 text-[11px] font-bold text-emerald-300">
                      {closureResult}
                    </p>
                  )}
                </div>
                {!closureResult && (
                  <button
                    type="button"
                    onClick={() => {
                      setClosureError("");
                      setShowClosureDialog(true);
                    }}
                    className="rounded-xl border border-cyan-500/30 bg-cyan-500/10 px-4 py-2.5 text-xs font-extrabold text-cyan-200"
                  >
                    Avslutt arbeidsoppdrag
                  </button>
                )}
              </div>
            </div>
          )}
        </main>

        {showClosureDialog && (
          <div className="fixed inset-0 z-[100] flex items-center justify-center bg-black/75 p-4 backdrop-blur-sm">
            <div className="w-full max-w-2xl overflow-hidden rounded-3xl border border-[#754453] bg-[#32121d] shadow-2xl">
              <div className="flex items-start justify-between gap-4 border-b border-[#653444] px-6 py-5">
                <div>
                  <p className="text-[10px] font-black uppercase tracking-[0.18em] text-cyan-400">
                    Ferdigstilling
                  </p>
                  <h2 className="mt-1 text-xl font-black text-white">
                    Hvordan skal saken følges opp videre?
                  </h2>
                  <p className="mt-2 text-xs leading-5 text-[#d7bfca]">
                    Utførelsesrapporten er publisert. Arbeidsoppdraget skal nå avsluttes og eventuelt overføres til vedlikehold eller garanti.
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => !closureSaving && setShowClosureDialog(false)}
                  className="rounded-xl border border-[#754453] bg-[#341722] p-2 text-[#d7bfca] hover:text-white"
                  aria-label="Lukk"
                >
                  <X className="h-4 w-4" />
                </button>
              </div>

              <div className="space-y-5 p-6">
                {closureError && (
                  <div className="flex gap-2 rounded-2xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-xs text-red-300">
                    <AlertTriangle className="h-4 w-4 shrink-0" />
                    {closureError}
                  </div>
                )}

                <div className="grid gap-3 md:grid-cols-3">
                  {[
                    {
                      value: "avsluttet" as ClosureType,
                      title: "Avslutt",
                      text: "Ingen videre oppfølging er nødvendig.",
                    },
                    {
                      value: "vedlikehold" as ClosureType,
                      title: "Vedlikehold",
                      text: "Opprett ny kontroll eller vedlikeholdsoppfølging.",
                    },
                    {
                      value: "garanti" as ClosureType,
                      title: "Garanti",
                      text: "Avslutt arbeidet og aktiver 5 års garanti med årlig kontroll.",
                    },
                  ].map((option) => (
                    <button
                      key={option.value}
                      type="button"
                      onClick={() => setClosureType(option.value)}
                      className={`rounded-2xl border p-4 text-left transition ${
                        closureType === option.value
                          ? "border-cyan-400/60 bg-cyan-500/10"
                          : "border-[#653444] bg-[#1b0b12] hover:border-[#754453]"
                      }`}
                    >
                      <div className="flex items-center justify-between gap-3">
                        <span className="text-sm font-black text-white">
                          {option.title}
                        </span>
                        <span
                          className={`flex h-5 w-5 items-center justify-center rounded-full border ${
                            closureType === option.value
                              ? "border-cyan-400 bg-cyan-400 text-slate-950"
                              : "border-[#885766]"
                          }`}
                        >
                          {closureType === option.value && (
                            <Check className="h-3.5 w-3.5" />
                          )}
                        </span>
                      </div>
                      <p className="mt-2 text-[11px] leading-5 text-[#c8acb7]">
                        {option.text}
                      </p>
                    </button>
                  ))}
                </div>

                {closureType === "vedlikehold" && (
                  <div className="rounded-2xl border border-[#653444] bg-[#1b0b12] p-4">
                    <label className="block">
                      <span className="text-[11px] font-extrabold text-[#efdae2]">
                        Første vedlikeholdskontroll
                      </span>
                      <select
                        value={maintenanceInterval}
                        onChange={(event) =>
                          setMaintenanceInterval(event.target.value)
                        }
                        className="mt-2 w-full rounded-xl border border-[#754453] bg-[#32121d] px-4 py-3 text-sm text-white outline-none focus:border-cyan-500/50"
                      >
                        <option value="kontroll_3m">Om 3 måneder</option>
                        <option value="kontroll_6m">Om 6 måneder</option>
                        <option value="kontroll_9m">Om 9 måneder</option>
                        <option value="kontroll_12m">Om 12 måneder</option>
                      </select>
                    </label>
                  </div>
                )}

                {closureType === "garanti" && (
                  <div className="flex gap-3 rounded-2xl border border-emerald-500/20 bg-emerald-500/10 p-4">
                    <ShieldCheck className="mt-0.5 h-5 w-5 shrink-0 text-emerald-300" />
                    <div>
                      <p className="text-xs font-black text-emerald-200">
                        5 års garanti · årlig kontroll
                      </p>
                      <p className="mt-1 text-[11px] leading-5 text-emerald-100/60">
                        Saken flyttes til garanti og første årlige kontroll opprettes 12 måneder etter publisering.
                      </p>
                    </div>
                  </div>
                )}

                <label className="block">
                  <span className="text-[11px] font-extrabold text-[#efdae2]">
                    Intern merknad <span className="font-normal text-[#bd9eaa]">(valgfritt)</span>
                  </span>
                  <textarea
                    value={closureReason}
                    onChange={(event) => setClosureReason(event.target.value)}
                    rows={3}
                    placeholder="Eksempel: årlig kontroll av beslag og gjennomføringer."
                    className="mt-2 w-full resize-none rounded-2xl border border-[#653444] bg-[#1b0b12] p-4 text-xs text-slate-200 outline-none focus:border-cyan-500/50"
                  />
                </label>
              </div>

              <div className="flex flex-col-reverse gap-2 border-t border-[#653444] px-6 py-4 sm:flex-row sm:justify-end">
                <button
                  type="button"
                  onClick={() => setShowClosureDialog(false)}
                  disabled={closureSaving}
                  className="rounded-xl border border-[#754453] bg-[#341722] px-4 py-2.5 text-xs font-bold text-[#efdae2] disabled:opacity-50"
                >
                  Gjør dette senere
                </button>
                <button
                  type="button"
                  onClick={handleCloseInquiry}
                  disabled={closureSaving}
                  className="flex items-center justify-center gap-2 rounded-xl bg-[#F5B800] px-5 py-2.5 text-xs font-black text-slate-950 disabled:opacity-50"
                >
                  {closureSaving ? (
                    <Loader2 className="h-4 w-4 animate-spin" />
                  ) : (
                    <CheckCircle2 className="h-4 w-4" />
                  )}
                  Bekreft avslutning
                </button>
              </div>
            </div>
          </div>
        )}
      </div>
    );
  }

  // Rapport 1: etter sluttgodkjenning er dette en lesbar sluttvisning,
  // ikke den punktvise editoren. Core-godkjenningene og eksisterende PDF beholdes urørt.
  if (report && (report.status === "godkjent" || report.status === "publisert")) {
    const published = report.status === "publisert";
    const pmApproval = reportApprovals.field_execution;
    const adminApproval = reportApprovals.report_review;
    const formatApprovalDate = (value?: string) => {
      if (!value) return "";
      const date = new Date(value.replace(" ", "T"));
      return Number.isNaN(date.getTime()) ? "" : date.toLocaleString("nb-NO", { dateStyle: "short", timeStyle: "short" });
    };

    return (
      <div className="min-h-screen bg-[#270b13] px-4 py-6 text-white md:px-8">
        <div className="mx-auto max-w-[1420px] space-y-5">
          <header className="flex flex-wrap items-center justify-between gap-3">
            <div>
              <p className="text-xs font-black uppercase tracking-wider text-emerald-300">Rapport 1 · Ferdig resultat</p>
              <h1 className="mt-1 text-xl font-black">Rapport #{report.id} · Oppdrag #{inquiryId}</h1>
              <p className="mt-1 text-xs text-[#d7bfca]">{[customerName, address].filter(Boolean).join(" · ")}</p>
            </div>
            {onBack && (
              <button type="button" onClick={onBack}
                className="inline-flex items-center gap-2 rounded-xl border border-[#754453] bg-[#341722] px-4 py-2.5 text-xs font-bold text-[#efdae2]">
                <ArrowLeft className="h-4 w-4" /> Tilbake til rapporter
              </button>
            )}
          </header>

          {error && <div role="alert" className="rounded-xl border border-red-500/30 bg-red-500/10 p-4 text-xs text-red-200">{error}</div>}
          {message && <div className="rounded-xl border border-emerald-500/30 bg-emerald-500/10 p-4 text-xs text-emerald-200">{message}</div>}

          <section className="rounded-2xl border border-emerald-500/30 bg-[#182a26] p-5 md:p-6">
            <div className="flex flex-wrap items-center gap-3">
              <CheckCircle2 className="h-7 w-7 text-emerald-300" />
              <div className="flex-1">
                <h2 className="text-lg font-black">{published ? "Rapporten er publisert til kunden" : "Sluttgodkjent – klar for publisering"}</h2>
                <p className="mt-1 text-xs text-emerald-100/80">{published
                  ? "Publisert rapport er låst. Videre arbeid håndteres som en egen oppfølgingsprosess."
                  : "Begge godkjenninger skal være registrert. Kontroller endelig PDF før publisering."}</p>
              </div>
              <span className="rounded-xl border border-emerald-400/40 bg-emerald-500/10 px-3 py-2 text-xs font-black text-emerald-200">
                {published ? "Publisert" : "Godkjent – ikke publisert"}
              </span>
            </div>
          </section>

          <section className="grid gap-5 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
            <div className="space-y-4">
              <div className="rounded-2xl border border-[#653444] bg-[#32121d] p-5">
                <h3 className="flex items-center gap-2 text-base font-black"><ShieldCheck className="h-5 w-5 text-emerald-300" /> Utførelse og kvalitetssikring</h3>
                <p className="mt-4 text-[10px] font-black uppercase tracking-wide text-[#c8acb7]">Lekkasjesøk utført av</p>
                <p className="mt-1 text-sm font-bold">Miroslav Subanovic</p>
                <p className="text-xs text-[#d7bfca]">Bygningsingeniør, Perun AS</p>
                <div className="mt-4 border-t border-[#653444] pt-4">
                  <p className="text-[10px] font-black uppercase tracking-wide text-[#c8acb7]">Registrerte faglige godkjenninger</p>
                  <div className="mt-3 space-y-3">
                    {([
  { title: 'Faglig gjennomgang', approval: pmApproval },
  { title: 'Administrativ sluttgodkjenning', approval: adminApproval },
]).map(({ title, approval }) => (
  <div key={title} className="rounded-xl border border-[#653444] bg-[#1b0b12] p-3">
    <p className="text-[10px] font-bold text-[#c8acb7]">{title}</p>
    <p className="mt-1 text-sm font-bold text-white">{approval?.approved ? (approval.approved_by_name || 'Navn ikke registrert') : 'Godkjenning ikke bekreftet i oppslaget'}</p>
    {approval?.approved && <p className="mt-1 text-xs text-[#d7bfca]">{approval.approved_by_title || 'Tittel ikke registrert'}{approval.company_name ? ` · ${approval.company_name}` : ''}</p>}
    {approval?.approved && <p className="mt-1 text-[11px] text-emerald-200">{formatApprovalDate(approval.approved_at) || 'Dato ikke oppgitt'}</p>}
  </div>
))}
                  </div>
                </div>
                <p className="mt-4 text-[11px] leading-5 text-[#c8acb7]">
                  Godkjenningsnavn og tidspunkter kommer fra registrerte godkjenninger. Denne skjermvisningen
                  legger ikke automatisk ny signaturtekst inn i den eksisterende PDF-en.
                </p>
              </div>
              <div className="rounded-2xl border border-[#653444] bg-[#32121d] p-5">
                <h3 className="text-sm font-black">Rapportinnhold</h3>
                <p className="mt-2 text-xs text-[#d7bfca]">Rapport #{report.id} · Revisjon {report.revision_no || 1}</p>
                <p className="mt-2 text-xs text-[#d7bfca]">{published ? "Publisert" : "Godkjent"}: {formatApprovalDate(published ? report.published_at || undefined : report.approved_at || undefined) || "Dato ikke tilgjengelig"}</p>
                <details className="mt-4 rounded-xl border border-[#653444] bg-[#1b0b12] p-3">
                  <summary className="cursor-pointer text-xs font-bold text-[#efdae2]">Les rapportens ferdige tekst</summary>
                  <pre className="mt-3 whitespace-pre-wrap break-words font-sans text-xs leading-6 text-[#efdae2]">{report.admin_final || "Ingen slutttekst registrert."}</pre>
                </details>
              </div>
              {!published && (
                <ReportApprovalWorkflow inquiryId={inquiryId} reportId={report.id}
                  dirty={false} pdfUrl={report.pdf_url}
                  onUpdated={() => { void loadReviewData(); onChanged?.(); }} />
              )}
              {published && (
                <div className="rounded-2xl border border-cyan-500/30 bg-[#122630] p-5">
                  <h3 className="text-sm font-black text-cyan-200">Neste prosess – videre oppfølging</h3>
                  <p className="mt-2 text-xs leading-5 text-[#d7bfca]">Velg mellom ingen tiltak, midlertidig tetting/service og pristilbud for varig utbedring i sakskortets oppfølgingspanel.</p>
                  <button type="button" onClick={() => window.scrollTo({ top: 0, behavior: "smooth" })}
                    className="mt-3 rounded-xl border border-cyan-500/40 bg-cyan-500/10 px-4 py-2.5 text-xs font-bold text-cyan-100">
                    Gå til sakskortets oppfølging
                  </button>
                </div>
              )}
            </div>
            <aside className="overflow-hidden rounded-2xl border border-[#653444] bg-[#32121d]">
              <div className="border-b border-[#653444] p-4">
                <h3 className="text-sm font-black">{published ? "Publisert PDF" : "Endelig PDF – sluttkontroll"}</h3>
                <p className="mt-1 text-[11px] text-[#c8acb7]">PDF-en er skrivebeskyttet i denne visningen.</p>
              </div>
              {pdfSrc ? (
                <iframe title="Rapport 1 – PDF" src={pdfSrc} className="h-[750px] w-full bg-white" />
              ) : (
                <div className="p-6 text-xs text-amber-200">Endelig PDF mangler. Publisering er ikke mulig før den er generert.</div>
              )}
              {!published && (
                <div className="border-t border-[#653444] p-4">
                  <button type="button" onClick={handleGeneratePdf} disabled={generatingPdf || !adminText.trim() || !report1FullyApproved}
                    className="flex items-center gap-2 rounded-xl border border-[#754453] bg-[#341722] px-4 py-2.5 text-xs font-bold disabled:opacity-40">
                    {generatingPdf ? <Loader2 className="h-4 w-4 animate-spin" /> : <RefreshCw className="h-4 w-4" />}
                    Generer endelig PDF etter godkjenning
                  </button>
                </div>
              )}
            </aside>
          </section>
        </div>
      </div>
    );
  }

  return (
    <div className="min-h-screen bg-[#270b13] text-white">
      <header className="sticky top-0 z-40 bg-[#1b0b12] border-b border-[#653444] px-6 py-4">
        <div className="max-w-[1600px] mx-auto flex items-center justify-between gap-4">
          <div>
            <p className="text-[10px] uppercase tracking-wider font-black text-orange-400">
              Admin kvalitetssikring
            </p>
            <h1 className="text-lg font-extrabold">
              Rapport #{report?.id ?? "–"} · Oppdrag #{inquiryId}
            </h1>
            <p className="text-xs text-[#d7bfca] mt-1">
              {[customerName, address].filter(Boolean).join(" · ")}
            </p>
          </div>

          <button
            type="button"
            onClick={() => onBack?.()}
            className="px-4 py-2.5 rounded-xl bg-[#341722] border border-[#754453] text-xs font-bold text-[#efdae2] hover:text-white flex items-center gap-2"
          >
            <ArrowLeft className="w-4 h-4" />
            Tilbake til rapporter
          </button>
        </div>
      </header>

      <main className="max-w-[1600px] mx-auto px-4 md:px-8 py-6 space-y-5">
        {!report ? (
          <section className="bg-[#32121d] border border-[#653444] rounded-3xl p-12 text-center">
            <FileText className="w-9 h-9 text-slate-700 mx-auto" />
            <p className="mt-4 text-sm font-bold text-[#efdae2]">Ingen rapport funnet</p>
            <p className="mt-1 text-xs text-[#c8acb7]">
              Det finnes ingen teknisk rapport knyttet til oppdrag #{inquiryId} ennå.
            </p>
          </section>
        ) : (
          <>
            <section className="bg-[#32121d] border border-[#653444] rounded-2xl px-5 py-4">
              <div className="flex flex-col xl:flex-row xl:items-center justify-between gap-4">
                <div>
                  <div className="flex flex-wrap items-center gap-2">
                    <h2 className="font-extrabold text-base flex items-center gap-2">
                      <FileText className="w-5 h-5 text-orange-400" />
                      Punktvis rapportkontroll
                    </h2>
                    <span
                      className={`px-3 py-1 rounded-full border text-[10px] uppercase font-black ${statusClass(
                        report.status
                      )}`}
                    >
                      {statusLabel(report.status)}
                    </span>
                    <span
                      className={`px-2.5 py-1 rounded-full border text-[10px] font-black ${
                        hasUnsavedChanges
                          ? "border-amber-500/30 bg-amber-500/10 text-amber-300"
                          : "border-emerald-500/20 bg-emerald-500/10 text-emerald-300"
                      }`}
                    >
                      {hasUnsavedChanges ? "Ulagrede endringer" : "Lagret"}
                    </span>
                  </div>
                  <p className="text-xs text-[#d7bfca] mt-1">
                    Kontroller hvert feltpunkt, velg dokumentasjonsbilder og
                    rediger sluttteksten. Lyd og transkripsjon er kun
                    kontrollgrunnlag.
                  </p>
                </div>

                <div className="flex flex-wrap gap-2">
                  <div className="px-3 py-2 rounded-xl bg-[#1b0b12] border border-[#653444] text-[11px] text-[#d7bfca]">
                    <strong className="text-white">{checklistRows.length}</strong>{" "}
                    punkter
                  </div>
                  <div className="px-3 py-2 rounded-xl bg-[#1b0b12] border border-[#653444] text-[11px] text-[#d7bfca]">
                    <strong className="text-white">{selectedPhotoCount}</strong>{" "}
                    bilder valgt
                  </div>
                  {report?.revision_no ? (
                    <div className="px-3 py-2 rounded-xl bg-[#1b0b12] border border-[#653444] text-[11px] text-[#d7bfca]">
                      Revisjon <strong className="text-white">{report.revision_no}</strong>
                    </div>
                  ) : null}
                  {report?.submitted_at ? (
                    <div className="px-3 py-2 rounded-xl bg-[#1b0b12] border border-[#653444] text-[11px] text-[#d7bfca]">
                      Sendt inn{" "}
                      <strong className="text-white">
                        {new Date(String(report.submitted_at).replace(" ", "T")).toLocaleDateString("nb-NO", {
                          day: "2-digit",
                          month: "2-digit",
                          year: "numeric",
                        })}
                      </strong>
                    </div>
                  ) : null}
                  <button
                    type="button"
                    onClick={() => setShowOriginal(true)}
                    className="px-4 py-2 rounded-xl bg-[#341722] border border-[#754453] text-xs font-bold text-[#efdae2] hover:text-white flex items-center gap-2"
                  >
                    <Eye className="w-4 h-4" />
                    Originalutkast
                  </button>
                </div>
              </div>
            </section>

            {error && (
              <div className="bg-red-500/10 border border-red-500/30 rounded-2xl px-5 py-4 text-xs text-red-300 flex gap-2">
                <AlertTriangle className="w-4 h-4 shrink-0" />
                {error}
              </div>
            )}

            {message && (
              <div className="bg-emerald-500/10 border border-emerald-500/30 rounded-2xl px-5 py-3 text-xs text-emerald-300 flex gap-2">
                <CheckCircle2 className="w-4 h-4 shrink-0" />
                {message}
              </div>
            )}

            <section className="grid grid-cols-1 xl:grid-cols-[minmax(0,1.15fr)_minmax(460px,0.85fr)] gap-5 items-start">
              <div className="space-y-4">
                {adminSections && (
                  <>
                    <section className="bg-[#32121d] border border-[#653444] rounded-2xl overflow-hidden">
                      <div className="px-5 py-4 border-b border-[#653444]">
                        <p className="text-[10px] uppercase tracking-wider font-black text-orange-400">
                          Rapportens hoveddel
                        </p>
                        <p className="text-[11px] text-[#c8acb7] mt-1">
                          Disse feltene bygger rammen rundt kontrollpunktene.
                        </p>
                      </div>

                      <div className="p-5 grid grid-cols-1 gap-4">
                        <label className="block">
                          <span className="text-[11px] font-extrabold text-[#efdae2]">
                            1. Sammendrag og hovedkonklusjon
                          </span>
                          <textarea
                            value={adminSections.summary}
                            onChange={(e) =>
                              updateGlobalSection("summary", e.target.value)
                            }
                            readOnly={!editable || report.status === "publisert"}
                            rows={5}
                            className="mt-2 w-full bg-[#1b0b12] border border-[#653444] rounded-2xl p-4 text-xs leading-6 text-slate-200 outline-none focus:border-rose-400/60 read-only:opacity-70"
                          />
                        </label>

                        <label className="block">
                          <span className="text-[11px] font-extrabold text-[#efdae2]">
                            2. Hovedårsak til lekkasjen
                          </span>
                          <p className="mt-1 text-[11px] leading-5 text-[#d7bfca]">
                            Beskriv påvist årsak, vannets inntrengningsvei og dokumentasjonsgrunnlag. Bruk «sannsynlig» dersom årsaken ikke er sikkert fastslått.
                          </p>
                          <textarea
                            value={adminSections.main_cause}
                            onChange={(e) => updateGlobalSection("main_cause", e.target.value)}
                            readOnly={!editable || report.status === "publisert"}
                            rows={5}
                            placeholder="Hovedårsak eller sannsynlig hovedårsak, med henvisning til registrerte funn …"
                            className="mt-2 w-full bg-[#1b0b12] border border-[#653444] rounded-2xl p-4 text-xs leading-6 text-slate-200 outline-none focus:border-rose-400/60 read-only:opacity-70"
                          />
                        </label>

                        <label className="block">
                          <span className="text-[11px] font-extrabold text-[#efdae2]">
                            3. Oppdrag og omfang
                          </span>
                          <textarea
                            value={adminSections.scope}
                            onChange={(e) =>
                              updateGlobalSection("scope", e.target.value)
                            }
                            readOnly={!editable || report.status === "publisert"}
                            rows={4}
                            className="mt-2 w-full bg-[#1b0b12] border border-[#653444] rounded-2xl p-4 text-xs leading-6 text-slate-200 outline-none focus:border-rose-400/60 read-only:opacity-70"
                          />
                        </label>
                      </div>
                    </section>

                    <div className="flex items-center justify-between px-1 pt-2">
                      <div>
                        <p className="text-[10px] uppercase tracking-wider font-black text-cyan-400">
                          3. Kontrollpunkter og feltgrunnlag
                        </p>
                        <p className="text-[11px] text-[#c8acb7] mt-1">
                          Prosjektansvarliges feltdata vises urørt. Admin redigerer
                          bare sluttteksten og bildevalget.
                        </p>
                      </div>
                    </div>

                    {checklistRows.length === 0 ? (
                      <div className="bg-[#32121d] border border-[#653444] rounded-2xl p-6 text-xs text-[#c8acb7]">
                        Ingen kontrollpunkter ble returnert fra sjekklisten.
                      </div>
                    ) : (
                      checklistRows.map((row, rowIndex) => {
                        const key = normalizeItemKey(row);
                        const section = adminSections.items[key] || {
                          included: true,
                          admin_text: "",
                          order: rowIndex,
                        };
                        const itemPhotos = photosByItem[key] || [];
                        const isOpen = expandedItems[key] !== false;
                        const audioCount =
                          itemPhotos.filter((photo) => photo.audio_url).length +
                          (row.audio_url ? 1 : 0);
                        const selectedCount = itemPhotos.filter((photo) =>
                          boolValue(photo.include_in_report)
                        ).length;

                        return (
                          <article
                            key={key}
                            className={`bg-[#32121d] border rounded-2xl overflow-hidden ${
                              section.included
                                ? "border-[#754453]"
                                : "border-[#653444] opacity-75"
                            }`}
                          >
                            <div className="px-5 py-4 flex items-center justify-between gap-4">
                              <button
                                type="button"
                                onClick={() => toggleExpanded(key)}
                                className="min-w-0 flex-1 text-left flex items-center gap-3"
                              >
                                <span className="w-7 h-7 rounded-lg bg-[#341722] border border-[#653444] flex items-center justify-center text-[10px] font-black text-[#d7bfca] shrink-0">
                                  {rowIndex + 1}
                                </span>
                                <div
                                  className={`w-9 h-9 rounded-xl border flex items-center justify-center shrink-0 ${tgClass(
                                    row.status
                                  )}`}
                                >
                                  <span className="text-[10px] font-black">
                                    {(row.status || "–").toUpperCase()}
                                  </span>
                                </div>

                                <div className="min-w-0">
                                  <p className="font-extrabold text-sm text-white truncate">
                                    {row.item_title}
                                  </p>
                                  <div className="flex flex-wrap gap-3 mt-1 text-[10px] text-[#c8acb7]">
                                    <span className="flex items-center gap-1">
                                      <Camera className="w-3 h-3" />
                                      {itemPhotos.length} bilder · {selectedCount} valgt
                                    </span>
                                    {audioCount > 0 && (
                                      <span className="flex items-center gap-1">
                                        <Mic className="w-3 h-3" />
                                        {audioCount} lydnotat
                                      </span>
                                    )}
                                  </div>
                                </div>
                              </button>

                              <div className="flex items-center gap-2 shrink-0">
                                <button
                                  type="button"
                                  disabled={
                                    !editable || report.status === "publisert"
                                  }
                                  onClick={() =>
                                    updateItemSection(key, {
                                      included: !section.included,
                                    })
                                  }
                                  className={`px-3 py-2 rounded-xl border text-[10px] font-black flex items-center gap-1.5 disabled:opacity-50 ${
                                    section.included
                                      ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-300"
                                      : "bg-[#341722] border-[#754453] text-[#c8acb7]"
                                  }`}
                                >
                                  {section.included && (
                                    <Check className="w-3.5 h-3.5" />
                                  )}
                                  {section.included
                                    ? "Med i rapport"
                                    : "Utelatt"}
                                </button>

                                <button
                                  type="button"
                                  onClick={() => toggleExpanded(key)}
                                  className="w-9 h-9 rounded-xl bg-[#341722] border border-[#754453] flex items-center justify-center text-[#d7bfca]"
                                >
                                  {isOpen ? (
                                    <ChevronUp className="w-4 h-4" />
                                  ) : (
                                    <ChevronDown className="w-4 h-4" />
                                  )}
                                </button>
                              </div>
                            </div>

                            {isOpen && (
                              <div className="border-t border-[#653444] p-5 space-y-5">
                                <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                  <div className="rounded-2xl bg-[#1b0b12] border border-[#653444] p-4">
                                    <p className="text-[9px] uppercase tracking-wider font-black text-[#c8acb7]">
                                      Prosjektansvarlig · feltregistrering
                                    </p>
                                    <p className="text-xs leading-6 text-[#efdae2] mt-2 whitespace-pre-wrap">
                                      {row.comment?.trim() ||
                                        "Ingen skriftlig kommentar registrert på dette punktet."}
                                    </p>
                                  </div>

                                  <div className="rounded-2xl bg-[#1b0b12] border border-[#653444] p-4">
                                    <p className="text-[9px] uppercase tracking-wider font-black text-[#c8acb7]">
                                      Kontrollgrunnlag
                                    </p>
                                    <div className="mt-2 flex flex-wrap gap-2 text-[10px]">
                                      <span className="px-2.5 py-1.5 rounded-lg bg-[#341722] border border-[#653444] text-[#d7bfca]">
                                        {itemPhotos.length} dokumentasjonsbilder
                                      </span>
                                      <span className="px-2.5 py-1.5 rounded-lg bg-[#341722] border border-[#653444] text-[#d7bfca]">
                                        {audioCount} lydnotat
                                      </span>
                                    </div>
                                  </div>
                                </div>

                                {(row.audio_url ||
                                  itemPhotos.some((photo) => photo.audio_url)) && (
                                  <div>
                                    <p className="text-[10px] uppercase tracking-wider font-black text-violet-400 mb-2">
                                      Lyd og transkripsjon
                                    </p>

                                    <div className="space-y-2">
                                      {row.audio_url && (
                                        <div className="rounded-xl bg-violet-500/5 border border-violet-500/20 p-3">
                                          <p className="text-[10px] font-bold text-violet-300 mb-2">
                                            Lyd fra kontrollpunkt
                                          </p>
                                          <audio
                                            controls
                                            src={apiAssetUrl(row.audio_url)}
                                            className="w-full h-9"
                                          />
                                        </div>
                                      )}

                                      {itemPhotos
                                        .filter((photo) => photo.audio_url)
                                        .map((photo) => (
                                          <div
                                            key={`audio-${photo.id}`}
                                            className="rounded-xl bg-violet-500/5 border border-violet-500/20 p-3"
                                          >
                                            <div className="flex items-center justify-between gap-3">
                                              <p className="text-[10px] font-bold text-violet-300">
                                                Lydnotat til dokumentasjon #{photo.id}
                                              </p>
                                              {photo.audio_transcript && (
                                                <button
                                                  type="button"
                                                  onClick={() =>
                                                    setOpenTranscripts(
                                                      (current) => ({
                                                        ...current,
                                                        [photo.id]:
                                                          !current[photo.id],
                                                      })
                                                    )
                                                  }
                                                  className="text-[10px] font-bold text-cyan-300"
                                                >
                                                  {openTranscripts[photo.id]
                                                    ? "Skjul tekst"
                                                    : "Vis transkripsjon"}
                                                </button>
                                              )}
                                            </div>

                                            <audio
                                              controls
                                              src={apiAssetUrl(photo.audio_url || "")}
                                              className="w-full h-9 mt-2"
                                            />

                                            {openTranscripts[photo.id] &&
                                              photo.audio_transcript && (
                                                <div className="mt-3 rounded-xl bg-[#1b0b12] border border-[#653444] p-3">
                                                  <p className="text-[9px] uppercase tracking-wider font-black text-[#c8acb7] mb-1">
                                                    Automatisk transkripsjon
                                                  </p>
                                                  <p className="text-xs leading-6 text-[#efdae2] whitespace-pre-wrap">
                                                    {photo.audio_transcript}
                                                  </p>
                                                </div>
                                              )}
                                          </div>
                                        ))}
                                    </div>
                                  </div>
                                )}

                                <div>
                                  <div className="flex items-center justify-between gap-3 mb-2">
                                    <div>
                                      <p className="text-[10px] uppercase tracking-wider font-black text-cyan-400">
                                        Bilder
                                      </p>
                                      <p className="text-[10px] text-[#c8acb7] mt-0.5">
                                        Klikk på bildet for stor visning. Admin kan
                                        velge hvert bilde inn eller ut av PDF-en.
                                      </p>
                                    </div>
                                  </div>

                                  {itemPhotos.length === 0 ? (
                                    <div className="rounded-xl border border-dashed border-[#653444] p-5 text-center text-[11px] text-[#bd9eaa]">
                                      Ingen bilder er knyttet til dette punktet.
                                    </div>
                                  ) : (
                                    <div className="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3">
                                      {itemPhotos.map((photo) => {
                                        const selected = boolValue(
                                          photo.include_in_report
                                        );
                                        const imageUrl = photo.photo_url
                                          ? apiAssetUrl(photo.photo_url)
                                          : "";

                                        return (
                                          <div
                                            key={photo.id}
                                            className={`rounded-2xl overflow-hidden border ${
                                              selected
                                                ? "border-emerald-500/50 bg-emerald-500/5"
                                                : "border-[#653444] bg-[#1b0b12]"
                                            }`}
                                          >
                                            {imageUrl ? (
                                              <button
                                                type="button"
                                                onClick={() =>
                                                  setLightboxUrl(imageUrl)
                                                }
                                                className="relative block w-full aspect-[4/3] bg-[#341722] overflow-hidden"
                                              >
                                                <img
                                                  src={imageUrl}
                                                  alt={
                                                    photo.caption_text ||
                                                    "Dokumentasjonsbilde"
                                                  }
                                                  className="w-full h-full object-cover hover:scale-[1.02] transition-transform"
                                                />
                                                {selected && (
                                                  <span className="absolute left-2 top-2 rounded-md bg-emerald-500 px-1.5 py-0.5 text-[9px] font-black text-slate-950">
                                                    I PDF
                                                  </span>
                                                )}
                                              </button>
                                            ) : (
                                              <div className="aspect-[4/3] bg-[#341722] flex items-center justify-center">
                                                <ImageIcon className="w-7 h-7 text-slate-700" />
                                              </div>
                                            )}

                                            <div className="p-3">
                                              <p className="text-[10px] text-[#d7bfca] line-clamp-2 min-h-[28px]">
                                                {photo.caption_text ||
                                                  `Dokumentasjon #${photo.id}`}
                                              </p>

                                              <button
                                                type="button"
                                                disabled={
                                                  savingPhotoId === photo.id ||
                                                  !editable ||
                                                  report.status === "publisert"
                                                }
                                                onClick={() =>
                                                  void togglePhotoForReport(
                                                    photo,
                                                    !selected
                                                  )
                                                }
                                                className={`mt-2 w-full px-2 py-2 rounded-xl border text-[10px] font-black flex items-center justify-center gap-1.5 disabled:opacity-50 ${
                                                  selected
                                                    ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-300"
                                                    : "bg-[#341722] border-[#754453] text-[#d7bfca]"
                                                }`}
                                              >
                                                {savingPhotoId === photo.id ? (
                                                  <Loader2 className="w-3.5 h-3.5 animate-spin" />
                                                ) : selected ? (
                                                  <Check className="w-3.5 h-3.5" />
                                                ) : (
                                                  <Camera className="w-3.5 h-3.5" />
                                                )}
                                                {selected
                                                  ? "Med i PDF"
                                                  : "Velg inn"}
                                              </button>
                                            </div>
                                          </div>
                                        );
                                      })}
                                    </div>
                                  )}
                                </div>

                                <label className="block">
                                  <div className="flex items-center justify-between gap-3">
                                    <span className="text-[10px] uppercase tracking-wider font-black text-orange-400">
                                      Admins slutttekst for punktet
                                    </span>
                                    <span className="text-[10px] text-[#bd9eaa]">
                                      {section.admin_text.length} tegn
                                    </span>
                                  </div>
                                  <textarea
                                    value={section.admin_text}
                                    onChange={(e) =>
                                      updateItemSection(key, {
                                        admin_text: e.target.value,
                                      })
                                    }
                                    readOnly={
                                      !editable ||
                                      report.status === "publisert" ||
                                      !section.included
                                    }
                                    rows={5}
                                    placeholder="Skriv admins kvalitetssikrede vurdering av dette kontrollpunktet..."
                                    className="mt-2 w-full bg-[#1b0b12] border border-orange-500/20 rounded-2xl p-4 text-xs leading-6 text-slate-200 outline-none focus:border-rose-400/60 read-only:opacity-60"
                                  />
                                </label>
                              </div>
                            )}
                          </article>
                        );
                      })
                    )}

                    {(photosByItem.__other__ || []).length > 0 && (
                      <section className="bg-[#32121d] border border-[#653444] rounded-2xl p-5">
                        <p className="text-[10px] uppercase tracking-wider font-black text-cyan-400">
                          Øvrig dokumentasjon
                        </p>
                        <p className="text-[11px] text-[#c8acb7] mt-1">
                          Bilder eller lyd som ikke er koblet til et bestemt
                          kontrollpunkt.
                        </p>

                        <div className="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3 mt-4">
                          {photosByItem.__other__.map((photo) => {
                            const selected = boolValue(
                              photo.include_in_report
                            );
                            const imageUrl = photo.photo_url
                              ? apiAssetUrl(photo.photo_url)
                              : "";

                            return (
                              <div
                                key={photo.id}
                                className={`rounded-2xl overflow-hidden border ${
                                  selected
                                    ? "border-emerald-500/50"
                                    : "border-[#653444]"
                                }`}
                              >
                                {imageUrl && (
                                  <button
                                    type="button"
                                    onClick={() => setLightboxUrl(imageUrl)}
                                    className="block w-full aspect-[4/3] bg-[#341722]"
                                  >
                                    <img
                                      src={imageUrl}
                                      alt="Øvrig dokumentasjon"
                                      className="w-full h-full object-cover"
                                    />
                                  </button>
                                )}
                                <div className="p-3">
                                  {photo.audio_url && (
                                    <audio
                                      controls
                                      src={apiAssetUrl(photo.audio_url)}
                                      className="w-full h-8 mb-2"
                                    />
                                  )}
                                  <button
                                    type="button"
                                    disabled={
                                      savingPhotoId === photo.id ||
                                      !editable ||
                                      report.status === "publisert"
                                    }
                                    onClick={() =>
                                      void togglePhotoForReport(
                                        photo,
                                        !selected
                                      )
                                    }
                                    className={`w-full px-2 py-2 rounded-xl border text-[10px] font-black disabled:opacity-50 ${
                                      selected
                                        ? "bg-emerald-500/10 border-emerald-500/30 text-emerald-300"
                                        : "bg-[#341722] border-[#754453] text-[#d7bfca]"
                                    }`}
                                  >
                                    {selected ? "Med i PDF" : "Velg inn"}
                                  </button>
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      </section>
                    )}

                    <section className="bg-[#32121d] border border-[#653444] rounded-2xl overflow-hidden">
                      <div className="px-5 py-4 border-b border-[#653444]">
                        <p className="text-[10px] uppercase tracking-wider font-black text-orange-400">
                          Rapportens avsluttende vurderinger
                        </p>
                      </div>

                      <div className="p-5 space-y-4">
                        <label className="block">
                          <span className="text-[11px] font-extrabold text-[#efdae2]">
                            5. Anbefalte tiltak
                          </span>
                          <textarea
                            value={adminSections.recommendations}
                            onChange={(e) =>
                              updateGlobalSection(
                                "recommendations",
                                e.target.value
                              )
                            }
                            readOnly={!editable || report.status === "publisert"}
                            rows={6}
                            className="mt-2 w-full bg-[#1b0b12] border border-[#653444] rounded-2xl p-4 text-xs leading-6 text-slate-200 outline-none focus:border-rose-400/60 read-only:opacity-70"
                          />
                        </label>

                        <label className="block">
                          <span className="text-[11px] font-extrabold text-[#efdae2]">
                            6. Konsekvenser ved utsatt utbedring
                          </span>
                          <textarea
                            value={adminSections.consequences}
                            onChange={(e) =>
                              updateGlobalSection(
                                "consequences",
                                e.target.value
                              )
                            }
                            readOnly={!editable || report.status === "publisert"}
                            rows={4}
                            className="mt-2 w-full bg-[#1b0b12] border border-[#653444] rounded-2xl p-4 text-xs leading-6 text-slate-200 outline-none focus:border-rose-400/60 read-only:opacity-70"
                          />
                        </label>

                        <label className="block">
                          <span className="text-[11px] font-extrabold text-[#efdae2]">
                            7. Forbehold og begrensninger
                          </span>
                          <textarea
                            value={adminSections.limitations}
                            onChange={(e) =>
                              updateGlobalSection(
                                "limitations",
                                e.target.value
                              )
                            }
                            readOnly={!editable || report.status === "publisert"}
                            rows={5}
                            className="mt-2 w-full bg-[#1b0b12] border border-[#653444] rounded-2xl p-4 text-xs leading-6 text-slate-200 outline-none focus:border-rose-400/60 read-only:opacity-70"
                          />
                        </label>
                      </div>
                    </section>
                  </>
                )}

                <section className="bg-[#32121d] border border-[#653444] rounded-2xl p-5">
                  <div className="grid grid-cols-1 lg:grid-cols-[220px_1fr] gap-4">
                    <div>
                      <p className="text-[10px] uppercase tracking-wider font-black text-[#c8acb7]">
                        Kommentar ved retur
                      </p>
                      <p className="text-[11px] text-[#c8acb7] mt-1 leading-5">
                        Bare nødvendig dersom rapporten returneres til
                        prosjektansvarlig.
                      </p>
                    </div>
                    <textarea
                      value={returnNote}
                      onChange={(e) => setReturnNote(e.target.value)}
                      disabled={report.status === "publisert"}
                      rows={3}
                      placeholder="Eksempel: Kontroller konklusjonen og legg ved nærbilder av oppkant mot gesims."
                      className="w-full bg-[#1b0b12] border border-[#653444] rounded-2xl p-4 text-xs text-slate-200 outline-none focus:border-red-500/40 disabled:opacity-50"
                    />
                  </div>
                </section>
              </div>

              <aside className="bg-[#32121d] border border-[#653444] rounded-3xl overflow-hidden xl:sticky xl:top-[96px]">
                <div className="px-5 py-4 border-b border-[#653444] flex items-center justify-between gap-3">
                  <div>
                    <p className="text-[10px] uppercase tracking-wider font-black text-cyan-400">
                      PDF-forhåndsvisning
                    </p>
                    <p className="text-[11px] text-[#c8acb7] mt-1">
                      Oppdater etter tekst- eller bildeendringer.
                    </p>
                  </div>
                  <button
                    type="button"
                    onClick={handleGeneratePdf}
                    disabled={
                      generatingPdf ||
                      report.status === "publisert" ||
                      !adminText.trim()
                    }
                    className="px-3.5 py-2 rounded-xl bg-[#341722] border border-[#754453] text-xs font-extrabold flex items-center gap-2 disabled:opacity-50"
                  >
                    {generatingPdf ? (
                      <Loader2 className="w-4 h-4 animate-spin" />
                    ) : (
                      <RefreshCw className="w-4 h-4" />
                    )}
                    Oppdater PDF
                  </button>
                </div>

                {pdfSrc ? (
                  <iframe
                    key={report.pdf_url || "report-pdf"}
                    title="Rapport PDF"
                    src={pdfSrc}
                    className="w-full h-[calc(100vh-250px)] min-h-[720px] bg-white"
                  />
                ) : (
                  <div className="h-[calc(100vh-250px)] min-h-[720px] flex flex-col items-center justify-center px-8 text-center">
                    <FileText className="w-10 h-10 text-slate-700 mb-3" />
                    <p className="text-sm font-extrabold text-[#efdae2]">
                      PDF må oppdateres
                    </p>
                    <p className="text-xs text-[#c8acb7] mt-2 max-w-sm">
                      Lagre kvalitetssikringen og klikk «Oppdater PDF». Valgte
                      bilder blir hentet fra feltgrunnlaget.
                    </p>
                  </div>
                )}
              </aside>
            </section>

            {showOriginal && (
              <div
                className="fixed inset-0 z-[80] bg-black/70 backdrop-blur-sm"
                onClick={() => setShowOriginal(false)}
              >
                <aside
                  className="absolute left-0 top-0 h-full w-full max-w-2xl bg-[#32121d] border-r border-[#754453] shadow-2xl flex flex-col"
                  onClick={(e) => e.stopPropagation()}
                >
                  <div className="px-6 py-5 border-b border-[#653444] flex items-center justify-between gap-4">
                    <div>
                      <p className="text-[10px] uppercase tracking-wider font-black text-[#c8acb7]">
                        Referanse
                      </p>
                      <h3 className="text-base font-extrabold mt-1">
                        Feltteamets originalutkast
                      </h3>
                      <p className="text-[11px] text-[#c8acb7] mt-1">
                        Skrivebeskyttet original. Punktdata, bilder og lyd ligger
                        i hovededitoren.
                      </p>
                    </div>
                    <button
                      type="button"
                      onClick={() => setShowOriginal(false)}
                      className="w-10 h-10 rounded-xl bg-[#341722] border border-[#754453] flex items-center justify-center text-[#d7bfca] hover:text-white"
                    >
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                  <div className="flex-1 overflow-y-auto whitespace-pre-wrap p-6 text-[13px] leading-7 text-[#efdae2]">
                    {report.ai_draft || "Ingen rapporttekst."}
                  </div>
                </aside>
              </div>
            )}

            {lightboxUrl && (
              <div
                className="fixed inset-0 z-[90] bg-black/90 p-4 md:p-8 flex items-center justify-center"
                onClick={() => setLightboxUrl("")}
              >
                <button
                  type="button"
                  onClick={() => setLightboxUrl("")}
                  className="absolute top-5 right-5 w-11 h-11 rounded-xl bg-[#1b0b12]/80 border border-[#754453] flex items-center justify-center text-white"
                >
                  <X className="w-5 h-5" />
                </button>
                <img
                  src={lightboxUrl}
                  alt="Dokumentasjonsbilde i stor visning"
                  className="max-w-full max-h-full object-contain rounded-xl"
                  onClick={(e) => e.stopPropagation()}
                />
              </div>
            )}

            <ReportApprovalWorkflow inquiryId={inquiryId} reportId={report.id}
                dirty={hasUnsavedChanges} pdfUrl={report.pdf_url}
                onState={state => setApprovalLocked(["awaiting_pm", "awaiting_admin", "approved", "published"].includes(state))}
                onUpdated={() => { void loadReviewData(); onChanged?.(); }} />

            {report.status !== "publisert" ? (
              <section className="sticky bottom-3 z-30 bg-[#1b0b12]/95 backdrop-blur border border-[#754453] rounded-2xl p-4 shadow-2xl">
                <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                  <div>
                    <p className="text-xs text-[#efdae2] font-bold">
                      {hasUnsavedChanges
                        ? "Det finnes ulagrede endringer i punktredigeringen."
                        : "Punktredigeringen er lagret."}
                    </p>
                    <p className="text-[10px] text-[#c8acb7] mt-1">
                      Lyd/transkripsjoner publiseres ikke. Kun valgte bilder og
                      admins slutttekst brukes i rapporten.
                    </p>
                  </div>

                  <div className="flex flex-wrap gap-2 justify-end">
                    <button
                      type="button"
                      onClick={handleSave}
                      disabled={saving || !adminText.trim()}
                      className="px-4 py-2.5 rounded-xl bg-[#341722] border border-[#754453] text-xs font-extrabold flex items-center gap-2 disabled:opacity-50"
                    >
                      {saving ? (
                        <Loader2 className="w-4 h-4 animate-spin" />
                      ) : (
                        <Save className="w-4 h-4" />
                      )}
                      Lagre
                    </button>

                    {false && (<button
                      type="button"
                      onClick={handleReturn}
                      disabled={returning || !returnNote.trim()}
                      className="px-4 py-2.5 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs font-extrabold flex items-center gap-2 disabled:opacity-50"
                    >
                      {returning ? (
                        <Loader2 className="w-4 h-4 animate-spin" />
                      ) : (
                        <RotateCcw className="w-4 h-4" />
                      )}
                      Returner
                    </button>)}

                    {report.status === "godkjent" ? (
                      <button
                        type="button"
                        onClick={handleGeneratePdf}
                        disabled={generatingPdf || !adminText.trim() || !report1FullyApproved}
                        className="px-4 py-2.5 rounded-xl bg-blue-500/10 border border-blue-500/30 text-blue-300 text-xs font-extrabold flex items-center gap-2 disabled:opacity-50"
                      >
                        {generatingPdf ? (
                          <Loader2 className="w-4 h-4 animate-spin" />
                        ) : (
                          <RefreshCw className="w-4 h-4" />
                        )}
                        {report.pdf_url ? "Oppdater PDF" : "Generer PDF"}
                      </button>
                    ) : (
                      null
                    )}

                    {report.status === "godkjent" && (
                      null
                    )}
                  </div>
                </div>
              </section>
            ) : (
              <div className="bg-cyan-500/10 border border-cyan-500/30 rounded-2xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div>
                  <p className="text-xs font-extrabold text-cyan-300">
                    Rapporten er publisert til kunden.
                  </p>
                  <p className="text-[11px] text-[#d7bfca] mt-1">
                    Publisert versjon er låst. Admin kan åpne en intern
                    korrigering ved behov.
                  </p>
                </div>
                <button
                  type="button"
                  onClick={handleReopenPublished}
                  disabled={reopening}
                  className="px-4 py-2.5 rounded-xl bg-[#341722] border border-cyan-500/30 text-cyan-300 text-xs font-extrabold flex items-center gap-2 disabled:opacity-50"
                >
                  {reopening ? (
                    <Loader2 className="w-4 h-4 animate-spin" />
                  ) : (
                    <RefreshCw className="w-4 h-4" />
                  )}
                  Korriger publisert rapport
                </button>
              </div>
            )}
          </>
        )}
      </main>
    </div>
  );
}


