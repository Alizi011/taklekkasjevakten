import { useState } from "react";
import { apiUrl } from "../lib/api";

type BrregResponse = {
  success: boolean;
  orgnr?: string;
  company_name?: string;
  organisation_form?: string;
  checked_at?: string;
  roles?: Record<string, unknown>;
  signing?: Record<string, unknown>;
  message?: string;
  source?: { roles: string; signing: string };
};

function visibleText(value: unknown): string {
  if (typeof value === "string") return value;
  if (typeof value === "number") return String(value);
  return "";
}
function roleItems(raw: Record<string, unknown> | undefined) {
  const result: { role: string; name: string }[] = [];
  if (!raw) return result;
  const groups = Array.isArray(raw.rollegrupper) ? raw.rollegrupper : [];
  for (const group of groups) {
    if (!group || typeof group !== "object") continue;
    const g = group as Record<string, unknown>;
    const role = g.type && typeof g.type === "object"
      ? visibleText((g.type as Record<string, unknown>).beskrivelse)
      : "Registrert rolle";
    for (const item of Array.isArray(g.roller) ? g.roller : []) {
      if (!item || typeof item !== "object") continue;
      const r = item as Record<string, unknown>;
      const person = r.person && typeof r.person === "object" ? r.person as Record<string, unknown> : {};
      const unit = r.enhet && typeof r.enhet === "object" ? r.enhet as Record<string, unknown> : {};
      const name = visibleText(person.navn) || visibleText(unit.navn);
      if (name) result.push({ role, name });
    }
  }
  return result;
}

/** Standalone admin panel. Pass verified organisation number from current customer profile. */
export default function BrregBoardAndSignature({ orgnr }: { orgnr?: string | null }) {
  const [data, setData] = useState<BrregResponse | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const cleanOrg = (orgnr || "").replace(/\s/g, "");
  const search = async () => {
    if (!/^\d{9}$/.test(cleanOrg)) { setError("Kunden må ha et gyldig organisasjonsnummer."); return; }
    setBusy(true); setError(""); setData(null);
    try {
      const res = await fetch(apiUrl(`/tlv_brreg_board.php?orgnr=${cleanOrg}`), { credentials: "include", cache: "no-store" });
      const json = await res.json() as BrregResponse;
      if (!res.ok || !json.success) throw new Error(json.message || "Kunne ikke hente BRREG-data.");
      setData(json);
    } catch (e) { setError(e instanceof Error ? e.message : "BRREG-oppslaget feilet."); }
    finally { setBusy(false); }
  };
  const board = roleItems(data?.roles);
  const ground = data?.signing?.signeringsGrunnlag;
  const groundObject = ground && typeof ground === "object" ? ground as Record<string, unknown> : null;
  const status = data?.signing?.status;
  const statusObject = status && typeof status === "object" ? status as Record<string, unknown> : null;
  return (
    <section className="rounded-2xl border border-slate-700 bg-[#17111e] p-5 space-y-4">
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h3 className="text-base font-bold text-white">Styre og signaturrett fra BRREG</h3>
          <p className="text-xs text-slate-400">Offentlig registeroppslag · organisasjonsnummer {cleanOrg || "mangler"}</p>
        </div>
        <button type="button" onClick={() => void search()} disabled={busy || !/^\d{9}$/.test(cleanOrg)}
          className="rounded-xl border border-cyan-500/40 px-4 py-2.5 text-sm font-semibold text-cyan-200 hover:bg-cyan-500/10 disabled:opacity-40">
          {busy ? "Henter …" : "Hent fra BRREG"}
        </button>
      </div>
      {error && <p role="alert" className="text-sm text-rose-300">{error}</p>}
      {data && <>
        <div className="rounded-xl bg-slate-900 p-4">
          <p className="font-bold text-white">{data.company_name}</p>
          <p className="text-xs text-slate-400">{data.organisation_form} · Oppslag {data.checked_at ? new Date(data.checked_at).toLocaleString("nb-NO") : ""}</p>
        </div>
        <div className="grid gap-3 sm:grid-cols-2">
          <div className="rounded-xl border border-slate-700 p-4 space-y-2">
            <p className="font-semibold text-white">Registrerte roller</p>
            {board.length ? board.map((item, i) => <div key={`${item.name}-${i}`} className="border-t border-slate-800 pt-2 text-sm">
              <p className="text-white">{item.name}</p><p className="text-xs text-slate-400">{item.role}</p>
            </div>) : <p className="text-xs text-amber-200">Ingen roller kunne vises fra dette svarformatet. Kontroller BRREG-kilden.</p>}
          </div>
          <div className="rounded-xl border border-slate-700 p-4 space-y-2">
            <p className="font-semibold text-white">Signaturbestemmelse</p>
            {Boolean(groundObject?.kode) && <p className="text-sm text-slate-200">BRREG-kode: {visibleText(groundObject.kode)}</p>}
            {Boolean(groundObject?.fritekst) && <p className="whitespace-pre-wrap text-sm text-slate-200">{visibleText(groundObject.fritekst)}</p>}
            {Boolean(statusObject?.rutineStatus) && typeof statusObject?.rutineStatus === "object" && <p className="text-xs text-slate-300">{visibleText((statusObject.rutineStatus as Record<string, unknown>).tekstforklaring)}</p>}
            <p className="text-xs text-amber-200">Krever manuell kontroll: Oppslaget bekrefter ikke alene at en navngitt person kan signere den aktuelle avtalen.</p>
          </div>
        </div>
        <p className="text-xs text-slate-400">Kilder: <a className="underline" href={data.source?.roles} target="_blank" rel="noreferrer">Enhetsregisteret</a> · <a className="underline" href={data.source?.signing} target="_blank" rel="noreferrer">Fullmakttjenesten</a></p>
      </>}
    </section>
  );
}
