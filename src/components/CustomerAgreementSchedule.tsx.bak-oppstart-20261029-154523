import { useEffect, useState } from "react";

type Proposal = {
  id: number;
  version_no: number;
  proposed_start_date: string;
  estimated_duration: string;
  proposal_note: string | null;
  status: string;
  customer_response_note: string | null;
  created_at: string;
};
type Props = {
  inquiryId: number;
  sessionToken: string;
  endpoint: string;
  previewMode?: boolean;
  onAgreementCreated?: () => void;
};

export default function CustomerAgreementSchedule({
  inquiryId, sessionToken, endpoint, previewMode = false, onAgreementCreated,
}: Props) {
  const [proposals, setProposals] = useState<Proposal[]>([]);
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [message, setMessage] = useState("");
  const [note, setNote] = useState("");
  const [agreementCreated, setAgreementCreated] = useState(false);

  async function load() {
    if (previewMode || !sessionToken || inquiryId <= 0) {
      setLoading(false);
      return;
    }
    setLoading(true);
    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        cache: "no-store",
        body: JSON.stringify({ action: "list", inquiry_id: inquiryId, session_token: sessionToken }),
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || "Kunne ikke hente datoforslag.");
      const rows = (Array.isArray(data.proposals) ? data.proposals : []) as Proposal[];
      setProposals([...rows].sort((a,b) => b.version_no - a.version_no || b.id - a.id));
      setError("");
    } catch (e) {
      setError(e instanceof Error ? e.message : "Kunne ikke hente dato.");
    } finally { setLoading(false); }
  }

  useEffect(() => { void load(); }, [inquiryId, sessionToken, endpoint, previewMode]);

  async function respond(action: "approve" | "request_change" | "retry_create", id: number) {
    if (saving || previewMode) return;
    setSaving(true);
    setError("");
    setMessage("");
    try {
      const response = await fetch(endpoint, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action, inquiry_id: inquiryId, session_token: sessionToken, proposal_id: id, note }),
      });
      const data = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || "Kunne ikke registrere svaret.");
      if (action === "request_change") {
        setMessage("Ønsket om endring er registrert. Prosjektansvarlig kan foreslå en ny dato.");
      } else if (data.agreement_created === true && Number(data.agreement_id) > 0) {
        setAgreementCreated(true);
        setMessage("Oppstart er godkjent og arbeidsavtalen er opprettet. Fortsett med registrering av signatarer nedenfor.");
        onAgreementCreated?.();
      } else {
        setAgreementCreated(false);
        setMessage("Oppstart er godkjent, men avtaledokumentet er ikke klart ennå. Bruk «Prøv avtaleopprettelse igjen» nedenfor. Du skal ikke bekrefte datoen på nytt.");
      }
      setNote("");
      await load();
    } catch (e) { setError(e instanceof Error ? e.message : "Handlingen feilet."); }
    finally { setSaving(false); }
  }

  if (previewMode) return null;
  const latest = proposals[0];
  const approved = latest?.status === "approved";

  return (
    <section className="rounded-2xl border border-amber-500/30 bg-[#0b1422] p-5 text-white">
      <h2 className="text-lg font-bold">Bekreft faktisk oppstart</h2>
      <p className="mt-2 text-sm text-slate-400">Kontroller datoen og forventet varighet som prosjektansvarlig har registrert. Arbeidet kan ha startet før bekreftelsen. Datoen i avtalen blir den faktiske oppstarten; godkjenning og signatur tidsstemples når de skjer.</p>
      {loading && <p className="mt-4 text-sm">Henter registrert oppstart …</p>}
      {!loading && !latest && !error && <p className="mt-4 text-sm text-slate-300">Oppstartsdato er ikke registrert ennå.</p>}
      {latest && !loading && (
        <div className="mt-4 space-y-3 rounded-xl border border-slate-700 bg-slate-950/60 p-4">
          <p className="text-base font-bold">Oppstart: {latest.proposed_start_date}</p>
          <p className="text-sm">Forventet varighet: {latest.estimated_duration}</p>
          {latest.proposal_note && <p className="text-sm text-slate-300">{latest.proposal_note}</p>}
          {latest.status === "pending_customer" ? (
            <>
              <p className="text-xs text-amber-300">Avventer godkjenning fra verifisert styreleder.</p>
              <textarea value={note} onChange={e => setNote(e.target.value)} maxLength={2000} rows={3}
                placeholder="Merknad ved ønske om endring" className="w-full rounded-lg border border-slate-700 bg-slate-900 p-3 text-sm text-white" />
              <div className="flex flex-wrap gap-3">
                <button type="button" disabled={saving} onClick={() => void respond("approve", latest.id)} className="rounded-lg bg-amber-400 px-4 py-2 text-sm font-bold text-slate-950 disabled:opacity-50">Bekreft oppstart og varighet</button>
                <button type="button" disabled={saving || !note.trim()} onClick={() => void respond("request_change", latest.id)} className="rounded-lg border border-slate-600 px-4 py-2 text-sm disabled:opacity-50">Be om endring</button>
              </div>
            </>
          ) : approved ? (
            <>
              <p className="text-sm text-emerald-300">Oppstart og varighet er bekreftet av kunden.</p>
              {!agreementCreated && <p className="text-xs text-slate-400">Hvis arbeidsavtalen ikke er opprettet, kan du forsøke på nytt. Dersom den allerede finnes, åpnes signatarprosessen nedenfor.</p>}
              <button type="button" disabled={saving} onClick={() => void respond("retry_create", latest.id)} className="rounded-lg border border-amber-500/40 px-4 py-2 text-sm text-amber-200 disabled:opacity-50">Kontroller / prøv avtaleopprettelse igjen</button>
            </>
          ) : <p className="text-sm text-slate-300">{latest.status === "change_requested" ? "Ny dato er etterspurt" : `Status: ${latest.status}`}</p>}
        </div>
      )}
      {error && <p role="alert" className="mt-3 text-sm text-red-300">{error}</p>}
      {message && <p role="status" className="mt-3 text-sm text-emerald-300">{message}</p>}
    </section>
  );
}
