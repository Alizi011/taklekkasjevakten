  const [lastSavedSections, setLastSavedSections] = useState("");
  const [returnNote, setReturnNote] = useState("");

  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [generatingPdf, setGeneratingPdf] = useState(false);
  const [approving, setApproving] = useState(false);
  const [returning, setReturning] = useState(false);
  const [publishing, setPublishing] = useState(false);
  const [reopening, setReopening] = useState(false);
  const [savingPhotoId, setSavingPhotoId] = useState<number | null>(null);
  const [creatingDraft, setCreatingDraft] = useState(false);
  // Kun visning: påvirker ikke lagrede rapporter eller kontrollpunktdata.
  const [sourceSearch, setSourceSearch] = useState("");
  const [aiBusy, setAiBusy] = useState(false);
  const [aiSaving, setAiSaving] = useState(false);
  const [aiDraft, setAiDraft] = useState<{summary:string;scope:string;recommendations:string;consequences:string;limitations:string}|null>(null);
  const [aiSkippedImages, setAiSkippedImages] = useState(0);
  const [aiEvidence, setAiEvidence] = useState<string[]>([]);
  const [aiError, setAiError] = useState("");
  // AI-returrettelser: forslag ligger kun i lokal state frem til admin lagrer manuelt.
  const [returnAiBusy, setReturnAiBusy] = useState(false);
  const [returnAiError, setReturnAiError] = useState("");
  const [returnAiComment, setReturnAiComment] = useState("");
  const [returnAiChanges, setReturnAiChanges] = useState<Array<{
    field: "summary" | "main_cause" | "scope" | "recommendations" | "consequences" | "limitations";
    original_text: string; proposed_text: string; reason: string;
  }>>([]);
  const [returnAiClarification, setReturnAiClarification] = useState("");
  const [returnAiExplanation, setReturnAiExplanation] = useState("");
  const [returnAiAnalyzed, setReturnAiAnalyzed] = useState(false);
  const [returnAiReportId, setReturnAiReportId] = useState<number | null>(null);
  const [returnAiWorkflowState, setReturnAiWorkflowState] = useState("");

  const [previewFocused, setPreviewFocused] = useState(false);
  const [mobilePanel, setMobilePanel] = useState<"sources" | "preview">("sources");

  const [error, setError] = useState("");
  const [message, setMessage] = useState("");
  const [showOriginal, setShowOriginal] = useState(false);
  const [lightboxUrl, setLightboxUrl] = useState("");
  const [expandedItems, setExpandedItems] = useState<Record<string, boolean>>(
