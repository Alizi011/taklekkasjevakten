  const saveAiProposal = async (proposal: ReportAiDraft): Promise<void> => {
    if (!report) throw new Error("Rapporten er ikke tilgjengelig.");
    let history: unknown[] = [];
    let legacy: string | undefined;
    if (report.ai_draft) {
      try {
        const old = JSON.parse(report.ai_draft);
        if (old?.kind === "tlv_report1_ai_v1") {
          history = Array.isArray(old.history) ? old.history.slice(-4) : [];
          if (old.draft) history.push(old.draft);
          if (typeof old.legacy_ai_draft === "string") legacy = old.legacy_ai_draft;
        } else {
          legacy = report.ai_draft;
        }
      } catch { legacy = report.ai_draft; }
    }
    const stored = JSON.stringify({
      kind: "tlv_report1_ai_v1", draft: proposal,
      history: history.slice(-5), ...(legacy ? { legacy_ai_draft: legacy } : {}),
    });
    const response = await fetch(apiUrl("/reports.php"), {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ inquiry_id: inquiryId, ai_draft: stored }),
    });
    const data = await response.json();
    if (!response.ok || !data.success || !data.report ||
        data.report.ai_draft !== stored) {
      throw new Error(data.message || "Serveren bekreftet ikke lagring av AI-utkastet.");
    }
    setReport(data.report);
    setAiDraft(proposal);
