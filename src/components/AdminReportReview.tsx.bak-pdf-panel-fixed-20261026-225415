    return checklistRows.filter((row) => {
      const key = normalizeItemKey(row);
      const linkedText = photos
        .filter((photo) => photo.checklist_item_id === key)
        .map((photo) => [photo.caption_text, photo.audio_transcript].filter(Boolean).join(" "))
        .join(" ");
      return [row.item_title, row.comment, row.status, linkedText]
        .filter(Boolean)
        .join(" ")
        .toLocaleLowerCase("nb-NO")
        .includes(term);
    });
  }, [checklistRows, photos, sourceSearch]);

  const photosByItem = useMemo(() => {
    const map: Record<string, PhotoData[]> = {};
    photos.forEach((photo) => {
      const key = String(photo.checklist_item_id || "__other__");
      if (!map[key]) map[key] = [];
      map[key].push(photo);
    });
    return map;
  }, [photos]);

  // Eget Core-endepunkt: endrer aldri kildedata i TLV eller eksisterende AI-utkast.
  const documentationUrl = "https://api.taklekkasjevakten.no/api/tlv_report_documentation.php";

  const loadDocumentation = async (tlvReportId: number) => {
    setDocumentationLoading(true);
    setDocumentationError("");
    try {
      const response = await fetch(`${documentationUrl}?report_id=${tlvReportId}&inquiry_id=${inquiryId}`, {
        credentials: "include",
        cache: "no-store",
      });
      const data = await response.json();
      if (!response.ok || !data.success || !Array.isArray(data.items)) {
        throw new Error(data.message || "Kunne ikke hente dokumentasjonsvalgene.");
      }
      setDocumentation(data.items as DocumentationEntry[]);
      setDocumentationEdits(Object.fromEntries((data.items as DocumentationEntry[]).map((item) => [
        item.key,
        { suggested: item.suggested_text || "", approved: item.approved_text || item.suggested_text || item.original_text || "" }
      ])));
    } catch (err) {
      setDocumentationError(err instanceof Error ? err.message : "Kunne ikke hente dokumentasjonen.");
    } finally {
      setDocumentationLoading(false);
    }
  };

  const checkDocumentationLanguage = async () => {
    if (!report || languageBusy || documentationSaving) return;
    const rows = documentation.filter(item => item.source_type !== "photo" && item.original_text.trim() && item.review_status !== "approved" && item.review_status !== "rejected");
    if (!rows.length) return;
    setLanguageBusy(true);
    setDocumentationError("");
    try {
      const response = await fetch("https://api.taklekkasjevakten.no/api/tlv_report_language.php", {
        method: "POST", credentials: "include", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ report_id: report.id, inquiry_id: inquiryId, keys: rows.map(row => row.key) }),
      });
      const data = await response.json();
      if (!response.ok || !data.success || !Array.isArray(data.results)) throw new Error(data.message || "Språkkontrollen feilet.");
      const next: Record<string, {needs_clarification: boolean; reason: string}> = {};
      const proposals: Record<string, string> = {};
      for (const result of data.results as Array<{key: string; corrected_text: string; needs_clarification: boolean; reason: string}>) {
        const item = rows.find(row => row.key === result.key);
        if (!item || !result.corrected_text) continue;
        next[item.key] = { needs_clarification: Boolean(result.needs_clarification), reason: result.reason || "" };
        if (result.corrected_text.trim() !== item.original_text.trim()) proposals[item.key] = result.corrected_text;
      }
      setLanguageResults(old => ({ ...old, ...next }));
      setDocumentationEdits(old => {
        const updated = { ...old };
        for (const row of rows) {
          if (proposals[row.key] && (!old[row.key] || old[row.key].approved === row.original_text || old[row.key].approved === row.suggested_text)) {
            updated[row.key] = { suggested: proposals[row.key], approved: proposals[row.key] };
          }
        }
        return updated;
      });
    } catch (error) {
      setDocumentationError(error instanceof Error ? error.message : "Språkkontrollen feilet.");
    } finally {
      setLanguageBusy(false);
    }
  };

