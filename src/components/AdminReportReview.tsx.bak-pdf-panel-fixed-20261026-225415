          reportRes.json(),
          completionRes.json(),
          checklistRes.json(),
          photoRes.json(),
        ]);

      if (!reportRes.ok || !reportData.success) {
        throw new Error(reportData.message || "Kunne ikke hente rapporten.");
      }

      const nextReport: ReportData | null = reportData.report || null;
      const nextCompletionReport: CompletionReportData | null =
        completionRes.ok && completionData.success
          ? completionData.report || null
