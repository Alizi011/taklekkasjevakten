                  <div className="px-6 py-5 border-b border-slate-800 flex items-center justify-between gap-4">
                    <div>
                      <p className="text-[10px] uppercase tracking-wider font-black text-slate-500">
                        Referanse
                      </p>
                      <h3 className="text-base font-extrabold mt-1">
                        Feltteamets originalutkast
                      </h3>
                      <p className="text-[11px] text-slate-500 mt-1">
                        Skrivebeskyttet original. Punktdata, bilder og lyd ligger
                        i hovededitoren.
                      </p>
                    </div>
                    <button
                      type="button"
                      onClick={() => setShowOriginal(false)}
                      className="w-10 h-10 rounded-xl bg-slate-900 border border-slate-700 flex items-center justify-center text-slate-400 hover:text-white"
                    >
                      <X className="w-4 h-4" />
                    </button>
                  </div>
                  <div className="flex-1 overflow-y-auto whitespace-pre-wrap p-6 text-[13px] leading-7 text-slate-300">
                    {legacyReportAiText(report.ai_draft) || "Ingen rapporttekst."}
                  </div>
                </aside>
              </div>
            )}

            {lightboxUrl && (
              <div
                className="fixed inset-0 z-[90] bg-black/90 p-4 md:p-8 flex items-center justify-center"
                onClick={() => setLightboxUrl("")}
              >
                <button
                  type="button"
                  onClick={() => setLightboxUrl("")}
                  className="absolute top-5 right-5 w-11 h-11 rounded-xl bg-slate-950/80 border border-slate-700 flex items-center justify-center text-white"
                >
                  <X className="w-5 h-5" />
                </button>
                <img
                  src={lightboxUrl}
                  alt="Dokumentasjonsbilde i stor visning"
                  className="max-w-full max-h-full object-contain rounded-xl"
                  onClick={(e) => e.stopPropagation()}
                />
              </div>
            )}

            {/* Skrivebeskyttede AI-forslag fra prosjektansvarliges returkommentar. */}
            {(returnAiWorkflowState === "returned" || returnAiReportId === report.id) && (
              <section className="rounded-2xl border border-amber-500/30 bg-slate-950/80 p-4 space-y-3">
                <div className="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <h3 className="text-sm font-black text-white">AI – rettelser etter retur fra prosjektansvarlig</h3>
                    <p className="mt-1 text-xs text-slate-400">Forslagene lagres ikke automatisk. Admin kontrollerer hvert felt.</p>
                  </div>
                  <button type="button" onClick={() => void proposeReturnCorrections()}
                    disabled={returnAiBusy || !editable || hasUnsavedChanges}
                    className="rounded-lg bg-amber-500 px-4 py-2 text-xs font-bold text-slate-950 disabled:opacity-50">
                    {returnAiBusy ? "Analyserer kommentar…" : "Foreslå rettelser fra kommentar"}
                  </button>
                </div>
                {hasUnsavedChanges && <p className="text-xs text-amber-300">Lagre eksisterende endringer før ny AI-analyse.</p>}
                {returnAiError && <p role="alert" className="text-xs text-red-300">{returnAiError}</p>}
                {returnAiComment && <div className="rounded-lg border border-slate-700 p-3 text-xs text-slate-300"><b>Prosjektansvarlig:</b> {returnAiComment}</div>}
                {returnAiExplanation && <p className="text-xs text-slate-300">{returnAiExplanation}</p>}
                {returnAiAnalyzed && returnAiChanges.length === 0 && <p role="status" className="rounded-lg border border-amber-500/30 bg-amber-500/10 p-3 text-xs font-semibold text-amber-200">AI har ikke foreslått konkrete tekstendringer. Ingen rapportfelt er endret. Kontroller spesielt om «Anbefalte tiltak» og «Konsekvenser ved utsatt utbedring» er i samsvar med prosjektansvarliges kommentar.</p>}
                {returnAiClarification && <p className="text-xs text-amber-300">Avklaring: {returnAiClarification}</p>}
                {returnAiChanges.map((change, index) => (
                  <div key={`${change.field}-${index}`} className="rounded-xl border border-slate-700 p-4 space-y-2">
                    <p className="text-sm font-bold text-white">Felt: {({summary:"Sammendrag",main_cause:"Hovedårsak",scope:"Oppdrag og omfang",recommendations:"Anbefalte tiltak",consequences:"Konsekvenser",limitations:"Begrensninger"} as Record<string,string>)[change.field]}</p>
                    <p className="text-xs text-slate-400">Begrunnelse: {change.reason}</p>
                    <div className="grid gap-3 lg:grid-cols-2">
                      <div><p className="text-xs font-semibold text-slate-400 mb-1">Nåværende tekst</p><div className="whitespace-pre-wrap rounded-lg border border-slate-700 p-3 text-xs text-slate-300">{change.original_text || "(tomt)"}</div></div>
                      <div><p className="text-xs font-semibold text-amber-300 mb-1">AI-forslag (kan redigeres)</p><textarea rows={7} value={change.proposed_text}
                        onChange={(e) => setReturnAiChanges((current) => current.map((item,i) => i===index ? {...item,proposed_text:e.target.value} : item))}
                        className="w-full rounded-lg border border-amber-500/30 bg-slate-900 p-3 text-xs text-white" /></div>
                    </div>
                    <div className="flex gap-2">
                      <button type="button" disabled={!editable || hasUnsavedChanges} onClick={() => void applyReturnCorrection(index)} className="rounded-lg bg-emerald-700 px-3 py-2 text-xs font-bold text-white disabled:opacity-50">Bruk forslaget i rapporten</button>
                      <button type="button" onClick={() => setReturnAiChanges((current) => current.filter((_,i)=>i!==index))} className="rounded-lg border border-slate-600 px-3 py-2 text-xs text-white">Forkast</button>
                    </div>
                  </div>
                ))}
              </section>
            )}

            <ReportApprovalWorkflow inquiryId={inquiryId} reportId={report.id}
              dirty={hasUnsavedChanges} pdfUrl={report.pdf_url}
              onState={state => { setReturnAiWorkflowState(state); setApprovalLocked(["awaiting_pm", "awaiting_admin", "approved", "published"].includes(state)); }}
              onUpdated={() => { void loadReviewData(); onChanged?.(); }} />

            {report.status !== "publisert" ? (
              <section className="sticky bottom-3 z-30 bg-slate-950/95 backdrop-blur border border-slate-700 rounded-2xl p-4 shadow-2xl">
                <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                  <div>
                    <p className="text-xs text-slate-300 font-bold">
                      {hasUnsavedChanges
                        ? "Det finnes ulagrede endringer i punktredigeringen."
                        : "Punktredigeringen er lagret."}
                    </p>
                    <p className="text-[10px] text-slate-500 mt-1">
                      Lyd/transkripsjoner publiseres ikke. Kun valgte bilder og
                      admins slutttekst brukes i rapporten.
                    </p>
                  </div>

                  <div className="flex flex-wrap gap-2 justify-end">
                    <button
                      type="button"
                      onClick={handleSave}
                      disabled={saving || !adminText.trim()}
                      className="px-4 py-2.5 rounded-xl bg-slate-900 border border-slate-700 text-xs font-extrabold flex items-center gap-2 disabled:opacity-50"
                    >
                      {saving ? (
                        <Loader2 className="w-4 h-4 animate-spin" />
                      ) : (
                        <Save className="w-4 h-4" />
                      )}
                      Lagre
                    </button>

                    <p className="self-center text-[11px] text-slate-400">Retur, godkjenning og publisering gjøres via Perun Core-godkjenningsflyten over.</p>
                  </div>
                </div>
              </section>
            ) : (
              <div className="bg-cyan-500/10 border border-cyan-500/30 rounded-2xl p-4 flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div>
                  <p className="text-xs font-extrabold text-cyan-300">
                    Rapporten er publisert til kunden.
                  </p>
                  <p className="text-[11px] text-slate-400 mt-1">
                    Publisert versjon er låst. Admin kan åpne en intern
                    korrigering ved behov.
                  </p>
                </div>
                <button
                  type="button"
                  onClick={handleReopenPublished}
                  disabled={reopening}
                  className="px-4 py-2.5 rounded-xl bg-slate-900 border border-cyan-500/30 text-cyan-300 text-xs font-extrabold flex items-center gap-2 disabled:opacity-50"
                >
                  {reopening ? (
                    <Loader2 className="w-4 h-4 animate-spin" />
                  ) : (
                    <RefreshCw className="w-4 h-4" />
                  )}
                  Korriger publisert rapport
                </button>
              </div>
            )}
          </>
        )}
      </main>
    </div>
  );
}