  const analyzeWholeReport = async () => {
    if (!report || aiBusy || aiSaving) return;
    setAiBusy(true);
    setAiError("");
    try {
      const response = await fetch("https://api.taklekkasjevakten.no/api/tlv_report_ai.php", {
        method: "POST",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ inquiry_id: inquiryId }),
      });
      const result = await response.json();
      if (!response.ok || !result.success || !result.draft ||
          !["summary","scope","recommendations","consequences","limitations"].every(k => typeof result.draft[k] === "string")) {
        throw new Error(result.message || "AI-analysen kunne ikke fullføres.");
      }
      await saveAiProposal(result.draft as ReportAiDraft);
      setAiEvidence(Array.isArray(result.sources) ? result.sources : []);
      setAiSkippedImages(Number(result.images_not_analyzed || 0));
      setMessage("Nytt AI-utkast er lagret. Rapportkapitlene er ikke endret.");
    } catch (e) {
      setAiError(e instanceof Error ? e.message : "AI-analysen kunne ikke lagres. Forrige utkast er beholdt.");
    } finally { setAiBusy(false); }
  };

  const proposeReturnCorrections = async () => {
    if (!report || !adminSections || returnAiBusy || hasUnsavedChanges) return;
    setReturnAiBusy(true);
    setReturnAiError("");
    setReturnAiChanges([]);
    setReturnAiAnalyzed(false);
    setReturnAiReportId(null);
    try {
      const res = await fetch(apiUrl("/tlv_report_return_ai.php"), {
        method: "POST", credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ inquiry_id: inquiryId }),
      });
      const data = await res.json();
      if (!res.ok || !data.success || !Array.isArray(data.changes)) {
        throw new Error(data.message || "Kunne ikke utarbeide rettelsesforslag.");
      }
      if (Number(data.report_id) !== Number(report.id) || data.state !== "returned") {
        throw new Error("Rapporten er endret. Oppdater rapporten før du fortsetter.");
      }
      setReturnAiComment(String(data.comment || ""));
      setReturnAiChanges(data.changes);
      setReturnAiAnalyzed(true);
      setReturnAiExplanation(String(data.explanation || ""));
      setReturnAiClarification(String(data.needs_clarification || ""));
      setReturnAiReportId(Number(data.report_id));
    } catch (e) {
      setReturnAiError(e instanceof Error ? e.message : "AI-rettelsen feilet.");
    } finally { setReturnAiBusy(false); }
  };

  const applyReturnCorrection = async (index: number) => {
    const change = returnAiChanges[index];
    if (!change || !adminSections || !report || !editable ||
        returnAiReportId !== report.id || hasUnsavedChanges) return;
    setReturnAiError("");
    try {
      // Kontroller at rapporten fremdeles ligger hos admin før tekst settes inn.
      const res = await fetch(apiUrl("/tlv_report_approval_workflow.php"), {
        method: "POST", credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ inquiry_id: inquiryId, action: "status" }),
      });
      const data = await res.json();
      if (!res.ok || !data.success || data.state !== "returned" ||
          Number(data.report_id) !== report.id) {
        throw new Error("Godkjenningsstatus er endret. Last inn rapporten på nytt.");
      }
      if (adminSections[change.field] !== change.original_text) {
        throw new Error("Feltet er redigert etter AI-analysen. Lag et nytt forslag først.");
      }
      updateGlobalSection(change.field, change.proposed_text);
      setReturnAiChanges((current) => current.filter((_, i) => i !== index));
      setMessage("Rettelsen er lagt inn lokalt. Kontroller og trykk Lagre før ny PDF.");
    } catch (e) {
      setReturnAiError(e instanceof Error ? e.message : "Kunne ikke legge til rettelsen.");
    }
  };

  const insertAiSection = (field: "summary" | "scope" | "recommendations" | "consequences" | "limitations") => {
    const proposal = aiDraft?.[field]?.trim();
    if (!proposal || !adminSections || !editable) return;
    const existing = adminSections[field]?.trim() || "";
    if (existing && !window.confirm("Feltet har allerede tekst. Vil du legge AI-forslaget til etter den eksisterende teksten?")) return;
    updateGlobalSection(field, [existing, proposal].filter(Boolean).join("\n\n"));
    setMessage("AI-forslaget er satt inn som ulagret rapporttekst. Kontroller og trykk Lagre.");
  };

