        throw new Error("Serveren returnerte ugyldige rapportfelt. Teksten er beholdt lokalt.");
      }
      const expected = ["summary", "scope", "recommendations", "consequences", "limitations"] as const;
      const returned = persisted as Partial<AdminSectionsDocument> | null;
      if (!returned || expected.some((field) => returned[field] !== submitted[field]) ||
