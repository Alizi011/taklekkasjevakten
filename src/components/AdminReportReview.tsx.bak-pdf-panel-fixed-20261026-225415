    setSavingPhotoId(photo.id);
    setError("");
    setMessage("");

    try {
      const formData = new FormData();
      formData.append("photo_id", String(photo.id));
      formData.append("inquiry_id", String(inquiryId));
      formData.append("include_in_report", include ? "1" : "0");
      if (
        photo.report_sort_order !== null &&
        photo.report_sort_order !== undefined
      ) {
        formData.append(
          "report_sort_order",
          String(photo.report_sort_order)
        );
      } else {
        formData.append("report_sort_order", "");
      }

      const res = await fetch(apiUrl("/photos.php"), {
        method: "POST",
        body: formData,
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        throw new Error(
          data.message || "Kunne ikke oppdatere bildevalget."
        );
      }

      const updated: PhotoData = data.photo || {
        ...photo,
        include_in_report: include ? 1 : 0,
      };

      setPhotos((current) =>
        current.map((item) => (item.id === photo.id ? updated : item))
      );

      await invalidatePdfAfterDocumentationChange();
      setMessage(
        include
          ? "Bildet er valgt inn i rapporten. Oppdater PDF når du er klar."
          : "Bildet er tatt ut av rapporten. Oppdater PDF når du er klar."
      );
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Kunne ikke oppdatere bildevalget."
      );
    } finally {
      setSavingPhotoId(null);
    }
  };

