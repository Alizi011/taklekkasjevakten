    }

    const nextReport: ReportData = data.report;
    if (!nextReport || typeof nextReport !== "object") {
      throw new Error("Serveren bekreftet ikke hvilken rapport som ble lagret.");
    }

    // Ikke overskriv redaktørens tekst med en gammel eller ufullstendig serverrespons.
    // Kontroller at alle rapportfeltene faktisk er lagret før «Lagret» vises.
    if ("admin_sections_json" in payload) {
      const submitted = payload.admin_sections_json as AdminSectionsDocument;
      let persisted: unknown;
      try {
        persisted = typeof nextReport.admin_sections_json === "string"
          ? JSON.parse(nextReport.admin_sections_json)
          : nextReport.admin_sections_json;
