import { useEffect, useState } from "react";
import { apiUrl } from "../lib/api";
import { AlertTriangle, ExternalLink, Loader2, RefreshCw, ShieldCheck } from "lucide-react";

const LOOKUP_URL = apiUrl("/tlv_heritage_lookup_bridge.php");
type Candidate = { layer: string; feature_id: string; attributes: Record<string, unknown>; address_match?: boolean; geometry_contains_point?: boolean; match_reason?: string };
type LookupResult = {
  success?: boolean;
  message?: string;
  candidates?: Candidate[];
  direct_matches?: Candidate[];
  parent_matches?: Candidate[];
  nearby_matches?: Candidate[];
  property_address?: string;
  warnings?: string[];
  checked_at?: string;
  disclaimer?: string;
  coordinates?: { lat?: number; lon?: number; source?: string };
};
function readable(value: unknown): string {
  if (value === null || value === undefined) return "";
  if (typeof value === "string" || typeof value === "number" || typeof value === "boolean") return String(value);
  return JSON.stringify(value);
}
function describeError(error: unknown): string {
  const value = error instanceof Error ? error.message : "Ukjent feil";
  if (value === "Failed to fetch" || value === "NetworkError when attempting to fetch resource.") {
    return "Kunne ikke kontakte Perun Core. Kontroller nettverk, API-tilgang og innlogging. Ingen vernestatus er fastslått.";
  }
  if (/HTTP 401|Innlogging kreves|Unauthorized/i.test(value)) return "Perun Core krever innlogging. Kontroll ikke gjennomført.";
  if (/HTTP 403|Forbidden/i.test(value)) return "Du mangler tilgang til denne kontrollen i Perun Core.";
  return `Kontroll ikke gjennomført: ${value}`;
}
function materialAdvice(count: number | null, warnings: string[]): string {
  if (count === null) return "Ingen materialvurdering kan gjøres før registerkontrollen er gjennomført. Bevar eksisterende materialer og dokumenter utførelsen inntil kravene er klarlagt.";
  if (warnings.length) return "Registerkontrollen er ufullstendig. Undersøk fredningsvedtak og reguleringsbestemmelser før materialvalg. Tradisjonelle materialer og reparasjonsmetoder bør vurderes først ved eldre bygningsdeler.";
  if (count > 0) return "Mulige kulturminnetreff krever kontroll mot korrekt bygning og gjeldende bestemmelser. Moderne materialer er ikke automatisk tillatt eller forbudt; vurder kompatibilitet med eksisterende konstruksjon og eventuelle krav fra vernemyndigheten.";
  return "Ingen treff i det undersøkte registeroppslaget. Dette utelukker ikke kommunal listeføring, regulering eller andre vernekrav. Undersøk lokale planer før historiske materialer erstattes med moderne produkter.";
}
export default function HeritageMaterialReview({ inquiryId, address }: { inquiryId: number; address: string }) {
  const [result, setResult] = useState<LookupResult | null>(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState("");
  const [attempted, setAttempted] = useState(false);
  useEffect(() => {
    setResult(null);
    setError("");
    setAttempted(false);
  }, [inquiryId]);
  const run = async () => {
    if (busy) return;
    setBusy(true);
    setAttempted(true);
    setError("");
    setResult(null);
    try {
      // Backend resolves coordinates from the verified Core project. No manual coordinates are accepted here.
      const url = new URL(LOOKUP_URL);
      url.searchParams.set("inquiry_id", String(inquiryId));
      const response = await fetch(url.toString(), { credentials: "include", cache: "no-store" });
      const data: LookupResult = await response.json();
      if (!response.ok || !data.success) throw new Error(data.message || `HTTP ${response.status}`);
      setResult(data);
    } catch (e) {
      setError(describeError(e));
    } finally {
      setBusy(false);
    }
  };
  const candidates = Array.isArray(result?.candidates) ? result.candidates : [];
  const warnings = Array.isArray(result?.warnings) ? result.warnings : [];
  const direct = Array.isArray(result?.direct_matches) ? result.direct_matches : [];
  const parent = Array.isArray(result?.parent_matches) ? result.parent_matches : [];
  const nearby = Array.isArray(result?.nearby_matches) ? result.nearby_matches : [];
  const main = direct.find(x => x.layer === "app:Enkeltminne") || direct[0];
  const registeredType = readable(main?.attributes?.vernetype);
  const statusName = registeredType === "KOM" ? "Kommunalt listeført (KOM)" : registeredType ? `Registrert vernetype ${registeredType}` : "Direkte adressetreff i registeret";
  const finished = result !== null;
  const status = !finished ? "Ikke kontrollert" : direct.length ? statusName : warnings.length ? "Delvis kontroll – må undersøkes" : candidates.length ? "Kun nærliggende registertreff" : "Ingen treff i undersøkt register";
  return (
    <section className="mt-5 rounded-2xl border border-amber-500/30 bg-[#1b101d] p-5 space-y-5">
      <div className="flex items-start gap-3">
        <ShieldCheck className="h-6 w-6 shrink-0 text-amber-300" />
        <div>
          <h3 className="font-bold text-white">Vernestatus og materialkrav</h3>
          <p className="text-xs text-slate-300">{address} · Automatisk registerkontroll og faglig oppsummering</p>
        </div>
      </div>
      <div className="flex flex-wrap items-center gap-3">
        <button type="button" onClick={() => void run()} disabled={busy}
          className="inline-flex items-center gap-2 rounded-lg bg-cyan-500 px-4 py-2.5 text-sm font-bold text-slate-950 disabled:opacity-50">
          {busy ? <Loader2 className="h-4 w-4 animate-spin" /> : <RefreshCw className="h-4 w-4" />}
          {busy ? "Kontrollerer registre…" : attempted ? "Kjør kontroll på nytt" : "Kjør automatisk vernekontroll"}
        </button>
        {finished && result?.checked_at && <span className="text-xs text-slate-400">Oppslag utført: {result.checked_at}</span>}
      </div>
      {error && <div role="alert" className="flex items-start gap-2 rounded-xl border border-rose-500/40 bg-rose-950/20 p-3 text-sm text-rose-200"><AlertTriangle className="h-4 w-4 shrink-0 mt-0.5" />{error}</div>}
      <div className="grid gap-3 md:grid-cols-2">
        <div className="rounded-xl border border-slate-700 bg-slate-950/30 p-4 space-y-2">
          <h4 className="text-xs font-bold uppercase tracking-wide text-slate-400">Registerstatus</h4>
          <p className="text-sm font-bold text-white">{status}</p>
          <p className="text-xs text-slate-300">{!finished ? "Ingen registerkontroll er gjennomført." : direct.length ? `${direct.length} registerobjekt(er) med eksakt adressenavn og kommunenummer. Dette er et adressetreff, ikke kontroll av alle juridiske bestemmelser.` : candidates.length ? `${candidates.length} registreringer i nærheten, men ingen bekreftet treff på den oppgitte adressen.` : "Ingen registreringer i dette oppslaget. Det utelukker ikke andre former for vern."}</p>
        </div>
        <div className="rounded-xl border border-slate-700 bg-slate-950/30 p-4 space-y-2">
          <h4 className="text-xs font-bold uppercase tracking-wide text-slate-400">Materialhensyn</h4>
          <p className="text-sm text-slate-200">{direct.length ? "Bygningen har et direkte kulturminneregistertreff. Kartlegg eksisterende materialer og utførelse før utskifting. Tradisjonelle materialer bør vurderes først; moderne løsninger krever konkret vurdering av vern, planbestemmelser og teknisk kompatibilitet." : materialAdvice(finished ? candidates.length : null, warnings)}</p>
        </div>
      </div>
      {finished && direct.length > 0 && <div className="space-y-3 rounded-xl border border-amber-500/50 bg-amber-950/10 p-4">
        <h4 className="text-sm font-bold text-amber-200">Direkte adressetreff – {result?.property_address || address}</h4>
        {direct.map((candidate, i) => <div key={`${candidate.layer}-${candidate.feature_id}-${i}`} className="rounded-lg border border-slate-700 p-3 space-y-1">
          <p className="text-sm font-semibold text-white">{readable(candidate.attributes?.navn) || address} · {readable(candidate.attributes?.vernetype) || "Vernetype ikke oppgitt"}</p>
          <p className="text-xs text-slate-300">Kulturminne-ID: {readable(candidate.attributes?.kulturminneId || candidate.feature_id)} · {candidate.geometry_contains_point ? "Eiendomspunktet ligger i registrert geometri" : "Eksakt adressenavn og kommune – geometrisk tilknytning ikke bekreftet"}</p>
          {typeof candidate.attributes?.linkKulturminnesøk === "string" && /^https:\/\//.test(candidate.attributes.linkKulturminnesøk) && <a className="text-xs text-cyan-300 underline" href={candidate.attributes.linkKulturminnesøk} target="_blank" rel="noopener noreferrer">Åpne Kulturminnesøk <ExternalLink size={12} className="inline" /></a>}
        </div>)}
        <p className="text-xs text-amber-100">Vernetype i registeret er ikke en automatisk godkjenning eller full juridisk avklaring. Reguleringsplan og eventuelt fredningsvedtak må undersøkes.</p>
      </div>}
      {finished && parent.length > 0 && <div className="text-sm text-slate-300">Overordnet adresse/lokalitet: {parent.map(c => `${readable(c.attributes?.navn)} (${readable(c.attributes?.kulturminneId || c.feature_id)})`).join(", ")}</div>}
      {finished && nearby.length > 0 && <details className="rounded-lg border border-slate-700 p-3"><summary className="cursor-pointer text-sm text-slate-200">Andre registreringer i nærheten ({nearby.length})</summary><div className="mt-2 space-y-1">{nearby.slice(0,30).map((c,i)=><p key={`${c.layer}-${c.feature_id}-${i}`} className="text-xs text-slate-400">{readable(c.attributes?.navn)} · {readable(c.attributes?.vernetype)} · {readable(c.attributes?.kulturminneId || c.feature_id)}</p>)}</div></details>}
      {finished && candidates.length > 0 && direct.length === 0 && <div className="space-y-2">
        <h4 className="text-sm font-bold text-white">Mulige registertreff – kontroller bygningstilknytning</h4>
        {candidates.slice(0, 20).map((candidate, i) => <details key={`${candidate.layer}-${candidate.feature_id}-${i}`} className="rounded-lg border border-slate-700 bg-slate-950/30 px-4 py-3">
          <summary className="cursor-pointer text-sm font-medium text-cyan-200">{candidate.layer || "Kulturminneregister"} · {candidate.feature_id || `Treff ${i + 1}`}</summary>
          <dl className="mt-3 grid gap-2 text-xs text-slate-300">{Object.entries(candidate.attributes || {}).map(([key, value]) => <div key={key}><dt className="font-semibold text-slate-200">{key}</dt><dd className="break-words">{readable(value)}</dd></div>)}</dl>
        </details>)}
        {candidates.length > 20 && <p className="text-xs text-slate-400">Viser de første 20 av {candidates.length} treff.</p>}
      </div>}
      {warnings.length > 0 && <div className="rounded-lg border border-amber-500/30 p-3 text-xs text-amber-200"><p className="font-bold">Kontrollen har forbehold</p>{warnings.map((warning, i) => <p key={i} className="mt-1">{warning}</p>)}</div>}
      <div className="space-y-2 border-t border-slate-700/70 pt-4">
        <h4 className="text-sm font-bold text-white">Hva må avklares før materialvalg?</h4>
        <p className="text-sm text-slate-300">Kontroller eventuell fredning, Gul liste og planbestemmelser for akkurat dette bygget. Ved tak-, pipe-, beslag- og fasadearbeid må eksisterende materialer, konstruksjonsoppbygging og reparasjonsmetoder vurderes opp mot gjeldende krav. Automatisk oppslag er ikke en tillatelse eller en fullstendig juridisk vernevurdering.</p>
        <div className="flex flex-wrap gap-x-5 gap-y-2 text-xs">
          <a className="inline-flex items-center gap-1 text-cyan-300 underline" href="https://www.kulturminnesok.no/" target="_blank" rel="noopener noreferrer">Riksantikvaren – Kulturminnesøk <ExternalLink size={13}/></a>
          <a className="inline-flex items-center gap-1 text-cyan-300 underline" href="https://www.oslo.kommune.no/plan-bygg-og-eiendom/kulturminner-og-kulturmiljo/gul-liste/" target="_blank" rel="noopener noreferrer">Oslo – Gul liste <ExternalLink size={13}/></a>
          <a className="inline-flex items-center gap-1 text-cyan-300 underline" href="https://od2.pbe.oslo.kommune.no/kart/?mode=kommuneplan" target="_blank" rel="noopener noreferrer">Oslo – planinnsyn <ExternalLink size={13}/></a>
        </div>
      </div>
      <p className="text-xs text-slate-400">Denne visningen gjør kun et oppslag; den lagrer ikke en faglig godkjenning i Perun Core. Vernekrav og materialbruk må bekreftes i primærkildene før arbeidet prosjekteres.</p>
    </section>
  );
}
