import { apiUrl } from "../lib/api";
import { useEffect, useState } from "react";
import { Check, Loader2 } from "lucide-react";

type Contact = {
  id: number;
  name: string;
  phone: string | null;
  email: string | null;
  role: string | null;
};

type Props = {
  inquiryId: number;
  onSaved?: (contact: Contact) => void;
};

const API = apiUrl("/admin_case_contact.php");

export default function AdminCaseContactEditor({
  inquiryId,
  onSaved,
}: Props) {
  const [contact, setContact] = useState<Contact | null>(null);
  const [form, setForm] = useState({
    name: "",
    phone: "",
    email: "",
    role: "Hovedkontakt",
  });
  const [loading, setLoading] = useState(true);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");
  const [message, setMessage] = useState("");

  useEffect(() => {
    let cancelled = false;

    const load = async () => {
      setLoading(true);
      setError("");

      try {
        const res = await fetch(
          `${API}?inquiry_id=${encodeURIComponent(inquiryId)}`,
          { credentials: "include", cache: "no-store" }
        );
        const data = await res.json();

        if (!res.ok || !data.success) {
          throw new Error(data.message || "Kunne ikke hente kontaktperson.");
        }

        if (cancelled) return;

        const next: Contact | null = data.contact || null;
        setContact(next);
        setForm({
          name: next?.name || "",
          phone: next?.phone || "",
          email: next?.email || "",
          role: next?.role || "Hovedkontakt",
        });
      } catch (err) {
        if (!cancelled) {
          setError(
            err instanceof Error ? err.message : "Kunne ikke hente kontaktperson."
          );
        }
      } finally {
        if (!cancelled) setLoading(false);
      }
    };

    void load();
    return () => { cancelled = true; };
  }, [inquiryId]);

  const save = async () => {
    setSaving(true);
    setError("");
    setMessage("");

    try {
      if (!form.name.trim()) {
        throw new Error("Kontaktpersonens navn må fylles ut.");
      }

      const res = await fetch(API, {
        method: "PUT",
        credentials: "include",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          inquiry_id: inquiryId,
          name: form.name.trim(),
          phone: form.phone.trim(),
          email: form.email.trim(),
          role: form.role.trim(),
        }),
      });
      const data = await res.json();

      if (!res.ok || !data.success || !data.contact) {
        throw new Error(data.message || "Kunne ikke lagre kontaktpersonen.");
      }

      const saved = data.contact as Contact;
      setContact(saved);
      setMessage("Kontaktpersonen er lagret.");
      onSaved?.(saved);
    } catch (err) {
      setError(
        err instanceof Error ? err.message : "Kunne ikke lagre kontaktpersonen."
      );
    } finally {
      setSaving(false);
    }
  };

  const inputStyle =
    "w-full rounded-xl border border-slate-700 bg-slate-950 px-3 py-3 text-sm text-white outline-none focus:border-cyan-400";

  return (
    <section className="space-y-5 rounded-2xl border border-slate-800 bg-slate-950/40 p-5">
      <div>
        <h3 className="text-base font-extrabold text-white">
          Kontaktperson
        </h3>
        <p className="mt-1 text-xs text-slate-400">
          Kontaktpersonen er knyttet til denne saken og lagres separat
          fra sameiets hovedopplysninger.
        </p>
      </div>

      {loading ? (
        <p className="text-sm text-slate-400">Henter kontaktperson …</p>
      ) : (
        <>
          <div className="grid gap-4 sm:grid-cols-2">
            {([
              ["name", "Navn"],
              ["phone", "Telefon"],
              ["email", "E-post"],
              ["role", "Rolle"],
            ] as const).map(([key, label]) => (
              <label key={key} className="space-y-2">
                <span className="text-xs font-bold text-slate-300">{label}</span>
                <input
                  className={inputStyle}
                  type={key === "email" ? "email" : key === "phone" ? "tel" : "text"}
                  maxLength={key === "name" ? 255 : key === "role" ? 100 : key === "phone" ? 50 : 255}
                  value={form[key]}
                  onChange={(e) =>
                    setForm((current) => ({
                      ...current,
                      [key]: e.target.value,
                    }))
                  }
                />
              </label>
            ))}
          </div>

          {error && <p role="alert" className="text-sm text-rose-300">{error}</p>}
          {message && <p role="status" className="text-sm text-emerald-300">{message}</p>}

          <div className="flex flex-wrap items-center justify-end gap-3">
            <button
              type="button"
              disabled={saving}
              onClick={() => {
                setForm({
                  name: contact?.name || "",
                  phone: contact?.phone || "",
                  email: contact?.email || "",
                  role: contact?.role || "Hovedkontakt",
                });
                setError("");
                setMessage("");
              }}
              className="rounded-xl border border-slate-700 px-4 py-2.5 text-sm font-semibold text-slate-300"
            >
              Avbryt endringer
            </button>
            <button
              type="button"
              disabled={saving || !form.name.trim()}
              onClick={() => void save()}
              className="inline-flex items-center gap-2 rounded-xl bg-cyan-500 px-5 py-2.5 text-sm font-bold text-slate-950 disabled:opacity-50"
            >
              {saving ? <Loader2 className="h-4 w-4 animate-spin" /> : <Check className="h-4 w-4" />}
              Lagre kontaktperson
            </button>
          </div>
        </>
      )}
    </section>
  );
}