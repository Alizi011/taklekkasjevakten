import { useState, type FormEvent } from "react";

export type AgreementPlanningData = {
  start_date: string;
  estimated_duration: string;
};

type Props = {
  onSubmit: (data: AgreementPlanningData) => void | Promise<void>;
  saving?: boolean;
};

const durationOptions = [
  "1 dag", "2 dager", "3 dager", "4 dager", "5 dager",
  "1 uke", "2 uker", "3 uker", "4 uker",
  "1 måned", "2 måneder", "3 måneder",
  "4 måneder", "5 måneder", "6 måneder",
];

export default function AgreementPlanning({
  onSubmit,
  saving = false,
}: Props) {
  const [startDate, setStartDate] = useState("");
  const [duration, setDuration] = useState("");

  function submit(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    if (!startDate || !duration || saving) return;

    void onSubmit({
      start_date: startDate,
      estimated_duration: duration,
    });
  }

  return (
    <form
      onSubmit={submit}
      className="space-y-5 rounded-2xl border border-slate-700 bg-slate-900 p-5"
    >
      <div>
        <h3 className="text-lg font-bold text-white">
          Planlegging av avtalt arbeid
        </h3>
        <p className="mt-1 text-sm text-slate-400">
          Fyll ut to opplysninger for avtaleutkastet.
        </p>
      </div>

      <label className="block space-y-2">
        <span className="text-sm font-medium text-white">
          Når foreslår du at arbeidet skal starte?
        </span>
        <input
          type="date"
          required
          value={startDate}
          onChange={(e) => setStartDate(e.target.value)}
          className="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-3 text-white"
        />
      </label>

      <label className="block space-y-2">
        <span className="text-sm font-medium text-white">
          Hvor lang tid estimerer du at arbeidet krever?
        </span>
        <select
          required
          value={duration}
          onChange={(e) => setDuration(e.target.value)}
          className="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-3 text-white"
        >
          <option value="">Velg estimert varighet</option>
          {durationOptions.map((option) => (
            <option key={option} value={option}>
              {option}
            </option>
          ))}
        </select>
      </label>

      <p className="text-xs text-slate-400">
        Varigheten er et estimat, ikke en avtalt sluttdato.
      </p>

      <button
        type="submit"
        disabled={saving || !startDate || !duration}
        className="w-full rounded-lg bg-amber-500 px-4 py-3 font-bold text-slate-950 disabled:opacity-50"
      >
        {saving ? "Lagrer..." : "Fortsett til avtaleutkast"}
      </button>
    </form>
  );
}
