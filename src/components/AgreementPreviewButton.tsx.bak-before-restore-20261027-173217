import { useState } from "react";
import { FileCheck2, X } from "lucide-react";

type Offer = {
  id: number;
  offer_number?: string | null;
  title?: string | null;
  status?: string | null;
  calculated_inc_vat?: number | string | null;
  fixed_price?: number | string | null;
  pricing_mode?: string | null;
};

type Props = {
  offer: Offer;
  customerName?: string;
  address?: string;
};

const money = (ore: number) =>
  (ore / 100).toLocaleString("nb-NO", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }) + " kr";

export default function AgreementPreviewButton({
  offer,
  customerName,
  address,
}: Props) {
  const [open, setOpen] = useState(false);

  if (offer.pricing_mode !== "fixed") return null;

  // Bruk bare faktisk lagret total inkludert mva.
  // Ikke anta en mva-sats når totalen mangler.
  const total = Number(offer.calculated_inc_vat ?? NaN);
  const validTotal = Number.isFinite(total) && total > 0;
  const totalOre = validTotal ? Math.round(total * 100) : 0;

  const percentages =
    totalOre < 1000000 ? [100] :
    totalOre < 5000000 ? [50, 50] :
    [30, 30, 30, 10];

  const descriptions =
    percentages.length === 1
      ? ["Etter ferdigstilt arbeid"]
      : percentages.length === 2
        ? ["Ved oppstart", "Etter ferdigstilt arbeid"]
        : [
            "Prosjektering og etablering",
            "Igangsetting av arbeidet",
            "Fullførelse av arbeidet",
            "Avsluttende gjennomgang og godkjenning",
          ];

  let remaining = totalOre;

  const payments = percentages.map((percentage, index) => {
    const amount =
      index === percentages.length - 1
        ? remaining
        : Math.floor((totalOre * percentage + 50) / 100);

    remaining -= amount;

    return { percentage, amount, title: descriptions[index] };
  });

  return (
    <>
      <button
        type="button"
        onClick={() => setOpen(true)}
        className="inline-flex h-10 items-center justify-center gap-2 rounded-xl border border-amber-500/50 bg-amber-500/10 px-4 text-xs font-bold text-amber-200 hover:bg-amber-500/20"
      >
        <FileCheck2 className="h-4 w-4" />
        Forhåndsvis avtale
      </button>

      {open && (
        <div
          className="fixed inset-0 z-[200] flex items-center justify-center bg-slate-950/90 p-3 sm:p-6"
          role="presentation"
          onMouseDown={(event) => {
            if (event.target === event.currentTarget) setOpen(false);
          }}
        >
          <div
            role="dialog"
            aria-modal="true"
            aria-label="Forhåndsvisning av avtale"
            className="flex max-h-[94vh] w-full max-w-4xl flex-col overflow-hidden rounded-2xl border border-slate-600 bg-white text-slate-900 shadow-2xl"
          >
            <div className="flex items-center justify-between gap-3 border-b border-slate-200 px-5 py-4">
              <div>
                <p className="text-xs font-bold uppercase text-amber-700">
                  Kun forhåndsvisning
                </p>
                <div className="mb-3 flex items-center gap-3">
  <div className="grid h-11 w-11 place-items-center rounded-xl bg-slate-950 text-xl font-black text-white">P</div>
  <div>
    <p className="text-sm font-black">PERUN AS</p>
    <p className="text-xs text-slate-500">Org.nr. 917 779 236</p>
  </div>
</div>
<h2 className="text-xl font-black">
                  Avtale om arbeider
                </h2>
              </div>
              <button
                type="button"
                aria-label="Lukk forhåndsvisning"
                onClick={() => setOpen(false)}
                className="rounded-lg p-2 hover:bg-slate-100"
              >
                <X className="h-5 w-5" />
              </button>
            </div>

            <div className="overflow-y-auto p-5 sm:p-8">
              <div className="mb-6 rounded-lg border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
                Dette er et eksempel på avtaledokumentet.
                Det er ikke opprettet, godkjent eller sendt til signering.
              </div>

              <div className="space-y-7 text-sm leading-7">
                <section>
                  <h3 className="font-black">1. Partene</h3>
                  <p>Oppdragstaker: Perun AS</p>
                  <p>Org.nr.: 917 779 236</p>
                  <p>Oppdragsgiver: {customerName || "Kontrolleres før avtaleopprettelse"}</p>
                  <p>Arbeidsadresse: {address || "Kontrolleres før avtaleopprettelse"}</p>
                </section>

                <section>
                  <h3 className="font-black">2. Bakgrunn for avtalen</h3>
                  <p>Pristilbud: {offer.offer_number || `#${offer.id}`}</p>
                  <p>Arbeid: {offer.title || "Arbeidsbeskrivelse fra tilbudet"}</p>
                  <p>Tilbudsstatus: {offer.status || "Ukjent"}</p>
                  <p>Det gjeldende aksepterte tilbudet skal følge som vedlegg 1.</p>
                  <p className="mt-2 font-bold">
                    Avtalesum inkl. mva.: {validTotal ? money(totalOre) : "Ikke verifisert"}
                  </p>
                </section>

                <section>
                  <h3 className="font-black">Forutsetninger for arbeidet</h3>
                  <p>Foreslått oppstart: Ikke fastsatt</p>
                  <p>Estimert varighet: Ikke fastsatt</p>
                  <p>Arbeidet utføres i henhold til god håndverkstradisjon og tekniske standarder.</p>
<p>Estimert arbeidsvarighet er ikke i seg selv en bindende ferdigstillelsesdato. Værforhold, skjulte skader, materialleveranser og nødvendig adgang kan påvirke fremdriften.</p>
                </section>

                <section>
                  <h3 className="font-black">Betalingsplan</h3>
                  {validTotal ? (
                    <div className="mt-3 overflow-x-auto">
                      <table className="w-full text-left text-sm">
                        <thead>
                          <tr className="border-b border-slate-300">
                            <th className="py-2">Milepæl</th>
                            <th className="py-2">Andel</th>
                            <th className="py-2 text-right">Beløp inkl. mva.</th>
                          </tr>
                        </thead>
                        <tbody>
                          {payments.map((payment, index) => (
                            <tr key={index} className="border-b border-slate-200">
                              <td className="py-2">{payment.title}</td>
                              <td className="py-2">{payment.percentage} %</td>
                              <td className="py-2 text-right font-semibold">
                                {money(payment.amount)}
                              </td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  ) : (
                    <p className="mt-2 text-amber-700">
                      Betalingsplan kan ikke beregnes før totalprisen er verifisert.
                    </p>
                  )}
                </section>

                <section>
                  <h3 className="font-black">3. Utførelse og framdrift</h3>
                  <p>Arbeidet gjennomføres i henhold til tilbudets arbeidsbeskrivelse.</p>
                  <p>Eventuelle tilleggsarbeider avtales skriftlig.</p>
                  <p>Etter ferdigstillelse gjennomgår partene arbeidet.</p>
<p>Arbeid utenfor det aksepterte tilbudet inngår ikke i kontraktssummen. Endringer og tilleggsarbeider skal avtales skriftlig.</p>
<p>Oppdragsgiver sørger for nødvendig tilgang til arbeidsområdet, og tilgang til vann og strøm der dette er avtalt og nødvendig.</p>
                </section>

                <section>
                  <section>
  <h3 className="font-black">Garanti og reklamasjon</h3>
  <p>Eventuell særskilt garanti fremgår av akseptert tilbud. Garantiperioden regnes normalt fra dokumentert ferdigstillelse, med mindre andre gyldige vilkår er avtalt.</p>
  <p>Lovbestemte reklamasjonsrettigheter gjelder uavhengig av særskilt garanti.</p>
  <label className="mt-3 flex items-center gap-2 rounded-lg border border-slate-200 bg-slate-50 p-3 text-xs">
    <input type="checkbox" disabled />
    <span>5 års garanti på utført arbeid – demonstrasjon, ikke aktivert</span>
  </label>
</section>
<section>
  <h3 className="font-black">Ferdigstillelse og sluttkontroll</h3>
  <p>Prosjektleder registrerer oppstart, påbegynt arbeid, faktisk ferdigstillelse og sluttkontroll. Eventuelle mangler dokumenteres og behandles etter avtalen og gjeldende regler.</p>
</section>
<section>
  <h3 className="font-black">Vedlegg</h3>
  <p>Vedlegg 1: Den faktisk aksepterte tilbudsrevisjonen med arbeidsbeskrivelse og prisoppstilling.</p>
  <p>Andre dokumenter er kun avtalevedlegg når de uttrykkelig er inkludert.</p>
</section>
<h3 className="font-black">4. Tvister</h3>
                  <p>Partene søker å løse eventuelle uenigheter i minnelighet.</p>
                </section>

                <section>
                  <h3 className="font-black">5. Signatur</h3>
                  <p>Avtalen signeres elektronisk gjennom Visma Sign av representanter med nødvendig signaturrett eller fullmakt.</p>
<p>Signert avtale og signeringsbevis skal arkiveres i prosjektet.</p>
                  <p className="text-slate-500">Ingen signaturer er innhentet.</p>
                </section>
              </div>
            </div>

            <div className="flex justify-end border-t border-slate-200 p-4">
              <button
                type="button"
                onClick={() => setOpen(false)}
                className="rounded-lg bg-slate-900 px-5 py-2.5 text-sm font-bold text-white"
              >
                Lukk forhåndsvisning
              </button>
            </div>
          </div>
        </div>
      )}
    </>
  );
}